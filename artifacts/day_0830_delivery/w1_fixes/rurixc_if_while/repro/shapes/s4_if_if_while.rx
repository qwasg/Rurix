// 形态4:嵌套两层 if 包 while。
kernel fn s4(out: ViewMut<global, f32>, n: usize, t: ThreadCtx<1>) {
    let i = t.global_id();
    let mut acc = 0.0;
    if i < n {
        if i < 128usize {
            let mut j = 0usize;
            while j < 4usize {
                acc = acc + 1.0;
                j = j + 1;
            }
        }
    }
    out[i] = acc;
}
