// 形态3:if-else 双臂各含 while。
kernel fn s3(out: ViewMut<global, f32>, n: usize, t: ThreadCtx<1>) {
    let i = t.global_id();
    let mut acc = 0.0;
    if i < n {
        let mut j = 0usize;
        while j < 4usize {
            acc = acc + 1.0;
            j = j + 1;
        }
    } else {
        let mut k = 0usize;
        while k < 8usize {
            acc = acc + 2.0;
            k = k + 1;
        }
    }
    out[i] = acc;
}
