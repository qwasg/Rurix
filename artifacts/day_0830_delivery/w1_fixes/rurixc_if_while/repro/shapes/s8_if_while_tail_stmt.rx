// 形态8:if 包 while,while 后仍有直线语句(then 臂尾巴非空)。
kernel fn s8(out: ViewMut<global, f32>, n: usize, t: ThreadCtx<1>) {
    let i = t.global_id();
    let mut acc = 0.0;
    if i < n {
        let mut j = 0usize;
        while j < 4usize {
            acc = acc + 1.0;
            j = j + 1;
        }
        acc = acc * 2.0;
    }
    out[i] = acc;
}
