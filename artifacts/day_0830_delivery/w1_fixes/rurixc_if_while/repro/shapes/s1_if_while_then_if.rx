// 形态1:if 包 (while + 后随 if)——A1 登记「if 包 while+if」字面形态。
kernel fn s1(out: ViewMut<global, f32>, n: usize, t: ThreadCtx<1>) {
    let i = t.global_id();
    if i < n {
        let mut acc = 0.0;
        let mut j = 0usize;
        while j < n {
            acc = acc + 1.0;
            j = j + 1;
        }
        if acc > 4.0 {
            acc = acc * 0.5;
        }
        out[i] = acc;
    }
}
