// 形态2:while 包 if 包 while——A1 kernel 真实形态(灯循环内 gate,gate 内阴影射线循环)。
kernel fn s2(out: ViewMut<global, f32>, n: usize, t: ThreadCtx<1>) {
    let i = t.global_id();
    let mut acc = 0.0;
    let mut li = 0usize;
    while li < n {
        if acc < 100.0 {
            let mut j = 0usize;
            while j < 4usize {
                acc = acc + 1.0;
                j = j + 1;
            }
        }
        li = li + 1;
    }
    out[i] = acc;
}
