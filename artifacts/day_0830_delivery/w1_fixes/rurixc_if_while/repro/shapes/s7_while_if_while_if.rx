// 形态7:while 包 (if 包 (while + 后随 if))——A1 真实 kernel 的完整嵌套谱
// (灯循环 → gate if → 阴影射线 while + 命中判定 if)。
kernel fn s7(out: ViewMut<global, f32>, n: usize, t: ThreadCtx<1>) {
    let i = t.global_id();
    let mut acc = 0.0;
    let mut li = 0usize;
    while li < n {
        if acc < 100.0 {
            let mut j = 0usize;
            while j < 4usize {
                acc = acc + 1.0;
                j = j + 1;
            }
            if acc > 2.0 {
                acc = acc * 0.5;
            }
        }
        li = li + 1;
    }
    out[i] = acc;
}
