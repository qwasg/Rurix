// 最小复现:if 块内包含 while 循环(day_0828 A1 相登记的 rurixc「if 包 while」
// codegen 缺陷;HANDOVER.md §A.3)。期望:编译产 SPIR-V 且 spirv-val 干净。
kernel fn if_while_min(out: ViewMut<global, f32>, n: usize, t: ThreadCtx<1>) {
    let i = t.global_id();
    if i < n {
        let mut acc = 0.0;
        let mut j = 0usize;
        while j < n {
            acc = acc + 1.0;
            j = j + 1;
        }
        out[i] = acc;
    }
}
