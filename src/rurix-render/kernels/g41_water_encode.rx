// G41 水面展示链显示编码 kernel(曝光 → ACES filmic → sRGB → BGRA8 打包)。
//
// 与生产显示链 `g31_display_encode.rx`(ACES 1.3 RRT+ODT 全实现 + BT.1886)**不是
// 同一件**:本 kernel 是 G41 展示车道自带的轻量编码腿,只服务
// `g41_water_present` 的窗口呈现,不进生产管线、不参与任何冻结 digest 锚。
// 不复用生产件是为了让 G41 车道对 `display/` 与 g31/g14 车道零触碰(0-byte)。
// 与 `g40_cloud_encode.rx` 曲线同式但独立成件,两展示车道互不耦合。
//
// device 侧编码的收益:回读量从 w×h×12B(f32 RGB)降到 w×h×4B(BGRA8),
// 1920×1080 下 24.9MB → 8.3MB,present 腿不再是带宽瓶颈。
//
// ## 确定性协议
//
// 逐像素独立顺序求值,禁 atomic;只读输入、直写输出;全 f32 到最后一步量化。
//
// ## 参数面(eparams: f32 SSBO;5 f32)
//   [0]=width [1]=height [2]=exposure(线性倍率) [3]=inv_gamma(= 1/2.2)
//   [4]=raw(1 = **直通**:跳过曝光/ACES/伽马,只 clamp[0,1]×255 量化)
//   in_color: 3 f32/px scene-linear HDR;out_bgra: 1 u32/px(B|G<<8|R<<16|A<<24)
//
// `raw` 直通供调试视图用:调试量(反照率 / 法线编码 / N·L / 掩码)本就在 [0,1],
// 经 ACES 后不再可定量判读(0.3 与 1.0 都被推到 200+),直通后像素值 = 量值×255。
#[numthreads(8, 8, 1)]
kernel fn g41_water_encode(
    t: ThreadCtx<2>,
    in_color: View<global, f32>,
    eparams: View<global, f32>,
    out_bgra: ViewMut<global, u32>,
) {
    let px = t.global_id() as usize;
    let py = t.global_id_y() as usize;
    let w = eparams[0] as usize;
    let h = eparams[1] as usize;
    if px < w && py < h {
        let exposure = eparams[2];
        let inv_gamma = eparams[3];
        let raw = eparams[4].max(0.0).min(1.0);
        let i = (py * w + px) * 3usize;

        let src_r = in_color[i];
        let src_g = in_color[i + 1usize];
        let src_b = in_color[i + 2usize];

        let r0 = src_r * exposure;
        let g0 = src_g * exposure;
        let b0 = src_b * exposure;

        // ACES filmic 近似(Narkowicz 2015 曲线拟合)。
        let ca = 2.51;
        let cb = 0.03;
        let cc = 2.43;
        let cd = 0.59;
        let ce = 0.14;
        let r1 = (r0 * (ca * r0 + cb) / (r0 * (cc * r0 + cd) + ce))
            .max(0.0)
            .min(1.0);
        let g1 = (g0 * (ca * g0 + cb) / (g0 * (cc * g0 + cd) + ce))
            .max(0.0)
            .min(1.0);
        let b1 = (b0 * (ca * b0 + cb) / (b0 * (cc * b0 + cd) + ce))
            .max(0.0)
            .min(1.0);

        // 伽马编码 + 8-bit 量化(round-half-up)。
        let r_tm = (r1.powf(inv_gamma) * 255.0 + 0.5).max(0.0).min(255.0);
        let g_tm = (g1.powf(inv_gamma) * 255.0 + 0.5).max(0.0).min(255.0);
        let b_tm = (b1.powf(inv_gamma) * 255.0 + 0.5).max(0.0).min(255.0);

        // 直通量化(调试腿)。
        let r_rw = (src_r.max(0.0).min(1.0) * 255.0 + 0.5).min(255.0);
        let g_rw = (src_g.max(0.0).min(1.0) * 255.0 + 0.5).min(255.0);
        let b_rw = (src_b.max(0.0).min(1.0) * 255.0 + 0.5).min(255.0);

        let r2 = r_tm + (r_rw - r_tm) * raw;
        let g2 = g_tm + (g_rw - g_tm) * raw;
        let b2 = b_tm + (b_rw - b_tm) * raw;

        let rb = r2 as u32;
        let gb = g2 as u32;
        let bb = b2 as u32;
        out_bgra[py * w + px] = bb + gb * 256u32 + rb * 65536u32 + 255u32 * 16777216u32;
    }
}
