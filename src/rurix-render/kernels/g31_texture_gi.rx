//@ spec: RXS-0405 L3 device 面（G31+ 波 B Task B4 纹理采样生产接线；G14.3 M-c 车道 fork）
// G31+ 波 B Task B4 纹理采样生产车道 kernel —— g14_3_direct_gi.rx 逐字 fork +
// 逐三角 albedo 从"常量"升级为"贴图采样"（门 `g31.waveB.texture`；
// G31_PLUS_COMMERCIAL_RENDERER_TODO §1.2 #9；B3 slab 接线同构生产面）。
//
// ## 语义（与 g14_3_direct_gi.rx 逐字同模，唯一差异 = albedo 来源面）
// 既有面（0-byte 语义继承）：jitter 主射线 / ray query 最近命中 / 双面 Lambert
// 直接光（quad 4×4 分层 + point delta + 逐样本阴影射线）/ emissive 主命中 /
// ZO NDC 深度——与 kernels/g14_3_direct_gi.rx ②③④ 段逐字同式同序。
// **升级面（仅本 kernel 消费）**：命中三角 `tritex[prim] ≥ 0` 时 albedo[c] =
// 贴图双线性采样（srgb→linear LUT 后线性域过滤）× mod[c]（mod =
// baseColorFactor.rgb × (1−metallicFactor)，host 装配期预算 f32 位级传入——
// 既有 texture_mean_albedo 策略「均值 × factor × (1−metallic)」的逐像素
// 泛化；tritex[prim] < 0 走既有 mats 常量面逐字 0-byte）。
// UV = 主命中 committed 重心坐标插值（(1−u−v)·uv0 + u·uv1 + v·uv2；
// TEXCOORD_0 装配期 6 f32/tri 与 tris 同序同源）；寻址 = REPEAT wrap
// （bistro glTF sampler 默认面；fract 域回绕 + 边界纹素回绕，pow2 尺寸
// 装配期 fail-closed 限定 ⇒ 回绕坐标 f32 精确）；双线性 = G26
// sample_bilinear 逐字（floor 未钳 frac + 邻址 f32 域取址）；srgb→linear =
// 256 项 host LUT（与 host srgb_to_linear 逐字同式预算，零 pow 面——
// device/host 位级对拍锚；miss 像素 bary 不取（has_committed 门短臂置 0，
// 输出经 hit_f 门恒 0，NaN 零通道纪律与母版同律）。
//
// ## 确定性协议（RXS-0357 L2 同律继承 + B4 采样面）
// 逐像素独立顺序求值，禁 atomic；输出直写无跨像素交互；全 f32（u32 纹素
//  unpack 经 usize 精确算术，地址积经 usize 乘法——图集 >2^24 texel
//  故 f32 寻址域禁用，转 usize 后精确）；分支判定一律 min/max 算术门
// （big=1e30 门放大器）+ `has_committed` 短 selection 臂；除法分母一律
// max(tiny²) 保底；固定输入双跑位级一致（host 侧装配期 NoContraction
// 注入面 = SPV 文件 0-byte 后处理，驱动 FMA 收缩禁面——bilinear/LUT
// 链与 host 参考逐 op 位级对拍的前提）。
//
// ## 参数面（前 9 项与 g14_3_direct_gi.rx 逐字同源 + B4 采样面 5 项）
//   tlas/tris/mats/quads/points/params：与母版逐字同（params 48 f32 同布局，
//   host bin `g14_3_pipeline_perf::pack_frame_params` 单一事实源不变）。
//   texuv: 6 f32/tri TEXCOORD_0（装配期与 tris 同序烘焙）；
//   texmeta: [0]=atlas_w [1]=atlas_h [2]=slot_count [3..8]=reserved；
//            槽 k 于 [8+k*8..+8] = [origin_x, origin_y, w, h, mod_r, mod_g, mod_b, 0]；
//   tritex: 1 f32/tri（槽 k≥0 或 −1 = 常量面；整数值 f32 精确域 ≤2^24）；
//   atlas: u32/texel 打包 RGBA8（R|G<<8|B<<16|A<<24；host bcdec 镜像解码
//          BC1/BC3 mip0 → 2048 网格图集，G11.3 manifest rgba8_digest 互核面）；
//   linlut: 256 f32 srgb→linear LUT（host srgb_to_linear 逐字同式）；
//   out_color: 3 f32/px scene-linear HDR；out_depth: 1 f32/px ZO NDC。
#[numthreads(8, 8, 1)]
kernel fn g31_texture_gi(
    tlas: AccelStruct,
    t: ThreadCtx<2>,
    tris: View<global, f32>,
    mats: View<global, f32>,
    quads: View<global, f32>,
    points: View<global, f32>,
    params: View<global, f32>,
    texuv: View<global, f32>,
    texmeta: View<global, f32>,
    tritex: View<global, f32>,
    atlas: View<global, u32>,
    linlut: View<global, f32>,
    out_color: ViewMut<global, f32>,
    out_depth: ViewMut<global, f32>,
) {
    // 2D 车道索引（8×8 局部组；dispatch = ceil(w/8)×ceil(h/8)×1，与母版同字面）。
    let px = t.global_id();
    let py = t.global_id_y();
    let width = params[1] as usize;
    let height = params[2] as usize;
    let jx = params[3];
    let jy = params[4];
    let ray_eps = params[5];
    let ray_tmax = params[6];
    let quad_count = params[7] as usize;
    let point_count = params[8] as usize;
    let inv_pi = params[41];
    let big: f32 = 1e30;
    let tiny: f32 = 0.000001;
    let eps2 = ray_eps * ray_eps;
    if px < width && py < height {
        let i = py * width + px;
        // ── ① jitter 主射线（与母版逐字同式）──
        let sx = (px as f32) + 0.5 + jx;
        let sy = (py as f32) + 0.5 + jy;
        let ndx = 2.0 * (sx / (width as f32)) - 1.0;
        let ndy = 1.0 - 2.0 * (sy / (params[2] as f32));
        let n4x = (params[9] * ndx + params[10] * ndy) + params[12];
        let n4y = (params[13] * ndx + params[14] * ndy) + params[16];
        let n4z = (params[17] * ndx + params[18] * ndy) + params[20];
        let n4w = (params[21] * ndx + params[22] * ndy) + params[24];
        let f4x = ((params[9] * ndx + params[10] * ndy) + params[11]) + params[12];
        let f4y = ((params[13] * ndx + params[14] * ndy) + params[15]) + params[16];
        let f4z = ((params[17] * ndx + params[18] * ndy) + params[19]) + params[20];
        let f4w = ((params[21] * ndx + params[22] * ndy) + params[23]) + params[24];
        let near_x = n4x / n4w;
        let near_y = n4y / n4w;
        let near_z = n4z / n4w;
        let d0x = f4x / f4w - near_x;
        let d0y = f4y / f4w - near_y;
        let d0z = f4z / f4w - near_z;
        let dl = (d0x * d0x + d0y * d0y + d0z * d0z).sqrt();
        let gate_dl = (dl * big).min(1.0).max(0.0);
        let dl_safe = dl + (1.0 - gate_dl);
        let dx = gate_dl * d0x / dl_safe;
        let dy = gate_dl * d0y / dl_safe;
        let dz = gate_dl * d0z / dl_safe;
        // ── ② 主 ray query（最近命中；与母版逐字同式）──
        let mut rq = ray_query_initialize(tlas, (near_x, near_y, near_z), 0.0, (dx, dy, dz), ray_tmax);
        while rq.proceed() {
        }
        let mut hit_f = 1.0;
        let mut th = 0.0;
        let mut prim = 0u32;
        // B4：重心坐标门面（miss 臂不取——uncommitted 值未定义面，has_committed
        // 短 selection 臂置 0，下游采样读有效地址，输出经 hit_f 门恒 0）。
        let mut bu = 0.0;
        let mut bv = 0.0;
        if rq.has_committed() {
            th = rq.committed_t();
            prim = rq.committed_primitive_index();
            let bary = rq.committed_barycentric();
            bu = bary.0;
            bv = bary.1;
            hit_f = 1.0;
        } else {
            hit_f = 0.0;
            th = 0.0;
            prim = 0u32;
            bu = 0.0;
            bv = 0.0;
        }
        // 命中点/几何法线/材质（miss 时 prim=0 保底，贡献经 hit_f 门恒 0）。
        let tb = (prim as usize) * 9;
        let ax = tris[tb];
        let ay = tris[tb + 1];
        let az = tris[tb + 2];
        let e1x = tris[tb + 3] - ax;
        let e1y = tris[tb + 4] - ay;
        let e1z = tris[tb + 5] - az;
        let e2x = tris[tb + 6] - ax;
        let e2y = tris[tb + 7] - ay;
        let e2z = tris[tb + 8] - az;
        let ngx = e1y * e2z - e1z * e2y;
        let ngy = e1z * e2x - e1x * e2z;
        let ngz = e1x * e2y - e1y * e2x;
        let nl = (ngx * ngx + ngy * ngy + ngz * ngz).sqrt();
        let gate_nl = (nl * big).min(1.0).max(0.0);
        let nl_safe = nl + (1.0 - gate_nl);
        let inv_nl = 1.0 / nl_safe;
        let hgx = gate_nl * (ngx * inv_nl);
        let hgy = gate_nl * (ngy * inv_nl);
        let hgz = gate_nl * (ngz * inv_nl);
        let fac0 = hgx * dx + hgy * dy + hgz * dz;
        let flip = 1.0 - 2.0 * (fac0 * big).min(1.0).max(0.0);
        let nx = flip * hgx;
        let ny = flip * hgy;
        let nz = flip * hgz;
        let hx = near_x + dx * th;
        let hy = near_y + dy * th;
        let hz = near_z + dz * th;
        let mb = (prim as usize) * 8;
        // ── B4 贴图采样 albedo（tritex[prim] ≥ 0 槽位面；< 0 = 既有常量面 0-byte；
        //    采样块与 kernels/g31_texture_probe.rx 逐字同形——探针臂 = 本块隔离
        //    对拍面，host 参考 = bin g14_3_lane_body::g31_tex_host_sample 同 op 序）──
        let slotf = tritex[prim as usize];
        let tex_gate = (slotf + 1.0).min(1.0).max(0.0);
        let slot = slotf.max(0.0) as usize;
        let sb = 8 + slot * 8;
        let ox = texmeta[sb];
        let oy = texmeta[sb + 1];
        let tw = texmeta[sb + 2];
        let th2 = texmeta[sb + 3];
        let mod_r = texmeta[sb + 4];
        let mod_g = texmeta[sb + 5];
        let mod_b = texmeta[sb + 6];
        let aw = texmeta[0];
        let bw_ = 1.0 - bu - bv;
        let ub = (prim as usize) * 6;
        let uu0 = bw_ * texuv[ub] + bu * texuv[ub + 2] + bv * texuv[ub + 4];
        let vv0 = bw_ * texuv[ub + 1] + bu * texuv[ub + 3] + bv * texuv[ub + 5];
        // REPEAT wrap（fract 域回绕；负域 fract = x − floor(x) 同式覆盖）。
        let uu = uu0 - uu0.floor();
        let vv = vv0 - vv0.floor();
        // 双线性（G26 sample_bilinear 逐字：floor 未钳 frac）。
        let xf = uu * tw - 0.5;
        let yf = vv * th2 - 0.5;
        let bxf = xf.floor();
        let byf = yf.floor();
        let fx = xf - bxf;
        let fy = yf - byf;
        // wrap 域纹素坐标（bxf ∈ [−1, w−1] 单回绕面；pow2 尺寸 ⇒ inv 精确）。
        let inv_tw = 1.0 / tw;
        let inv_th = 1.0 / th2;
        let x0 = bxf - (bxf * inv_tw).floor() * tw;
        let y0 = byf - (byf * inv_th).floor() * th2;
        let x1 = (bxf + 1.0) - ((bxf + 1.0) * inv_tw).floor() * tw;
        let y1 = (byf + 1.0) - ((byf + 1.0) * inv_th).floor() * th2;
        // 图集线性地址（图集 texel 数 >2^24 ⇒ 积域转 usize 精确；oy+y0/ox+x0
        // f32 精确域 <2^24 先加后转）。
        let a00 = ((oy + y0) as usize) * (aw as usize) + ((ox + x0) as usize);
        let a10 = ((oy + y0) as usize) * (aw as usize) + ((ox + x1) as usize);
        let a01 = ((oy + y1) as usize) * (aw as usize) + ((ox + x0) as usize);
        let a11 = ((oy + y1) as usize) * (aw as usize) + ((ox + x1) as usize);
        // u32 打包纹素 unpack（usize 精确算术；R|G<<8|B<<16|A<<24 布局）。
        let p00 = atlas[a00] as usize;
        let p10 = atlas[a10] as usize;
        let p01 = atlas[a01] as usize;
        let p11 = atlas[a11] as usize;
        // srgb→linear LUT（u8 精确索引；零 pow 面 = device/host 位级对拍锚）。
        let p00_r = linlut[p00 % 256usize];
        let p00_g = linlut[(p00 / 256usize) % 256usize];
        let p00_b = linlut[(p00 / 65536usize) % 256usize];
        let p10_r = linlut[p10 % 256usize];
        let p10_g = linlut[(p10 / 256usize) % 256usize];
        let p10_b = linlut[(p10 / 65536usize) % 256usize];
        let p01_r = linlut[p01 % 256usize];
        let p01_g = linlut[(p01 / 256usize) % 256usize];
        let p01_b = linlut[(p01 / 65536usize) % 256usize];
        let p11_r = linlut[p11 % 256usize];
        let p11_g = linlut[(p11 / 256usize) % 256usize];
        let p11_b = linlut[(p11 / 65536usize) % 256usize];
        // top/bot/mix（G26 操作序逐字）× mod（factor×(1−metallic) 装配期预算）。
        let t0r = p00_r * (1.0 - fx) + p10_r * fx;
        let b0r = p01_r * (1.0 - fx) + p11_r * fx;
        let samp_r = (t0r * (1.0 - fy) + b0r * fy) * mod_r;
        let t0g = p00_g * (1.0 - fx) + p10_g * fx;
        let b0g = p01_g * (1.0 - fy) + p11_g * fy;
        let samp_g = (t0g * (1.0 - fy) + b0g * fy) * mod_g;
        let t0b = p00_b * (1.0 - fx) + p10_b * fx;
        let b0b = p01_b * (1.0 - fy) + p11_b * fy;
        let samp_b = (t0b * (1.0 - fy) + b0b * fy) * mod_b;
        let al_r = tex_gate * samp_r + (1.0 - tex_gate) * mats[mb];
        let al_g = tex_gate * samp_g + (1.0 - tex_gate) * mats[mb + 1];
        let al_b = tex_gate * samp_b + (1.0 - tex_gate) * mats[mb + 2];
        // ── ③ 直接光累加（lo 初值 = emission，emissive 主命中无条件项；与母版逐字同式）──
        let mut dir_r = 0.0;
        let mut dir_g = 0.0;
        let mut dir_b = 0.0;
        let mut qi = 0usize;
        while qi < quad_count {
            let qb = qi * 16;
            let qp_x = quads[qb];
            let qp_y = quads[qb + 1];
            let qp_z = quads[qb + 2];
            let qe1_x = quads[qb + 3];
            let qe1_y = quads[qb + 4];
            let qe1_z = quads[qb + 5];
            let qe2_x = quads[qb + 6];
            let qe2_y = quads[qb + 7];
            let qe2_z = quads[qb + 8];
            let qle_r = quads[qb + 9];
            let qle_g = quads[qb + 10];
            let qle_b = quads[qb + 11];
            let sample_area = quads[qb + 12] * 0.0625;
            let qn_x = quads[qb + 13];
            let qn_y = quads[qb + 14];
            let qn_z = quads[qb + 15];
            let mut acc_r = 0.0;
            let mut acc_g = 0.0;
            let mut acc_b = 0.0;
            let mut syq = 0usize;
            while syq < 4 {
                let mut sxq = 0usize;
                while sxq < 4 {
                    let u = (sxq as f32 + 0.5) * 0.25;
                    let v = (syq as f32 + 0.5) * 0.25;
                    let lp_x = qp_x + u * qe1_x + v * qe2_x;
                    let lp_y = qp_y + u * qe1_y + v * qe2_y;
                    let lp_z = qp_z + u * qe1_z + v * qe2_z;
                    let lv_x = lp_x - hx;
                    let lv_y = lp_y - hy;
                    let lv_z = lp_z - hz;
                    let d2 = lv_x * lv_x + lv_y * lv_y + lv_z * lv_z;
                    let gate_d = ((d2 - eps2) * big).min(1.0).max(0.0);
                    let d2s = d2.max(tiny * tiny);
                    let d = d2s.sqrt();
                    let wix = lv_x / d;
                    let wiy = lv_y / d;
                    let wiz = lv_z / d;
                    let cos_s = (nx * wix + ny * wiy + nz * wiz).max(0.0);
                    let gate_cs = (cos_s * big).min(1.0).max(0.0);
                    let cos_l = 0.0 - (qn_x * wix + qn_y * wiy + qn_z * wiz);
                    let gate_cl = (cos_l * big).min(1.0).max(0.0);
                    let t_sh = d - 2.0 * ray_eps;
                    let gate_far = (t_sh * big).min(1.0).max(0.0);
                    let t_fire = t_sh.max(ray_eps);
                    // G14.9 背光 keep 预判跳射线 + first-hit 早退（与母版逐字同式）。
                    let keep_pre = hit_f * gate_d * gate_cs * gate_cl;
                    let mut blk = 0.0;
                    if keep_pre > 0.0 {
                        let mut sq = ray_query_initialize_first_hit(
                            tlas,
                            (hx + wix * ray_eps, hy + wiy * ray_eps, hz + wiz * ray_eps),
                            0.0,
                            (wix, wiy, wiz),
                            t_fire,
                        );
                        while sq.proceed() {
                        }
                        if sq.has_committed() {
                            blk = 1.0;
                        } else {
                            blk = 0.0;
                        }
                    }
                    let vis = 1.0 - gate_far * blk;
                    let g = (cos_s * cos_l / d2s) * sample_area;
                    let keep = keep_pre * vis;
                    acc_r = acc_r + qle_r * g * keep;
                    acc_g = acc_g + qle_g * g * keep;
                    acc_b = acc_b + qle_b * g * keep;
                    sxq = sxq + 1;
                }
                syq = syq + 1;
            }
            dir_r = dir_r + acc_r;
            dir_g = dir_g + acc_g;
            dir_b = dir_b + acc_b;
            qi = qi + 1;
        }
        let mut pi_ = 0usize;
        while pi_ < point_count {
            let pb = pi_ * 8;
            let lv_x = points[pb] - hx;
            let lv_y = points[pb + 1] - hy;
            let lv_z = points[pb + 2] - hz;
            let li_r = points[pb + 3];
            let li_g = points[pb + 4];
            let li_b = points[pb + 5];
            let d2 = lv_x * lv_x + lv_y * lv_y + lv_z * lv_z;
            let gate_d = ((d2 - eps2) * big).min(1.0).max(0.0);
            let d2s = d2.max(tiny * tiny);
            let d = d2s.sqrt();
            let wix = lv_x / d;
            let wiy = lv_y / d;
            let wiz = lv_z / d;
            let cos_s = (nx * wix + ny * wiy + nz * wiz).max(0.0);
            let gate_cs = (cos_s * big).min(1.0).max(0.0);
            let t_sh = d - 2.0 * ray_eps;
            let gate_far = (t_sh * big).min(1.0).max(0.0);
            let t_fire = t_sh.max(ray_eps);
            let keep_pre = hit_f * gate_d * gate_cs;
            let mut blk = 0.0;
            if keep_pre > 0.0 {
                let mut sq = ray_query_initialize_first_hit(
                    tlas,
                    (hx + wix * ray_eps, hy + wiy * ray_eps, hz + wiz * ray_eps),
                    0.0,
                    (wix, wiy, wiz),
                    t_fire,
                );
                while sq.proceed() {
                }
                if sq.has_committed() {
                    blk = 1.0;
                } else {
                    blk = 0.0;
                }
            }
            let vis = 1.0 - gate_far * blk;
            let g = cos_s / d2s;
            let keep = keep_pre * vis;
            dir_r = dir_r + li_r * g * keep;
            dir_g = dir_g + li_g * g * keep;
            dir_b = dir_b + li_b * g * keep;
            pi_ = pi_ + 1;
        }
        // ── ④ 深度（未抖 vp ZO NDC；与母版逐字同式）──
        let cz = ((params[25] * hx + params[26] * hy) + params[27] * hz) + params[28];
        let cw = ((params[29] * hx + params[30] * hy) + params[31] * hz) + params[32];
        let cw_abs = cw.max(0.0 - cw);
        let gate_w = ((cw_abs - 0.00000001) * big).min(1.0).max(0.0);
        let cw_safe = cw + (1.0 - gate_w);
        let z_hit = gate_w * (cz / cw_safe) + (1.0 - gate_w);
        // ── 输出（lo = emission + albedo·inv_pi·direct，与母版逐字同序）──
        out_color[i * 3] = hit_f * (mats[mb + 3] + al_r * inv_pi * dir_r);
        out_color[i * 3 + 1] = hit_f * (mats[mb + 4] + al_g * inv_pi * dir_g);
        out_color[i * 3 + 2] = hit_f * (mats[mb + 5] + al_b * inv_pi * dir_b);
        out_depth[i] = hit_f * z_hit + (1.0 - hit_f);
    }
}
