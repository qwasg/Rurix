//@ spec: RXS-0405 L3 device 面（G14plus G14.10b cornell 拆散车道——主射线腿）
// G14plus cornell 16 样本拆散重排 pass0（RFC-0030 授权 G14.4 取证 f 条兑现；
// G14PLUS_RECORD §3 优化清单 #9）。三 pass 车道 = primary（本文件，①②段）→
// shadow_scatter（16 层每 invocation 1 条阴影 ray——RT 单元延迟隐藏）→
// shade_reduce（固定 0..15 序重算几何项并累加——与原 g14_3_direct_gi 串行循环
// **位级同序**）。仅 quad 面光场景（cornell）车道启用；bistro（点光）维持
// g14_3_direct_gi 单 kernel。
//
// ## 语义（g14_3_direct_gi.rx ①② 段逐字同式）
// 每像素：jitter 主射线（未抖 inv_vp 反投影，closest-hit ray query——主射线
// 需最近命中，禁 first-hit 内建）→ 写 hitinfo（t + prim as f32——prim <
// 2^24 精确）。miss：hit_f=0 → t=0, prim=0（下游 hit_f 门恒零同语义——
// hit_f 由 t>0 无法区分 t=0 命中?主射线 tmin=0 起 t=0 命中不可能〔相机在
// 几何外〕，t=0 恒 miss 语义与原 kernel hit_f 门等价——写 out_t=0 表 miss，
// reduce/scatter 侧 hit_f = (t>0) 门重建）。
// 注：原 kernel 的 hit_f ∈ {0,1} 由 has_committed 直接判——本拆散车道用
// t>0 编码同一布尔（committed_t 恒 >0 于本场景：相机外置 tmin=0 无自交）。
//
// ## 确定性协议（RXS-0357 L2 继承）
// 逐像素独立；禁 atomic；固定输入双跑位级一致。
//
// ## 参数面（g14_3_direct_gi 同一 48 f32 params 布局；tris 同 buffer）
//   out_t: 1 f32/px（committed_t；miss=0）；out_prim: 1 f32/px（prim as f32）。
#[numthreads(8, 8, 1)]
kernel fn g14_3_primary(
    tlas: AccelStruct,
    t: ThreadCtx<2>,
    params: View<global, f32>,
    out_t: ViewMut<global, f32>,
    out_prim: ViewMut<global, f32>,
) {
    let px = t.global_id();
    let py = t.global_id_y();
    let width = params[1] as usize;
    let height = params[2] as usize;
    let jx = params[3];
    let jy = params[4];
    let ray_tmax = params[6];
    let big: f32 = 1e30;
    if px < width && py < height {
        let i = py * width + px;
        // ── ① jitter 主射线（g14_3_direct_gi ①段逐字）──
        let sx = (px as f32) + 0.5 + jx;
        let sy = (py as f32) + 0.5 + jy;
        let ndx = 2.0 * (sx / (width as f32)) - 1.0;
        let ndy = 1.0 - 2.0 * (sy / (params[2] as f32));
        let n4x = (params[9] * ndx + params[10] * ndy) + params[12];
        let n4y = (params[13] * ndx + params[14] * ndy) + params[16];
        let n4z = (params[17] * ndx + params[18] * ndy) + params[20];
        let n4w = (params[21] * ndx + params[22] * ndy) + params[24];
        let f4x = ((params[9] * ndx + params[10] * ndy) + params[11]) + params[12];
        let f4y = ((params[13] * ndx + params[14] * ndy) + params[15]) + params[16];
        let f4z = ((params[17] * ndx + params[18] * ndy) + params[19]) + params[20];
        let f4w = ((params[21] * ndx + params[22] * ndy) + params[23]) + params[24];
        let near_x = n4x / n4w;
        let near_y = n4y / n4w;
        let near_z = n4z / n4w;
        let d0x = f4x / f4w - near_x;
        let d0y = f4y / f4w - near_y;
        let d0z = f4z / f4w - near_z;
        let dl = (d0x * d0x + d0y * d0y + d0z * d0z).sqrt();
        let gate_dl = (dl * big).min(1.0).max(0.0);
        let dl_safe = dl + (1.0 - gate_dl);
        let dx = gate_dl * d0x / dl_safe;
        let dy = gate_dl * d0y / dl_safe;
        let dz = gate_dl * d0z / dl_safe;
        // ── ② 主 ray query（最近命中；closest-hit 语义——禁 first-hit）──
        let mut rq = ray_query_initialize(tlas, (near_x, near_y, near_z), 0.0, (dx, dy, dz), ray_tmax);
        while rq.proceed() {
        }
        let mut th = 0.0;
        let mut prim = 0u32;
        if rq.has_committed() {
            th = rq.committed_t();
            prim = rq.committed_primitive_index();
        } else {
            th = 0.0;
            prim = 0u32;
        }
        out_t[i] = th;
        out_prim[i] = prim as f32;
    }
}
