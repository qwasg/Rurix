//@ spec: RXS-0405 L3 device 面（G14.3 M-c 生产 GPU 场景车道）
// G14.3 M-c Rurix 生产管线性能面 kernel —— device 持久车道主射线 + 双面
// Lambert 直接光（门 `g14.p0.m_c.rurix_pipeline_perf`；G14_CONTRACT §4.2 M-c 行）。
//
// ## 语义（与 G13.4 host `render_frame`/`shade_pixel` 逐字同模——M-d 画质守护
// 可比性锚；g13_4_ue_upscale_parity_render.rs L1902 语义面镜像）
// 逐像素单 invocation（ThreadCtx<1>，LocalSize 1,1,1 车道沿 G9.4~G13.3 同模）：
// ① jitter 主射线 = 未抖 inv_vp 反投影（采样点含 Halton jitter，host
//    `unproject` 同式：ndc = [2u−1, 1−2v, z]，z=0/1 两点定射线，dir 归一化）；
// ② ray query 最近命中 → 逐三角 albedo/emission（mats 8 f32/tri，tris 9 f32/tri
//    顶点序 = primitiveIndex 序，M96/M100 同律）；
// ③ 双面 Lambert 直接光：quad 面光 4×4 分层确定性采样（u=(sx+0.5)/4 逐字，
//    g = cos_s·cos_l/d²·sample_area）+ point 灯 delta（g = cos_s/d²）+ 逐样本
//    阴影射线（origin = p + wl·eps，t_max = d−2eps；t_max ≤ 0 恒可见——host
//    `visible` 同字面）+ emissive 主命中（lo 初值 = emission[tri]，无条件）；
// ④ 深度 = 未抖 vp 的 ZO NDC（clip.z/clip.w；|w|≤1e-8 → 1.0，host 同字面）；
//    miss → color=(0,0,0)、depth=1.0（host 同字面）。
// G16plus 加性 GI 臂（RFC-0031）：主射线直接光与 g14_3_direct_gi 同式，再叠加
// ≥2 次余弦半球反弹；次级命中对 emissive/quad/point 做 NEE。第二反弹 miss
// 只丢能量不漏光（无天光）。禁止改 --gi off 默认臂。
//
// ## 确定性协议（RXS-0357 L2 同律继承）
// 逐像素独立顺序求值，禁 atomic；输出直写无跨像素交互；固定输入双跑位级一致。
// 全 f32；分支判定一律 min/max 算术门（big=1e30 门放大器，M96/M100 白名单形）
// + `has_committed` 短 selection 臂；除法分母一律 max(tiny²) 保底（tiny=1e-6
// ≤ ray_eps，kept 样本恒等位级）。NaN 零通道：miss 臂 prim=0 保底读 + hit_f
// 门归零。
//
// ## 参数面（host bin `g14_3_pipeline_perf::pack_frame_params` 逐字同源；48 f32）
//   params[0]=pixel_count [1]=width [2]=height [3]=jitter_x [4]=jitter_y
//   [5]=ray_eps [6]=ray_tmax [7]=quad_count [8]=point_count
//   [9..25]=inv_vp（未抖，行主序 m[r][c] → [9+r*4+c]；主射线反投影）
//   [25..41]=vp（未抖，同布局；深度 clip 面） [41]=inv_pi（host 位级传入）
//   [42..48]=reserved（恒 0）。
//   tris: 9 f32/tri 世界空间三角形汤（与 BLAS 输入逐字节同 buffer 内容）；
//   mats: 8 f32/tri [albedo 3, emission 3, 0, 0]；
//   quads: 16 f32/quad [p00 3, e1 3, e2 3, le 3, area, qn 3]（area/qn host
//          f32 预算——cross/normalize 操作序与 host shade_pixel 逐字同式）；
//   points: 8 f32/point [pos 3, intensity 3, 0, 0]；
//   out_color: 3 f32/px scene-linear HDR；out_depth: 1 f32/px ZO NDC。
// RFC-0031 G16plus 加性多反弹 kernel（g16_gi_multibounce.rx；--gi on 专用 SPV）。
#[numthreads(8, 8, 1)]
kernel fn g14_3_direct_gi(
    tlas: AccelStruct,
    t: ThreadCtx<2>,
    tris: View<global, f32>,
    mats: View<global, f32>,
    quads: View<global, f32>,
    points: View<global, f32>,
    params: View<global, f32>,
    out_color: ViewMut<global, f32>,
    out_depth: ViewMut<global, f32>,
) {
    // 2D 车道索引（8×8 局部组；dispatch = ceil(w/8)×ceil(h/8)×1，host bin
    // `g14_3_pipeline_perf` 同一字面）。越界组（px ≥ w 或 py ≥ h）不产写——
    // 与 1D 形态 `i < pixel_count` 门同覆盖域，逐像素数学全式逐字不变。
    let px = t.global_id();
    let py = t.global_id_y();
    let width = params[1] as usize;
    let height = params[2] as usize;
    let jx = params[3];
    let jy = params[4];
    let ray_eps = params[5];
    let ray_tmax = params[6];
    let quad_count = params[7] as usize;
    let point_count = params[8] as usize;
    let inv_pi = params[41];
    let big: f32 = 1e30;
    let tiny: f32 = 0.000001;
    let eps2 = ray_eps * ray_eps;
    if px < width && py < height {
        let i = py * width + px;
        // ── ① jitter 主射线（host unproject 同式：未抖 inv_vp · [ndx,ndy,z,1]）──
        let sx = (px as f32) + 0.5 + jx;
        let sy = (py as f32) + 0.5 + jy;
        let ndx = 2.0 * (sx / (width as f32)) - 1.0;
        let ndy = 1.0 - 2.0 * (sy / (params[2] as f32));
        // z=0（near）与 z=1（far）两点反投影（行主序 clip = M·v，逐行
        // ((m0·x + m1·y) + m2·z) + m3 左结合，host transform_vec4 同序）。
        let n4x = (params[9] * ndx + params[10] * ndy) + params[12];
        let n4y = (params[13] * ndx + params[14] * ndy) + params[16];
        let n4z = (params[17] * ndx + params[18] * ndy) + params[20];
        let n4w = (params[21] * ndx + params[22] * ndy) + params[24];
        let f4x = ((params[9] * ndx + params[10] * ndy) + params[11]) + params[12];
        let f4y = ((params[13] * ndx + params[14] * ndy) + params[15]) + params[16];
        let f4z = ((params[17] * ndx + params[18] * ndy) + params[19]) + params[20];
        let f4w = ((params[21] * ndx + params[22] * ndy) + params[23]) + params[24];
        let near_x = n4x / n4w;
        let near_y = n4y / n4w;
        let near_z = n4z / n4w;
        let d0x = f4x / f4w - near_x;
        let d0y = f4y / f4w - near_y;
        let d0z = f4z / f4w - near_z;
        // dir 归一化（host norm3 同式：l>0 门，l=0 → 零向量）。
        let dl = (d0x * d0x + d0y * d0y + d0z * d0z).sqrt();
        let gate_dl = (dl * big).min(1.0).max(0.0);
        let dl_safe = dl + (1.0 - gate_dl);
        let dx = gate_dl * d0x / dl_safe;
        let dy = gate_dl * d0y / dl_safe;
        let dz = gate_dl * d0z / dl_safe;
        // ── ② 主 ray query（最近命中；空体循环 = M96 白名单形）──
        let mut rq = ray_query_initialize(tlas, (near_x, near_y, near_z), 0.0, (dx, dy, dz), ray_tmax);
        while rq.proceed() {
        }
        let mut hit_f = 1.0;
        let mut th = 0.0;
        let mut prim = 0u32;
        if rq.has_committed() {
            th = rq.committed_t();
            prim = rq.committed_primitive_index();
            hit_f = 1.0;
        } else {
            hit_f = 0.0;
            th = 0.0;
            prim = 0u32;
        }
        // 命中点/几何法线/材质（miss 时 prim=0 保底，贡献经 hit_f 门恒 0）。
        let tb = (prim as usize) * 9;
        let ax = tris[tb];
        let ay = tris[tb + 1];
        let az = tris[tb + 2];
        let e1x = tris[tb + 3] - ax;
        let e1y = tris[tb + 4] - ay;
        let e1z = tris[tb + 5] - az;
        let e2x = tris[tb + 6] - ax;
        let e2y = tris[tb + 7] - ay;
        let e2z = tris[tb + 8] - az;
        let ngx = e1y * e2z - e1z * e2y;
        let ngy = e1z * e2x - e1x * e2z;
        let ngz = e1x * e2y - e1y * e2x;
        let nl = (ngx * ngx + ngy * ngy + ngz * ngz).sqrt();
        let gate_nl = (nl * big).min(1.0).max(0.0);
        let nl_safe = nl + (1.0 - gate_nl);
        // 法线归一化 = host `Vec3::normalize` 倒数乘口径（self·(1/l)，位级同式；
        // 区别于 bin norm3 的除法口径——主射线 dir 归一化走除法，见上）。
        let inv_nl = 1.0 / nl_safe;
        let hgx = gate_nl * (ngx * inv_nl);
        let hgy = gate_nl * (ngy * inv_nl);
        let hgz = gate_nl * (ngz * inv_nl);
        // 双面：法线翻转朝向相机（host render_frame two-sided 同律；facing=0 不翻）。
        let fac0 = hgx * dx + hgy * dy + hgz * dz;
        let flip = 1.0 - 2.0 * (fac0 * big).min(1.0).max(0.0);
        let nx = flip * hgx;
        let ny = flip * hgy;
        let nz = flip * hgz;
        let hx = near_x + dx * th;
        let hy = near_y + dy * th;
        let hz = near_z + dz * th;
        let mb = (prim as usize) * 8;
        let al_r = mats[mb];
        let al_g = mats[mb + 1];
        let al_b = mats[mb + 2];
        // ── ③ 直接光累加（lo 初值 = emission，emissive 主命中无条件项）──
        let mut dir_r = 0.0;
        let mut dir_g = 0.0;
        let mut dir_b = 0.0;
        // ── quad 面光 4×4 分层确定性采样（host shade_pixel L1902 同式）──
        let mut qi = 0usize;
        while qi < quad_count {
            let qb = qi * 16;
            let qp_x = quads[qb];
            let qp_y = quads[qb + 1];
            let qp_z = quads[qb + 2];
            let qe1_x = quads[qb + 3];
            let qe1_y = quads[qb + 4];
            let qe1_z = quads[qb + 5];
            let qe2_x = quads[qb + 6];
            let qe2_y = quads[qb + 7];
            let qe2_z = quads[qb + 8];
            let qle_r = quads[qb + 9];
            let qle_g = quads[qb + 10];
            let qle_b = quads[qb + 11];
            let sample_area = quads[qb + 12] * 0.0625;
            let qn_x = quads[qb + 13];
            let qn_y = quads[qb + 14];
            let qn_z = quads[qb + 15];
            let mut acc_r = 0.0;
            let mut acc_g = 0.0;
            let mut acc_b = 0.0;
            let mut syq = 0usize;
            while syq < 4 {
                let mut sxq = 0usize;
                while sxq < 4 {
                    let u = (sxq as f32 + 0.5) * 0.25;
                    let v = (syq as f32 + 0.5) * 0.25;
                    let lp_x = qp_x + u * qe1_x + v * qe2_x;
                    let lp_y = qp_y + u * qe1_y + v * qe2_y;
                    let lp_z = qp_z + u * qe1_z + v * qe2_z;
                    let lv_x = lp_x - hx;
                    let lv_y = lp_y - hy;
                    let lv_z = lp_z - hz;
                    let d2 = lv_x * lv_x + lv_y * lv_y + lv_z * lv_z;
                    // host `d2 <= eps² → continue` 门（d2=eps² 边界同字面）。
                    let gate_d = ((d2 - eps2) * big).min(1.0).max(0.0);
                    let d2s = d2.max(tiny * tiny);
                    let d = d2s.sqrt();
                    let wix = lv_x / d;
                    let wiy = lv_y / d;
                    let wiz = lv_z / d;
                    let cos_s = (nx * wix + ny * wiy + nz * wiz).max(0.0);
                    let gate_cs = (cos_s * big).min(1.0).max(0.0);
                    let cos_l = 0.0 - (qn_x * wix + qn_y * wiy + qn_z * wiz);
                    let gate_cl = (cos_l * big).min(1.0).max(0.0);
                    // 阴影射线（host visible 同字面：origin 沿 wl 偏 eps，
                    // t_max = d−2eps ≤ 0 恒可见不发射；发射形保持经 gate_far 门）。
                    let t_sh = d - 2.0 * ray_eps;
                    let gate_far = (t_sh * big).min(1.0).max(0.0);
                    let t_fire = t_sh.max(ray_eps);
                    // G14.9 背光 keep 预判跳射线（RFC-0030 §4.4 L2 ①，严格位级不变）：
                    // keep = hit_f·gate_d·gate_cs·gate_cl·vis——前置四门任一为 0 时
                    // keep 恒 0，vis 值不被消费（acc 贡献 = qle·g·0 = +0.0 与原逐位
                    // 同），阴影 ray query 发射可跳过；四门非 0 时行为与原逐字一致。
                    // G14.9 first-hit 早退（RFC-0030 §4.6 L2）：阴影臂仅消费
                    // has_committed 存在性布尔——全 opaque 场景 first-hit 与
                    // closest-hit 存在性等价，图像位级不变；主射线（需最近命中）
                    // 禁用本内建维持 ray_query_initialize。
                    let keep_pre = hit_f * gate_d * gate_cs * gate_cl;
                    let mut blk = 0.0;
                    if keep_pre > 0.0 {
                        let mut sq = ray_query_initialize_first_hit(
                            tlas,
                            (hx + wix * ray_eps, hy + wiy * ray_eps, hz + wiz * ray_eps),
                            0.0,
                            (wix, wiy, wiz),
                            t_fire,
                        );
                        while sq.proceed() {
                        }
                        if sq.has_committed() {
                            blk = 1.0;
                        } else {
                            blk = 0.0;
                        }
                    }
                    let vis = 1.0 - gate_far * blk;
                    // g = cos_s·cos_l/d²·sample_area（host 左结合同序）。
                    let g = (cos_s * cos_l / d2s) * sample_area;
                    let keep = keep_pre * vis;
                    acc_r = acc_r + qle_r * g * keep;
                    acc_g = acc_g + qle_g * g * keep;
                    acc_b = acc_b + qle_b * g * keep;
                    sxq = sxq + 1;
                }
                syq = syq + 1;
            }
            dir_r = dir_r + acc_r;
            dir_g = dir_g + acc_g;
            dir_b = dir_b + acc_b;
            qi = qi + 1;
        }
        // ── point 灯 delta（g = cos_s/d²；I = color×intensity_cd host 预乘）──
        let mut pi_ = 0usize;
        while pi_ < point_count {
            let pb = pi_ * 8;
            let lv_x = points[pb] - hx;
            let lv_y = points[pb + 1] - hy;
            let lv_z = points[pb + 2] - hz;
            let li_r = points[pb + 3];
            let li_g = points[pb + 4];
            let li_b = points[pb + 5];
            let d2 = lv_x * lv_x + lv_y * lv_y + lv_z * lv_z;
            let gate_d = ((d2 - eps2) * big).min(1.0).max(0.0);
            let d2s = d2.max(tiny * tiny);
            let d = d2s.sqrt();
            let wix = lv_x / d;
            let wiy = lv_y / d;
            let wiz = lv_z / d;
            let cos_s = (nx * wix + ny * wiy + nz * wiz).max(0.0);
            let gate_cs = (cos_s * big).min(1.0).max(0.0);
            let t_sh = d - 2.0 * ray_eps;
            let gate_far = (t_sh * big).min(1.0).max(0.0);
            let t_fire = t_sh.max(ray_eps);
            // G14.9 背光 keep 预判跳射线（quad 臂同律；三门任一为 0 时 vis 不被
            // 消费，跳过发射位级不变）+ first-hit 早退（阴影臂存在性消费等价）。
            let keep_pre = hit_f * gate_d * gate_cs;
            let mut blk = 0.0;
            if keep_pre > 0.0 {
                let mut sq = ray_query_initialize_first_hit(
                    tlas,
                    (hx + wix * ray_eps, hy + wiy * ray_eps, hz + wiz * ray_eps),
                    0.0,
                    (wix, wiy, wiz),
                    t_fire,
                );
                while sq.proceed() {
                }
                if sq.has_committed() {
                    blk = 1.0;
                } else {
                    blk = 0.0;
                }
            }
            let vis = 1.0 - gate_far * blk;
            let g = cos_s / d2s;
            let keep = keep_pre * vis;
            dir_r = dir_r + li_r * g * keep;
            dir_g = dir_g + li_g * g * keep;
            dir_b = dir_b + li_b * g * keep;
            pi_ = pi_ + 1;
        }

        // ── ⑤ 加性间接光（≥2 反弹；余弦半球 + 次级 NEE 2×2；RFC-0031）──
        // 吞吐：Lambert 余弦采样 ⇒ 下一路 × albedo（π 与 cos/pdf 相消）。
        let mut thr_r = al_r;
        let mut thr_g = al_g;
        let mut thr_b = al_b;
        let mut bx_p = hx;
        let mut by_p = hy;
        let mut bz_p = hz;
        let mut nx_p = nx;
        let mut ny_p = ny;
        let mut nz_p = nz;
        let mut bounce_r = 0.0;
        let mut bounce_g = 0.0;
        let mut bounce_b = 0.0;
        let mut bnc = 0usize;
        while bnc < 2 {
            let ph = (px as f32) * 12.9898 + (py as f32) * 78.233 + (bnc as f32) * 17.13 + jx;
            let r1 = ph.sin() * 0.5 + 0.5;
            let r2 = ((px as f32) * 26.716 + (py as f32) * 41.329 + (bnc as f32) * 9.71 + jy).sin() * 0.5 + 0.5;
            let phi = 6.283185307179586 * r1;
            let rr2 = r2.sqrt();
            let lx = rr2 * phi.cos();
            let ly = rr2 * phi.sin();
            let lz = (1.0 - r2).max(0.0).sqrt();
            let up_sel = ((0.999 - ny_p.abs()) * big).min(1.0).max(0.0);
            let upx = 1.0 - up_sel;
            let upy = up_sel;
            let t1x = upy * nz_p;
            let t1y = 0.0 - upx * nz_p;
            let t1z = upx * ny_p - upy * nx_p;
            let t1l = (t1x * t1x + t1y * t1y + t1z * t1z).sqrt().max(tiny);
            let tx = t1x / t1l;
            let ty = t1y / t1l;
            let tz = t1z / t1l;
            let bxx = ny_p * tz - nz_p * ty;
            let bxy = nz_p * tx - nx_p * tz;
            let bxz = nx_p * ty - ny_p * tx;
            let ndx2 = tx * lx + bxx * ly + nx_p * lz;
            let ndy2 = ty * lx + bxy * ly + ny_p * lz;
            let ndz2 = tz * lx + bxz * ly + nz_p * lz;
            let ndl = (ndx2 * ndx2 + ndy2 * ndy2 + ndz2 * ndz2).sqrt().max(tiny);
            let sdx = ndx2 / ndl;
            let sdy = ndy2 / ndl;
            let sdz = ndz2 / ndl;
            let ox = bx_p + sdx * ray_eps;
            let oy = by_p + sdy * ray_eps;
            let oz = bz_p + sdz * ray_eps;
            let mut rq2 = ray_query_initialize(tlas, (ox, oy, oz), 0.0, (sdx, sdy, sdz), ray_tmax);
            while rq2.proceed() {
            }
            let mut hit2 = 0.0;
            let mut th2 = 0.0;
            let mut prim2 = 0u32;
            if rq2.has_committed() {
                th2 = rq2.committed_t();
                prim2 = rq2.committed_primitive_index();
                hit2 = 1.0;
            } else {
                hit2 = 0.0;
                th2 = 0.0;
                prim2 = 0u32;
            }
            let tb2 = (prim2 as usize) * 9;
            let ax2 = tris[tb2];
            let ay2 = tris[tb2 + 1];
            let az2 = tris[tb2 + 2];
            let e1x2 = tris[tb2 + 3] - ax2;
            let e1y2 = tris[tb2 + 4] - ay2;
            let e1z2 = tris[tb2 + 5] - az2;
            let e2x2 = tris[tb2 + 6] - ax2;
            let e2y2 = tris[tb2 + 7] - ay2;
            let e2z2 = tris[tb2 + 8] - az2;
            let ngx2 = e1y2 * e2z2 - e1z2 * e2y2;
            let ngy2 = e1z2 * e2x2 - e1x2 * e2z2;
            let ngz2 = e1x2 * e2y2 - e1y2 * e2x2;
            let nl2 = (ngx2 * ngx2 + ngy2 * ngy2 + ngz2 * ngz2).sqrt();
            let gate_nl2 = (nl2 * big).min(1.0).max(0.0);
            let nl2s = nl2 + (1.0 - gate_nl2);
            let inv_nl2 = 1.0 / nl2s;
            let hgx2 = gate_nl2 * (ngx2 * inv_nl2);
            let hgy2 = gate_nl2 * (ngy2 * inv_nl2);
            let hgz2 = gate_nl2 * (ngz2 * inv_nl2);
            let fac2 = hgx2 * sdx + hgy2 * sdy + hgz2 * sdz;
            let flip2 = 1.0 - 2.0 * (fac2 * big).min(1.0).max(0.0);
            let nx2 = flip2 * hgx2;
            let ny2 = flip2 * hgy2;
            let nz2 = flip2 * hgz2;
            let hx2 = ox + sdx * th2;
            let hy2 = oy + sdy * th2;
            let hz2 = oz + sdz * th2;
            let mb2 = (prim2 as usize) * 8;
            let al2_r = mats[mb2];
            let al2_g = mats[mb2 + 1];
            let al2_b = mats[mb2 + 2];
            let em2_r = mats[mb2 + 3];
            let em2_g = mats[mb2 + 4];
            let em2_b = mats[mb2 + 5];
            let mut nee_r = 0.0;
            let mut nee_g = 0.0;
            let mut nee_b = 0.0;
            let mut qi2 = 0usize;
            while qi2 < quad_count {
                let qb = qi2 * 16;
                let qp_x = quads[qb];
                let qp_y = quads[qb + 1];
                let qp_z = quads[qb + 2];
                let qe1_x = quads[qb + 3];
                let qe1_y = quads[qb + 4];
                let qe1_z = quads[qb + 5];
                let qe2_x = quads[qb + 6];
                let qe2_y = quads[qb + 7];
                let qe2_z = quads[qb + 8];
                let qle_r = quads[qb + 9];
                let qle_g = quads[qb + 10];
                let qle_b = quads[qb + 11];
                let sample_area = quads[qb + 12] * 0.0625;
                let qn_x = quads[qb + 13];
                let qn_y = quads[qb + 14];
                let qn_z = quads[qb + 15];
                let mut syq = 0usize;
                while syq < 4 {
                    let mut sxq = 0usize;
                    while sxq < 4 {
                        let u = (sxq as f32 + 0.5) * 0.25;
                        let v = (syq as f32 + 0.5) * 0.25;
                        let lp_x = qp_x + u * qe1_x + v * qe2_x;
                        let lp_y = qp_y + u * qe1_y + v * qe2_y;
                        let lp_z = qp_z + u * qe1_z + v * qe2_z;
                        let lv_x = lp_x - hx2;
                        let lv_y = lp_y - hy2;
                        let lv_z = lp_z - hz2;
                        let d2 = lv_x * lv_x + lv_y * lv_y + lv_z * lv_z;
                        let gate_d = ((d2 - eps2) * big).min(1.0).max(0.0);
                        let d2s = d2.max(tiny * tiny);
                        let d = d2s.sqrt();
                        let wix = lv_x / d;
                        let wiy = lv_y / d;
                        let wiz = lv_z / d;
                        let cos_s = (nx2 * wix + ny2 * wiy + nz2 * wiz).max(0.0);
                        let gate_cs = (cos_s * big).min(1.0).max(0.0);
                        let cos_l = 0.0 - (qn_x * wix + qn_y * wiy + qn_z * wiz);
                        let gate_cl = (cos_l * big).min(1.0).max(0.0);
                        let t_sh = d - 2.0 * ray_eps;
                        let gate_far = (t_sh * big).min(1.0).max(0.0);
                        let t_fire = t_sh.max(ray_eps);
                        let keep_pre = hit2 * gate_d * gate_cs * gate_cl;
                        let mut blk = 0.0;
                        if keep_pre > 0.0 {
                            let mut sq = ray_query_initialize_first_hit(
                                tlas,
                                (hx2 + wix * ray_eps, hy2 + wiy * ray_eps, hz2 + wiz * ray_eps),
                                0.0,
                                (wix, wiy, wiz),
                                t_fire,
                            );
                            while sq.proceed() {
                            }
                            if sq.has_committed() {
                                blk = 1.0;
                            } else {
                                blk = 0.0;
                            }
                        }
                        let vis = 1.0 - gate_far * blk;
                        let g = (cos_s * cos_l / d2s) * sample_area;
                        let keep = keep_pre * vis;
                        nee_r = nee_r + qle_r * g * keep;
                        nee_g = nee_g + qle_g * g * keep;
                        nee_b = nee_b + qle_b * g * keep;
                        sxq = sxq + 1;
                    }
                    syq = syq + 1;
                }
                qi2 = qi2 + 1;
            }
            let mut pi2 = 0usize;
            while pi2 < point_count {
                let pb = pi2 * 8;
                let lv_x = points[pb] - hx2;
                let lv_y = points[pb + 1] - hy2;
                let lv_z = points[pb + 2] - hz2;
                let li_r = points[pb + 3];
                let li_g = points[pb + 4];
                let li_b = points[pb + 5];
                let d2 = lv_x * lv_x + lv_y * lv_y + lv_z * lv_z;
                let gate_d = ((d2 - eps2) * big).min(1.0).max(0.0);
                let d2s = d2.max(tiny * tiny);
                let d = d2s.sqrt();
                let wix = lv_x / d;
                let wiy = lv_y / d;
                let wiz = lv_z / d;
                let cos_s = (nx2 * wix + ny2 * wiy + nz2 * wiz).max(0.0);
                let gate_cs = (cos_s * big).min(1.0).max(0.0);
                let t_sh = d - 2.0 * ray_eps;
                let gate_far = (t_sh * big).min(1.0).max(0.0);
                let t_fire = t_sh.max(ray_eps);
                let keep_pre = hit2 * gate_d * gate_cs;
                let mut blk = 0.0;
                if keep_pre > 0.0 {
                    let mut sq = ray_query_initialize_first_hit(
                        tlas,
                        (hx2 + wix * ray_eps, hy2 + wiy * ray_eps, hz2 + wiz * ray_eps),
                        0.0,
                        (wix, wiy, wiz),
                        t_fire,
                    );
                    while sq.proceed() {
                    }
                    if sq.has_committed() {
                        blk = 1.0;
                    } else {
                        blk = 0.0;
                    }
                }
                let vis = 1.0 - gate_far * blk;
                let g = cos_s / d2s;
                let keep = keep_pre * vis;
                nee_r = nee_r + li_r * g * keep;
                nee_g = nee_g + li_g * g * keep;
                nee_b = nee_b + li_b * g * keep;
                pi2 = pi2 + 1;
            }
            let lo2_r = (em2_r + al2_r * inv_pi * nee_r).min(16.0);
            let lo2_g = (em2_g + al2_g * inv_pi * nee_g).min(16.0);
            let lo2_b = (em2_b + al2_b * inv_pi * nee_b).min(16.0);
            bounce_r = bounce_r + hit_f * hit2 * thr_r * lo2_r;
            bounce_g = bounce_g + hit_f * hit2 * thr_g * lo2_g;
            bounce_b = bounce_b + hit_f * hit2 * thr_b * lo2_b;
            thr_r = thr_r * al2_r;
            thr_g = thr_g * al2_g;
            thr_b = thr_b * al2_b;
            bx_p = hx2;
            by_p = hy2;
            bz_p = hz2;
            nx_p = nx2;
            ny_p = ny2;
            nz_p = nz2;
            bnc = bnc + 1;
        }

        // ── ④ 深度（未抖 vp ZO NDC；|w|≤1e-8 → 1.0 host 同字面）──
        let cz = ((params[25] * hx + params[26] * hy) + params[27] * hz) + params[28];
        let cw = ((params[29] * hx + params[30] * hy) + params[31] * hz) + params[32];
        let cw_abs = cw.max(0.0 - cw);
        let gate_w = ((cw_abs - 0.00000001) * big).min(1.0).max(0.0);
        let cw_safe = cw + (1.0 - gate_w);
        let z_hit = gate_w * (cz / cw_safe) + (1.0 - gate_w);
        // ── 输出（lo = emission + albedo·inv_pi·direct，host 同序左结合）──
        out_color[i * 3] = hit_f * (mats[mb + 3] + al_r * inv_pi * dir_r) + bounce_r;
        out_color[i * 3 + 1] = hit_f * (mats[mb + 4] + al_g * inv_pi * dir_g) + bounce_g;
        out_color[i * 3 + 2] = hit_f * (mats[mb + 5] + al_b * inv_pi * dir_b) + bounce_b;
        out_depth[i] = hit_f * z_hit + (1.0 - hit_f);
    }
}
