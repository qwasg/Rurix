//@ spec: RXS-0405 L3 device 面（G37 W3 hzb_skin——HZB×蒙皮同车道合并面主射线腿）
// G37 W3 统一 primary 蒙皮变体 —— `kernels/g34_unified_primary.rx`（母版：
// G34-2 HZB 主射线腿）**全字面继承** + 一件加性扩面（门 `g37.wave3.hzb_skin`；
// G36 留窗字面「HZB×蒙皮同车道 = 新 kernel 合并面」的 kernel 件）。母版
// 0-byte 不触——本 kernel 为合并车道独消费变体（--hzb on --skin 同开面）。
//
// ## 扩面：命中信息通道 out_hit（g34_unified_gi_skin 扩面①逐字同格式）
// out_hit 4 f32/px = [inst, prim, bary_u, bary_v]（miss = inst −1 哨兵，
// hit_f·(inst+1)−1 位级门无分支；prim = BLAS 内图元下标——蒙皮角色 BLAS
// 独占角色三角 ⇒ prim 即角色局部下标，kernels/g34_unified_mv.rx in_prev
// 顶点基 = prim·3 逐字消费面）——蒙皮 MV kernel 的逐像素类属/图元/重心源 +
// host 侧 inst==char_inst 地面真值检测面。合并车道实例分解 = [静态逐节点
// BLAS 0..N-1 | 动态立方体 N | 蒙皮角色 N+1]，char_inst/dyn_inst 经 MV
// 参数面下发（kernel 零硬编码实例号——gi_skin params[44] 同律参数化）。
//
// ## 语义（除上述扩面外与 kernels/g34_unified_primary.rx 逐字同式）
// 逐像素 jitter 主射线对**初剔后 TLAS**（表 0；被剔实例 mask=0x00 ⇒ 主射线
// 零遍历其 BLAS——剔除消费点）做最近命中 ray query，写 hitinfo（t + 全局
// 三角形下标 pg + 重心 bu/bv + **[inst,prim,bu,bv] 四元组**）供
// g34_unified_shade / g34_unified_mv 消费。pg = prim + inst_base[inst]
// （inst_base = 逐节点段前缀和 + 动态槽 dyn_tri_base + **角色槽
// char_tri_base**——host 装配期预算，< 2^24 f32 精确域）。角色段 = 当帧
// 蒙皮世界空间三角形（g31_skin pass 同帧先行重写 tris SSBO 角色段 +
// blas_refit 双桥 UPDATE 表 0/表 1 角色 BLAS 副本；实例变换恒 identity）。
// 阴影射线不在本 pass（shade 走全量 TLAS 表 1——被剔实例仍投阴影；
// RXS-0297 单 TLAS 签名纪律 ⇒ 双 TLAS 分工拆 pass）。
// miss：t=0 / pg=0 / bary=(0,0) / out_hit=[−1,0,0,0]（t=0 恒 miss 语义 =
// 母版逐字；shade 侧 hit_f = (t>0) 门重建同律；MV 侧 inst=−1 哨兵不匹配
// 任何实例号 ⇒ 相机臂）。
//
// ## 确定性协议（RXS-0357 L2 同律继承）
// 逐像素独立顺序求值，禁 atomic；输出直写无跨像素交互；固定输入双跑位级
// 一致。全 f32；分支判定 min/max 算术门白名单形（big=1e30 门放大器）+
// has_committed 短 selection 臂 + hit_f·(inst+1)−1 哨兵位级门。
//
// ## 参数面（host bin `g34_full_lane` hzb_skin 合并区段逐字同源）
//   params: 60 f32 与 kernels/g34_unified_gi.rx 参数面逐字同布局（本 pass 仅
//     [1]=width [2]=height [3]=jitter_x [4]=jitter_y [6]=ray_tmax
//     [9..25]=inv_vp 消费——主射线反投影；其余槽位直通不读）。
//   inst_base: 1 f32/实例（该实例全局三角形下标基底 = 逐节点段前缀和 + 动态
//     槽 dyn_tri_base + 角色槽 char_tri_base，host 装配期预算）。
//   out_t: 1 f32/px（committed_t；miss=0）。
//   out_pg: 1 f32/px（pg 全局三角形下标 as f32；miss=0）。
//   out_bary: 2 f32/px（committed_barycentric bu/bv；miss=(0,0)——fork A
//     采样链 shade 侧 UV 插值输入面）。
//   out_hit: 4 f32/px（[inst(−1=miss 哨兵), prim(BLAS 内图元), bary_u,
//     bary_v]——g34_unified_mv in_hit 消费面 + host 地面真值检测面）。
#[numthreads(8, 8, 1)]
kernel fn g34_unified_primary_skin(
    tlas: AccelStruct,
    t: ThreadCtx<2>,
    inst_base: View<global, f32>,
    params: View<global, f32>,
    out_t: ViewMut<global, f32>,
    out_pg: ViewMut<global, f32>,
    out_bary: ViewMut<global, f32>,
    out_hit: ViewMut<global, f32>,
) {
    // 2D 车道索引（8×8 局部组；dispatch = ceil(w/8)×ceil(h/8)×1，母版同一字面）。
    // 越界组不产写——与 1D 形态 `i < pixel_count` 门同覆盖域。
    let px = t.global_id();
    let py = t.global_id_y();
    let width = params[1] as usize;
    let height = params[2] as usize;
    let jx = params[3];
    let jy = params[4];
    let ray_tmax = params[6];
    let big: f32 = 1e30;
    if px < width && py < height {
        let i = py * width + px;
        // ── ① jitter 主射线（母版①段逐字）──
        let sx = (px as f32) + 0.5 + jx;
        let sy = (py as f32) + 0.5 + jy;
        let ndx = 2.0 * (sx / (width as f32)) - 1.0;
        let ndy = 1.0 - 2.0 * (sy / (params[2] as f32));
        let n4x = (params[9] * ndx + params[10] * ndy) + params[12];
        let n4y = (params[13] * ndx + params[14] * ndy) + params[16];
        let n4z = (params[17] * ndx + params[18] * ndy) + params[20];
        let n4w = (params[21] * ndx + params[22] * ndy) + params[24];
        let f4x = ((params[9] * ndx + params[10] * ndy) + params[11]) + params[12];
        let f4y = ((params[13] * ndx + params[14] * ndy) + params[15]) + params[16];
        let f4z = ((params[17] * ndx + params[18] * ndy) + params[19]) + params[20];
        let f4w = ((params[21] * ndx + params[22] * ndy) + params[23]) + params[24];
        let near_x = n4x / n4w;
        let near_y = n4y / n4w;
        let near_z = n4z / n4w;
        let d0x = f4x / f4w - near_x;
        let d0y = f4y / f4w - near_y;
        let d0z = f4z / f4w - near_z;
        let dl = (d0x * d0x + d0y * d0y + d0z * d0z).sqrt();
        let gate_dl = (dl * big).min(1.0).max(0.0);
        let dl_safe = dl + (1.0 - gate_dl);
        let dx = gate_dl * d0x / dl_safe;
        let dy = gate_dl * d0y / dl_safe;
        let dz = gate_dl * d0z / dl_safe;
        // ── ② 主 ray query（最近命中；初剔后 TLAS；closest-hit 语义——禁
        //    first-hit；空体循环 = M96 白名单形）──
        let mut rq = ray_query_initialize(tlas, (near_x, near_y, near_z), 0.0, (dx, dy, dz), ray_tmax);
        while rq.proceed() {
        }
        let mut hit_f = 1.0;
        let mut th = 0.0;
        let mut prim = 0u32;
        let mut inst = 0u32;
        let mut pg = 0usize;
        let mut bu = 0.0;
        let mut bv = 0.0;
        if rq.has_committed() {
            th = rq.committed_t();
            // 实例分派：BLAS 内 prim → 全局三角形下标（inst_base 前缀和表——
            // 母版逐字；角色槽 inst_base = char_tri_base ⇒ 与 gi_skin
            // pg = prim + char_tri_base 字面同值）。
            prim = rq.committed_primitive_index();
            inst = rq.committed_instance_index();
            pg = (prim as usize) + (inst_base[inst as usize] as usize);
            // fork A 重心面（committed 语义;shade 采样链 UV 插值输入）。
            let bary = rq.committed_barycentric();
            bu = bary.0;
            bv = bary.1;
            hit_f = 1.0;
        } else {
            hit_f = 0.0;
            th = 0.0;
            prim = 0u32;
            inst = 0u32;
            pg = 0usize;
            bu = 0.0;
            bv = 0.0;
        }
        out_t[i] = th;
        out_pg[i] = pg as f32;
        out_bary[i * 2] = bu;
        out_bary[i * 2 + 1] = bv;
        // ── 扩面：命中信息通道（miss = inst −1 哨兵;g34_unified_gi_skin
        //    扩面①同字面位级门——MV kernel 类属分派 + host 地面真值检测面）──
        out_hit[i * 4] = hit_f * ((inst as f32) + 1.0) - 1.0;
        out_hit[i * 4 + 1] = (prim as f32) * hit_f;
        out_hit[i * 4 + 2] = bu;
        out_hit[i * 4 + 3] = bv;
    }
}
