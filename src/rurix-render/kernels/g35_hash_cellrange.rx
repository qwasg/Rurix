//@ spec: RFC-0049 §4.10(G35-7 流体空间哈希阶段 3;spec 条款号本期零新设)
// G35-7 流体 · hash_cellrange —— 排序键流 cell 区间边界检测(门
// g35.wave7.fluids;src/particles/fluid.rs 契约头字面)。
//
// ## 架构(确定性协议:单写者 = 确定,零原子)
// 公式面与 host 金标准 `particles/fluid.rs::hash_cellrange` **逐字同源**:
// 逐 sorted 位置 i(W1 sort 3-pass 稳定排序产物,消费不修改):
//   i == 0 ∨ keys[i] ≠ keys[i−1] ⇒ cell_start[keys[i]] = i;
//   i == n−1 ∨ keys[i] ≠ keys[i+1] ⇒ cell_end[keys[i]] = i+1。
// 每 cell 的 start/end 各恰一个写者(排序后同键连续 ⇒ 边界唯一)⇒ 与线程
// 调度无关;未触 cell 保持 g35_hash_clear.rx 清扫哨兵(start=0xFFFFFFFF,
// end=0)= 空区间循环零次直落。纯 u32/usize 整数面 ⇒ device↔host 零容差
// 位级(mod.rs 整数域协议;键域 < 262144 由 g35_hash_cellkey.rx 构造保证)。
//
// ## 参数面(4 f32;n ≤ 2^24 f32 精确;声明序 = 绑定序,SSBO 数 = 4)
//   params[0]=n [1..4)=reserved(恒 0)。
//   SSBO 序:0 params(View f32×4) / 1 sorted_keys(View u32×n) /
//   2 cell_start(ViewMut u32×ncell) / 3 cell_end(ViewMut u32×ncell)。
//   dispatch = [n, 1, 1](LocalSize 1,1,1 一 sorted 位置一 invocation)。
#[numthreads(1, 1, 1)]
kernel fn g35_hash_cellrange(
    tc: ThreadCtx<1>,
    params: View<global, f32>,
    sorted_keys: View<global, u32>,
    cell_start: ViewMut<global, u32>,
    cell_end: ViewMut<global, u32>,
) {
    let i = tc.global_id();
    let n = params[0] as usize;
    if i < n {
        let k = sorted_keys[i] as usize;
        if i == 0usize {
            cell_start[k] = i as u32;
        } else {
            if sorted_keys[i] != sorted_keys[i - 1usize] {
                cell_start[k] = i as u32;
            }
        }
        if i == n - 1usize {
            cell_end[k] = (i + 1usize) as u32;
        } else {
            if sorted_keys[i] != sorted_keys[i + 1usize] {
                cell_end[k] = (i + 1usize) as u32;
            }
        }
    }
}
