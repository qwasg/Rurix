//@ spec: RXS-0404
// G14plus G14.9 TSR kernel 调度变体 —— 重采样腿（RFC-0030 §4.5 L1 授权行；
// G14_CONTRACT §4.2 M-c 行「TSR device kernel 效率面」判据字面兑现对象；
// G14PLUS_RECORD §3 优化清单 #2）。
//
// ## 变体身份（与 g13_tsr_resample.rx 的关系）
// 本文件 = `g13_tsr_resample.rx` 的**调度面变体**：`ThreadCtx<1>` 无
// numthreads（LocalSize 1,1,1 × dispatch [n,1,1]——百万工作组×1 线程调度
// 灾难，bistro TSR upscale 实测 ~120ms 三档锁死）→ `#[numthreads(8, 8, 1)]`
// 2D 线程组 + 越界门。**逐像素数学全式逐字不变**（Catmull-Rom 重采样/抗振铃
// 钳/深度最近邻/YCoCg 亮度全部与原 kernel 同式同序）；逐像素独立无跨像素
// 交互 → 调度重排位级不变（digest 机核 = 变体输出 == 原 kernel 输出，同输入
// 同 seed）。原 `g13_tsr_resample.rx` 逐字节 0-byte 保留（G13 M-b 门消费面
// 维持 + RD-045 归因对照臂——「TSR 车道零触碰」对照可回溯）。
// host 调用面：dispatch = [ceil(ow/8), ceil(oh/8), 1]（原 [ow*oh,1,1]）。
//
// ## 重采样公式面/确定性协议/参数面
// 与 g13_tsr_resample.rx 文件头 §重采样公式面/§确定性协议/§参数面逐字同源
// （params 32 f32 布局不变；in_color/in_depth/cur_rgb/cur_luma/depth_hi
// 缓冲布局不变）——本文件不复述，唯一差异 = 线程组形态与索引推导：
// i = py·ow + px（px<ow ∧ py<oh 越界门，与 1D 形态 i<pixel_count 同覆盖域，
// pixel_count = ow·oh 恒成立于本车道）。
#[numthreads(8, 8, 1)]
kernel fn g14_8_tsr_resample(
    t: ThreadCtx<2>,
    in_color: View<global, f32>,
    in_depth: View<global, f32>,
    params: View<global, f32>,
    cur_rgb: ViewMut<global, f32>,
    cur_luma: ViewMut<global, f32>,
    depth_hi: ViewMut<global, f32>,
) {
    let px_id = t.global_id();
    let py_id = t.global_id_y();
    let pixel_count = params[0] as usize;
    let ow = params[1] as usize;
    let iw = params[3] as usize;
    let ih = params[4] as usize;
    let jx = params[5];
    let jy = params[6];
    let exposure = params[7];
    let big: f32 = 1e30;
    let oh = pixel_count / ow;
    if px_id < ow && py_id < oh {
        let i = py_id * ow + px_id;
        let ox = i % ow;
        let oy = i / ow;
        let wf = ow as f32;
        let hf = (pixel_count / ow) as f32;
        let iwf = iw as f32;
        let ihf = ih as f32;
        // 核参缩放(host kernel_scale 同式:>1 比例 ×0.75;1:1 保持单位核)。
        let ratio_x = wf / iwf;
        let ratio_y = hf / ihf;
        let gate_x = ((ratio_x - 1.0) * big).min(1.0).max(0.0);
        let gate_y = ((ratio_y - 1.0) * big).min(1.0).max(0.0);
        let rx = 1.0 + gate_x * (ratio_x * 0.75 - 1.0);
        let ry = 1.0 + gate_y * (ratio_y * 0.75 - 1.0);
        // 输出像素中心 → 输入纹素空间;jitter 对齐(绕 px−j 的 4×4 窗)。
        let sx = iwf / wf;
        let sy = ihf / hf;
        let px = ((ox as f32) + 0.5) * sx - 0.5;
        let py = ((oy as f32) + 0.5) * sy - 0.5;
        let gx = px - jx;
        let gy = py - jy;
        let bxf = gx.floor();
        let byf = gy.floor();
        let iwm1 = iwf - 1.0;
        let ihm1 = ihf - 1.0;
        let mut acc0 = 0.0;
        let mut acc1 = 0.0;
        let mut acc2 = 0.0;
        let mut wsum = 0.0;
        let mut mn0: f32 = 1e30;
        let mut mn1: f32 = 1e30;
        let mut mn2: f32 = 1e30;
        let mut mx0: f32 = 0.0 - 1e30;
        let mut mx1: f32 = 0.0 - 1e30;
        let mut mx2: f32 = 0.0 - 1e30;
        let mut dyi = 0usize;
        while dyi < 4 {
            let dyf = (dyi as f32) - 1.0;
            let tyf = (byf + dyf).min(ihm1).max(0.0);
            let ty = tyf as usize;
            // Catmull-Rom y 向(三分段算术门;a=|t|)。
            let ay = ((gy - (byf + dyf)) * ry).abs();
            let le1y = ((1.0 - ay) * big).min(1.0).max(0.0);
            let lt2y = ((2.0 - ay) * big).min(1.0).max(0.0);
            let p1y = 1.5 * ay * ay * ay - 2.5 * ay * ay + 1.0;
            let p2y = (0.0 - 0.5) * ay * ay * ay + 2.5 * ay * ay - 4.0 * ay + 2.0;
            let wy = le1y * p1y + (lt2y - le1y) * p2y;
            let mut dxi = 0usize;
            while dxi < 4 {
                let dxf = (dxi as f32) - 1.0;
                let txf = (bxf + dxf).min(iwm1).max(0.0);
                let tx = txf as usize;
                let ax = ((gx - (bxf + dxf)) * rx).abs();
                let le1x = ((1.0 - ax) * big).min(1.0).max(0.0);
                let lt2x = ((2.0 - ax) * big).min(1.0).max(0.0);
                let p1x = 1.5 * ax * ax * ax - 2.5 * ax * ax + 1.0;
                let p2x = (0.0 - 0.5) * ax * ax * ax + 2.5 * ax * ax - 4.0 * ax + 2.0;
                let wx = le1x * p1x + (lt2x - le1x) * p2x;
                let w = wx * wy;
                let ti = (ty * iw + tx) * 3;
                let c0 = in_color[ti];
                let c1 = in_color[ti + 1];
                let c2 = in_color[ti + 2];
                acc0 = acc0 + w * c0;
                acc1 = acc1 + w * c1;
                acc2 = acc2 + w * c2;
                mn0 = mn0.min(c0);
                mx0 = mx0.max(c0);
                mn1 = mn1.min(c1);
                mx1 = mx1.max(c1);
                mn2 = mn2.min(c2);
                mx2 = mx2.max(c2);
                wsum = wsum + w;
                dxi = dxi + 1;
            }
            dyi = dyi + 1;
        }
        // 抗振铃钳入采集邻域色域后 × exposure 转显示域(host 同序)。
        let v0 = (acc0 / wsum).min(mx0).max(mn0);
        let v1 = (acc1 / wsum).min(mx1).max(mn1);
        let v2 = (acc2 / wsum).min(mx2).max(mn2);
        let o0 = (v0 * exposure).max(0.0);
        let o1 = (v1 * exposure).max(0.0);
        let o2 = (v2 * exposure).max(0.0);
        cur_rgb[i * 3] = o0;
        cur_rgb[i * 3 + 1] = o1;
        cur_rgb[i * 3 + 2] = o2;
        // 亮度(YCoCg Y,显示域;host luma_image 同式)。
        cur_luma[i] = 0.25 * o0 + 0.5 * o1 + 0.25 * o2;
        // 深度最近邻上采样(host upsample_nearest/sample_nearest 同式)。
        let nx = ((((ox as f32) + 0.5) / wf) * iwf).floor().min(iwm1).max(0.0) as usize;
        let ny = ((((oy as f32) + 0.5) / hf) * ihf).floor().min(ihm1).max(0.0) as usize;
        depth_hi[i] = in_depth[ny * iw + nx];
    }
}
