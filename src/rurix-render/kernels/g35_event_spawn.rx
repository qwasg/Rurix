//@ spec: RFC-0049 §4.9(G35-6 事件/数据通道 event_spawn;spec 条款号本期
// 零新设)
// G35-6 事件通道 · 双源合并事件发射 —— host 事件队列 + GPU 死亡事件缓冲
// (上一帧 g35_event_collect 产)零回读合并发射(门 g35.wave6.events;
// G35_CONTRACT §4 契约,src/particles/events.rs 冻结协议头字面)。
//
// ## 架构(确定性协议;G35-6 帧序第 5 步)
// 公式面与 host 金标准 `particles/events.rs::event_spawn_step` **逐字
// 同源**。零回读要件(反打 Niagara GPU↔CPU 互读约束):
//   alive = seg_offsets[alive_slot](W2 alive scan 总和槽 device 直读);
//   gpu_n = min(gpu_count[0], EVENT_CAP)(上帧 collect 计数 SSBO 直读;
//   min 为防御钳制,collect 契约保证 gpu_count[0] ≤ EVENT_CAP 时不触发);
//   budget = cap − alive − scripted(host 脚本不变量 alive+scripted ≤ cap,
//   下溢守卫 if);accepted = min(host_n + gpu_n, budget)(发射上限与
//   core emit 同律);host 不读回任何 device 计数,dispatch 为保守上界。
// **双源次序冻结:host 事件先(j < host_n)、GPU 死亡事件后**(预算压力
// 下 host 优先占额);槽位 = alive + scripted + j(scan 推导基址,禁原子
// 抢槽);pid = pid_base_events + j(pid_base 三段涵盖:脚本发射/host
// 事件/GPU 死亡事件,host u32 递增维护)。
// 发射公式(随机带单源纪律,G28 RFC-0045 §1.2 同律;槽位表与 g35_emit
// 同:0/1/2 = pos xyz,3/4/5 = vel xyz,6 = life):
//   r_k = rand_table[(pid·7919 + k) % 65536];
//   pos = payload[0..3) + (r_{0..2}·2−1)·spread;
//   vel_x/y = payload[3..5) + (r_{3..4}·2−1)·vel_spread;
//   vel_z = (r5·2−1)·vel_spread(payload 布局冻结:vel_z 不入载荷,基值
//   0);age = 0;life = life_base·(0.5 + 0.5·r6);pid 流 = pid。
// 线程 j==0 写 spawn_counts {[0]=accepted [1]=host_accepted
// [2]=gpu_accepted [3]=0}(零回读见证槽,host 平行金标准对拍面);
// 线程 j < accepted 另写 src_meta[j·3..j·3+3) = 被消费事件 meta 原值
// (双源合并次序的 device 见证,u32 零容差位级)。
// 无 shared / 无原子 / 无超越函数 / 无位运算(usize 乘加回绕 mod 2^32
// 不改 mod 65536 值,g35_emit 同注)。pid/src_meta/spawn_counts 为 u32
// 整数流零容差位级;pos/vel/life f32 流走标定容差(probe 装载期注入
// NoContraction 禁驱动 FMA 收缩,g35_emit 同律)。
//
// ## 参数面(16 f32;⚠pid_base_events 走 f32 参数面,精确域
// pid_base_events + accepted < 2^24(host event_spawn_step assert 同断言);
// 声明序 = 绑定序,SSBO 数 = 19,与 host 金标准 / probe 下标严格一致)
//   params[0]=host_count(队列 trim 后计数 ≤ 1024) [1]=scripted_emit
//   [2]=pid_base_events(= pid_base + scripted_emit) [3]=alive_slot
//   (= nseg_curr,seg_offsets 总和槽下标) [4]=cap(池容量)
//   [5]=spread [6]=vel_spread [7]=life_base [8]=event_cap(=1024 冻结)
//   [9..16)=reserved(恒 0)。
//   SSBO 序:0 params(View f32×16) / 1 seg_offsets(View u32×(nseg+1),
//   W2 alive scan spine) / 2 gpu_count(View u32×2,上帧 collect 产) /
//   3 host_meta(View u32×3·1024,整队列上传) / 4 host_payload(View
//   f32×5·1024) / 5 gpu_meta(View u32×3·1024,上帧 collect 产) /
//   6 gpu_payload(View f32×5·1024) / 7 rand_table(View f32×65536) /
//   8..17) B 组 9 流 ViewMut(8 b_pos_x / 9 b_pos_y / 10 b_pos_z /
//   11 b_vel_x / 12 b_vel_y / 13 b_vel_z / 14 b_age / 15 b_life(f32×cap)
//   / 16 b_pid(u32×cap)) / 17 src_meta(ViewMut u32×3·2048,消费见证)
//   / 18 spawn_counts(ViewMut u32×4)。
//   dispatch = [2048, 1, 1](= 2·EVENT_CAP 保守上界冻结——host 不读回
//   gpu_n 故不知精确 accepted,越界线程守卫直落;LocalSize 1,1,1)。
#[numthreads(1, 1, 1)]
kernel fn g35_event_spawn(
    tc: ThreadCtx<1>,
    params: View<global, f32>,
    seg_offsets: View<global, u32>,
    gpu_count: View<global, u32>,
    host_meta: View<global, u32>,
    host_payload: View<global, f32>,
    gpu_meta: View<global, u32>,
    gpu_payload: View<global, f32>,
    rand_table: View<global, f32>,
    b_pos_x: ViewMut<global, f32>,
    b_pos_y: ViewMut<global, f32>,
    b_pos_z: ViewMut<global, f32>,
    b_vel_x: ViewMut<global, f32>,
    b_vel_y: ViewMut<global, f32>,
    b_vel_z: ViewMut<global, f32>,
    b_age: ViewMut<global, f32>,
    b_life: ViewMut<global, f32>,
    b_pid: ViewMut<global, u32>,
    src_meta: ViewMut<global, u32>,
    spawn_counts: ViewMut<global, u32>,
) {
    let j = tc.global_id();
    let host_n = params[0] as usize;
    let scripted = params[1] as usize;
    let alive_slot = params[3] as usize;
    let cap = params[4] as usize;
    let cap_ev = params[8] as usize;
    let alive = seg_offsets[alive_slot] as usize;
    let mut gpu_n = gpu_count[0] as usize;
    if gpu_n > cap_ev {
        gpu_n = cap_ev;
    }
    let used = alive + scripted;
    let mut budget = 0usize;
    if used < cap {
        budget = cap - used;
    }
    let mut accepted = host_n + gpu_n;
    if accepted > budget {
        accepted = budget;
    }
    if j < accepted {
        let slot = used + j;
        let pid = params[2] as usize + j;
        let mut m0 = 0u32;
        let mut m1 = 0u32;
        let mut m2 = 0u32;
        let mut p0 = 0.0;
        let mut p1 = 0.0;
        let mut p2 = 0.0;
        let mut p3 = 0.0;
        let mut p4 = 0.0;
        if j < host_n {
            // 双源次序冻结:host 事件先。
            m0 = host_meta[j * 3usize];
            m1 = host_meta[j * 3usize + 1usize];
            m2 = host_meta[j * 3usize + 2usize];
            p0 = host_payload[j * 5usize];
            p1 = host_payload[j * 5usize + 1usize];
            p2 = host_payload[j * 5usize + 2usize];
            p3 = host_payload[j * 5usize + 3usize];
            p4 = host_payload[j * 5usize + 4usize];
        } else {
            // GPU 死亡事件后(上一帧 collect 产)。
            let k = j - host_n;
            m0 = gpu_meta[k * 3usize];
            m1 = gpu_meta[k * 3usize + 1usize];
            m2 = gpu_meta[k * 3usize + 2usize];
            p0 = gpu_payload[k * 5usize];
            p1 = gpu_payload[k * 5usize + 1usize];
            p2 = gpu_payload[k * 5usize + 2usize];
            p3 = gpu_payload[k * 5usize + 3usize];
            p4 = gpu_payload[k * 5usize + 4usize];
        }
        src_meta[j * 3usize] = m0;
        src_meta[j * 3usize + 1usize] = m1;
        src_meta[j * 3usize + 2usize] = m2;
        // 随机带消费律(host event_spawn_step 同式;槽位表 0..6)。
        let r0 = rand_table[(pid * 7919usize + 0usize) % 65536usize];
        let r1 = rand_table[(pid * 7919usize + 1usize) % 65536usize];
        let r2 = rand_table[(pid * 7919usize + 2usize) % 65536usize];
        let r3 = rand_table[(pid * 7919usize + 3usize) % 65536usize];
        let r4 = rand_table[(pid * 7919usize + 4usize) % 65536usize];
        let r5 = rand_table[(pid * 7919usize + 5usize) % 65536usize];
        let r6 = rand_table[(pid * 7919usize + 6usize) % 65536usize];
        b_pos_x[slot] = p0 + (r0 * 2.0 - 1.0) * params[5];
        b_pos_y[slot] = p1 + (r1 * 2.0 - 1.0) * params[5];
        b_pos_z[slot] = p2 + (r2 * 2.0 - 1.0) * params[5];
        b_vel_x[slot] = p3 + (r3 * 2.0 - 1.0) * params[6];
        b_vel_y[slot] = p4 + (r4 * 2.0 - 1.0) * params[6];
        b_vel_z[slot] = (r5 * 2.0 - 1.0) * params[6];
        b_age[slot] = 0.0;
        b_life[slot] = params[7] * (0.5 + 0.5 * r6);
        b_pid[slot] = pid as u32;
    }
    if j < 1usize {
        // 零回读见证槽(host 平行金标准对拍面)。
        let mut ha = host_n;
        if ha > accepted {
            ha = accepted;
        }
        let ga = accepted - ha;
        spawn_counts[0] = accepted as u32;
        spawn_counts[1] = ha as u32;
        spawn_counts[2] = ga as u32;
        spawn_counts[3] = 0u32;
    }
}
