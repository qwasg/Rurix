//@ spec: RXS-0404
// day_0828 Phase D —— TSR 降噪质量档 resolve 变体（--tsr-quality on 独载腿）。
//
// ## 变体身份（与 g14_8_tsr_resolve.rx 母版的关系）
// 本文件 = `g14_8_tsr_resolve.rx` 的**质量面 fork**（母版 0-byte 冻结,off 臂
// 恒载冻结 SPV 字节——C 相纪律修订:保锚一律字节隔离,本 kernel 仅 --tsr-quality
// on 换载,故 kernel 内无恒等性负担,直接写干净实现）。调度形态（32×4 2D 线程
// 组 + 越界门）/闪烁时域分析/MV 上采样/历史重投影/深度验证/reactive 双通道/
// YCoCg AABB 裁剪/RED 注入位全部与母版同式同序,三处质量面加改:
//
// 1. **色调域混合（Karis 反亮度加权）**:blend 前对 current/history 各取
//    w = 1/(1+Y)（YCoCg 的 Y 即 luma）,有效 alpha' = α·w_c/(α·w_c+(1−α)·w_h)
//    ——HDR 尖峰（emissive 亚像素弹出 ×16 曝光域）对 EMA 的注入被反亮度压缩;
//    实测注:压制幅度随尖峰绝对亮度,Y≪1 的暗域颗粒面几乎不动（首版 v1 指标
//    证据 d_metrics.json——Karis 单独对墙面 p95 变化 ~0%）;代价 = 收敛值对
//    HDR 尖峰均值有偏（偏暗）,如实登记。
// 2. **稳态 alpha 档（params[19],v2 语义修正）**:母版公式
//    α = base_alpha·(1−tighten·score) 下限 min_alpha,以默认档
//    base=0.1/tighten=0.5 得 α ∈ [0.05,0.1]——**min_alpha=0.04 地板构造性
//    不可达**（夜巡实测驻态残差 0.23·σ = √(0.1/1.9) 即 α 恒 = base 旁证;
//    v1「地板 0.04→0.02」位级有差但指标零效,红修记录在 d_metrics.json v1）。
//    v2:params[19] 直接替换公式中的 base_alpha（稳态 EMA 档,闪烁收紧仍可
//    向下调制,自然下限 = [19]·(1−tighten)）,静态驻态残差 ∝ √(α/(2−α)) 按
//    档位真实兑现（0.1→0.04 预测 −38%/→0.02 预测 −56%）;响应变慢为代价,
//    dolly 拖影面验收另测定档。
// 3. **可选邻域亮度 clamp**（params[20]=K,0=关）:当前帧 3×3 邻域（除中心,
//    边界 clamp 复制致角点自含）luma max×K 截断新样本（RGB 等比缩放保色相）
//    ——进一步压孤立萤火虫;K 过小会杀合法孤立小灯（远处灯具亚像素）,默认 0。
// 4. **深度验证 3×3 膨胀区间化（v3,红修二——攻深度边缘像素恒拒史）**:母版
//    逐点判据 |dc−dp| ≤ tol·max 在深度边缘像素下随 jitter 逐帧拒史（重投影
//    用带 jitter 矩阵,采样点漂移 ±~1px ⇒ 边缘处 dp 跨侧跳变——拱下/桌下/
//    地板 ROI p95 尾像素 99% 走 passthrough,alpha 档零效,诊断在
//    d_metrics_v1_red.json + 会话记录）。v3:接受条件改为 dp ∈
//    [3×3 邻域 depth min − slack, max + slack]（slack = tol·max(dc,dp),
//    区间自然涵盖逐点判据;真 disocclusion 的 dp 落局部区间外仍拒）;色彩面
//    仍受 YCoCg 邻域 AABB 钳制,拖影约束不放松——dolly 面验收另测。
//
// ## 参数面（tsr_params 32 f32,资源 9;[0..19) 与母版逐字同布局）
// [19] = tsrq alpha 稳态档（host 仅 tsrq on 车道填;母版 [9]/[10] 本 kernel 不读）
// [20] = tsrq_clamp K（0=邻域 clamp 关;>0 = 截断系数）
// [21..32) 维持 reserved 零。
//
// ## 确定性
// 全部加改为逐像素纯 ALU（无新 ray query/超越函数/跨像素交互）,branchless
// gate 风格（rurixc「if 包 while/深嵌套 if」codegen 缺陷绕行,A1 同律）;
// 双跑位级一致口径与母版同。
#[numthreads(32, 4, 1)]
kernel fn g31_tsr_resolve_q(
    t: ThreadCtx<2>,
    cur_rgb: View<global, f32>,
    cur_luma: View<global, f32>,
    depth_hi: View<global, f32>,
    in_mv: View<global, f32>,
    in_reactive: View<global, f32>,
    hist_color: View<global, f32>,
    hist_depth: View<global, f32>,
    prev_luma: View<global, f32>,
    prev_sign: View<global, f32>,
    prev_score: View<global, f32>,
    params: View<global, f32>,
    out_color: ViewMut<global, f32>,
    out_sign: ViewMut<global, f32>,
    out_score: ViewMut<global, f32>,
) {
    let px_id = t.global_id();
    let py_id = t.global_id_y();
    let pixel_count = params[0] as usize;
    let ow = params[1] as usize;
    let iw = params[3] as usize;
    let ih = params[4] as usize;
    let has_history = params[8];
    // 质量面②(v2):稳态 alpha 档改读 [19]（tsrq on 车道 host 必填;母版
    // [9]=base_alpha/[10]=min_alpha 本 kernel 均不读——母版地板构造性不可达,
    // 见文件头）。下限 = 档位一半（闪烁收紧 tighten=0.5 的自然极限同值）。
    let alpha_q = params[19];
    let ema_k = params[11];
    let tighten = params[12];
    let dz_abs = params[13];
    let dz_rel = params[14];
    let depth_tol = params[15];
    let has_reactive = params[16];
    let red_bias = params[17];
    let red_passthrough = params[18];
    // 质量面③:邻域亮度 clamp 系数（0 = 关,branchless 门）。
    let clamp_k = params[20];
    let big: f32 = 1e30;
    let tiny: f32 = 0.000001;
    let oh = pixel_count / ow;
    if px_id < ow && py_id < oh {
        let i = py_id * ow + px_id;
        let ox = i % ow;
        let oy = i / ow;
        let wf = ow as f32;
        let hf = (pixel_count / ow) as f32;
        let iwf = iw as f32;
        let ihf = ih as f32;
        let cr = cur_rgb[i * 3];
        let cg = cur_rgb[i * 3 + 1];
        let cb = cur_rgb[i * 3 + 2];
        let mut o_r = cr;
        let mut o_g = cg;
        let mut o_b = cb;
        let mut s_out = 0.0;
        let mut sc_out = 0.0;
        if has_history > 0.5 {
            // ── 闪烁时域分析(帧间亮度差分 → 死区符号 → 翻转 EMA)──
            let lc = cur_luma[i];
            let lp = prev_luma[i];
            let d = lc - lp;
            let dead = dz_abs.max(dz_rel * lc.abs().max(lp.abs()));
            let s_pos = ((d - dead) * big).min(1.0).max(0.0);
            let s_neg = (((0.0 - dead) - d) * big).min(1.0).max(0.0);
            let s = s_pos - s_neg;
            let ps = prev_sign[i];
            let s_nz = (s * s * big).min(1.0).max(0.0);
            let ps_nz = (ps * ps * big).min(1.0).max(0.0);
            let s_ne = ((s - ps) * (s - ps) * big).min(1.0).max(0.0);
            let flip = s_nz * ps_nz * s_ne;
            let score = prev_score[i] * (1.0 - ema_k) + flip * ema_k;
            sc_out = score;
            s_out = s + (1.0 - s_nz) * ps;
            // ── MV 最近邻上采样(host upsample_nearest 同式)──
            let u = ((ox as f32) + 0.5) / wf;
            let v = ((oy as f32) + 0.5) / hf;
            let mx = (u * iwf).floor().min(iwf - 1.0).max(0.0) as usize;
            let my = (v * ihf).floor().min(ihf - 1.0).max(0.0) as usize;
            let su = u + in_mv[(my * iw + mx) * 2];
            let sv = v + in_mv[(my * iw + mx) * 2 + 1];
            // 屏内判(出屏 = disocclusion 拒)。
            let inx = su.min(1.0 - su).min(sv).min(1.0 - sv);
            let inside = (inx * big).min(1.0).max(0.0);
            // ── 历史双线性重投影(output res grid;边界 clamp)──
            let xf = su * wf - 0.5;
            let yf = sv * hf - 0.5;
            let x0f = xf.floor();
            let y0f = yf.floor();
            let fx = xf - x0f;
            let fy = yf - y0f;
            let wm1 = wf - 1.0;
            let hm1 = hf - 1.0;
            let xa = x0f.min(wm1).max(0.0) as usize;
            let xb = (x0f + 1.0).min(wm1).max(0.0) as usize;
            let ya = y0f.min(hm1).max(0.0) as usize;
            let yb = (y0f + 1.0).min(hm1).max(0.0) as usize;
            let i00 = ya * ow + xa;
            let i10 = ya * ow + xb;
            let i01 = yb * ow + xa;
            let i11 = yb * ow + xb;
            let h00 = hist_color[i00 * 3];
            let h10 = hist_color[i10 * 3];
            let h01 = hist_color[i01 * 3];
            let h11 = hist_color[i11 * 3];
            let hr = (h00 * (1.0 - fx) + h10 * fx) * (1.0 - fy)
                + (h01 * (1.0 - fx) + h11 * fx) * fy;
            let g00 = hist_color[i00 * 3 + 1];
            let g10 = hist_color[i10 * 3 + 1];
            let g01 = hist_color[i01 * 3 + 1];
            let g11 = hist_color[i11 * 3 + 1];
            let hg = (g00 * (1.0 - fx) + g10 * fx) * (1.0 - fy)
                + (g01 * (1.0 - fx) + g11 * fx) * fy;
            let b00 = hist_color[i00 * 3 + 2];
            let b10 = hist_color[i10 * 3 + 2];
            let b01 = hist_color[i01 * 3 + 2];
            let b11 = hist_color[i11 * 3 + 2];
            let hb = (b00 * (1.0 - fx) + b10 * fx) * (1.0 - fy)
                + (b01 * (1.0 - fx) + b11 * fx) * fy;
            let d00 = hist_depth[i00];
            let d10 = hist_depth[i10];
            let d01 = hist_depth[i01];
            let d11 = hist_depth[i11];
            let dp = (d00 * (1.0 - fx) + d10 * fx) * (1.0 - fy)
                + (d01 * (1.0 - fx) + d11 * fx) * fy;
            // ── 历史验证(v3):深度 3×3 膨胀区间判据(dmn/dmx 于下方邻域循环
            //    与 YCoCg AABB 同窗收集;dp ∈ [dmn−slack, dmx+slack] 即过——
            //    深度边缘像素不再随 jitter 恒拒史,真 disocclusion 仍拒)──
            let dc = depth_hi[i];
            // ── reactive 双线性上采样(input res;先验软权重)──
            let rxf = u * iwf - 0.5;
            let ryf = v * ihf - 0.5;
            let rx0 = rxf.floor();
            let ry0 = ryf.floor();
            let rfx = rxf - rx0;
            let rfy = ryf - ry0;
            let rwm1 = iwf - 1.0;
            let rhm1 = ihf - 1.0;
            let rxa = rx0.min(rwm1).max(0.0) as usize;
            let rxb = (rx0 + 1.0).min(rwm1).max(0.0) as usize;
            let rya = ry0.min(rhm1).max(0.0) as usize;
            let ryb = (ry0 + 1.0).min(rhm1).max(0.0) as usize;
            let r00 = in_reactive[rya * iw + rxa];
            let r10 = in_reactive[rya * iw + rxb];
            let r01 = in_reactive[ryb * iw + rxa];
            let r11 = in_reactive[ryb * iw + rxb];
            let reactive = has_reactive
                * ((r00 * (1.0 - rfx) + r10 * rfx) * (1.0 - rfy)
                    + (r01 * (1.0 - rfx) + r11 * rfx) * rfy);
            // ── 当前帧 YCoCg 3×3 邻域 AABB(边界复制)+ 质量面③邻域 Y max
            //    (除中心;center mask branchless,边界角点经 clamp 复制自含)──
            let mut mn0: f32 = 1e30;
            let mut mn1: f32 = 1e30;
            let mut mn2: f32 = 1e30;
            let mut mx0: f32 = 0.0 - 1e30;
            let mut mx1: f32 = 0.0 - 1e30;
            let mut mx2: f32 = 0.0 - 1e30;
            let mut nmax: f32 = 0.0 - 1e30;
            // v3:当前帧 3×3 邻域 depth min/max（膨胀区间验证收集面,同窗）。
            let mut dmn_d: f32 = 1e30;
            let mut dmx_d: f32 = 0.0 - 1e30;
            let mut dy = 0usize;
            while dy < 3 {
                let mut dx = 0usize;
                while dx < 3 {
                    let dxf = dx as f32 - 1.0;
                    let dyf = dy as f32 - 1.0;
                    let qxf = ((ox as f32) + dxf).min(wm1).max(0.0);
                    let qyf = ((oy as f32) + dyf).min(hm1).max(0.0);
                    let qi = (qyf as usize) * ow + (qxf as usize);
                    let dq = depth_hi[qi];
                    dmn_d = dmn_d.min(dq);
                    dmx_d = dmx_d.max(dq);
                    let qr = cur_rgb[qi * 3];
                    let qg = cur_rgb[qi * 3 + 1];
                    let qb = cur_rgb[qi * 3 + 2];
                    let y0 = 0.25 * qr + 0.5 * qg + 0.25 * qb;
                    let co0 = 0.5 * qr - 0.5 * qb;
                    let cg0 = 0.0 - 0.25 * qr + 0.5 * qg - 0.25 * qb;
                    mn0 = mn0.min(y0);
                    mx0 = mx0.max(y0);
                    mn1 = mn1.min(co0);
                    mx1 = mx1.max(co0);
                    mn2 = mn2.min(cg0);
                    mx2 = mx2.max(cg0);
                    // center mask:dxf,dyf ∈ {−1,0,1} ⇒ (1−dxf²)(1−dyf²) = 1
                    // 仅中心;中心项被推至 −big 不入 nmax。
                    let cmask = (1.0 - dxf * dxf) * (1.0 - dyf * dyf);
                    nmax = nmax.max(y0 - cmask * big);
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            // ── v3 深度膨胀区间验证收口(dp 落 [dmn−slack, dmx+slack] 即过;
            //    slack = tol·max(dc,dp)——区间涵盖母版逐点判据)──
            let slack = depth_tol * dc.max(dp).max(tiny);
            let ok_hi = ((dmx_d + slack - dp) * big).min(1.0).max(0.0);
            let ok_lo = ((dp - (dmn_d - slack)) * big).min(1.0).max(0.0);
            let depth_ok = ok_hi * ok_lo;
            let valid = inside * depth_ok;
            // ── 历史色 → YCoCg → 闪烁松弛钳入邻域 AABB ──
            let hy = 0.25 * hr + 0.5 * hg + 0.25 * hb;
            let hco = 0.5 * hr - 0.5 * hb;
            let hcg = 0.0 - 0.25 * hr + 0.5 * hg - 0.25 * hb;
            let relax = (score * (1.0 - reactive)).min(1.0).max(0.0);
            let cy = hy.min(mx0).max(mn0) * (1.0 - relax) + hy * relax;
            let cco = hco.min(mx1).max(mn1) * (1.0 - relax) + hco * relax;
            let ccg = hcg.min(mx2).max(mn2) * (1.0 - relax) + hcg * relax;
            // ── alpha 调制(v2:稳态档 = params[19] 直入公式 base 位;闪烁
            //    收紧向下调制,下限 = 档位一半;reactive 优先)──
            let alpha = (alpha_q * (1.0 - tighten * score * (1.0 - reactive)))
                .max(reactive)
                .min(1.0)
                .max(alpha_q * 0.5);
            // ── 质量面③:邻域亮度 clamp 截断新样本(K=0 恒 cscale=1;RGB 等比
            //    缩放保色相;branchless 门)──
            let cy_raw = 0.25 * cr + 0.5 * cg + 0.25 * cb;
            let k_on = (clamp_k * big).min(1.0).max(0.0);
            let limit = clamp_k * nmax.max(0.0);
            let cscale_on = (limit / cy_raw.max(tiny)).min(1.0);
            let cscale = k_on * cscale_on + (1.0 - k_on);
            let c2r = cr * cscale;
            let c2g = cg * cscale;
            let c2b = cb * cscale;
            // 当前帧 YCoCg(clamp 后)。
            let cy0 = 0.25 * c2r + 0.5 * c2g + 0.25 * c2b;
            let cco0 = 0.5 * c2r - 0.5 * c2b;
            let ccg0 = 0.0 - 0.25 * c2r + 0.5 * c2g - 0.25 * c2b;
            // ── 质量面①:Karis 反亮度加权混合(等价 T(x)=x/(1+Y) 色调域 lerp;
            //    α' = α·w_c/(α·w_c+(1−α)·w_h),w = 1/(1+Y);三通道同 α' 保色相)──
            let wc = 1.0 / (1.0 + cy0.max(0.0));
            let wh = 1.0 / (1.0 + cy.max(0.0));
            let aw = alpha * wc;
            let hw = (1.0 - alpha) * wh;
            let a2 = aw / (aw + hw).max(tiny);
            let by = a2 * cy0 + (1.0 - a2) * cy;
            let bco = a2 * cco0 + (1.0 - a2) * cco;
            let bcg = a2 * ccg0 + (1.0 - a2) * ccg;
            let tmp = by - bcg;
            let fr = (tmp + bco).max(0.0);
            let fg = (by + bcg).max(0.0);
            let fb = (tmp - bco).max(0.0);
            // valid 选择(valid=0 取当前帧原值——宁可锯齿回归不拖影;disocclusion
            // 面不施加邻域 clamp,避免新露面孤立亮件被误杀)。
            o_r = valid * fr + (1.0 - valid) * cr;
            o_g = valid * fg + (1.0 - valid) * cg;
            o_b = valid * fb + (1.0 - valid) * cb;
        }
        if red_passthrough > 0.5 {
            // RED 臂:时域累积恒等旁通(冒充已累积)。
            o_r = cr;
            o_g = cg;
            o_b = cb;
        }
        // RED 注入位:输出面加性偏置(device vs host 对拍超容差检出面)。
        o_r = o_r + red_bias;
        o_g = o_g + red_bias;
        o_b = o_b + red_bias;
        out_color[i * 3] = o_r;
        out_color[i * 3 + 1] = o_g;
        out_color[i * 3 + 2] = o_b;
        out_sign[i] = s_out;
        out_score[i] = sc_out;
    }
}
