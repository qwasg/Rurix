// G8.5a M19 VSM 页标记「反投影 + 选级 + 出窗回退」device 核(设计 §2.3 第一行)。
//
// G7 的 `vsm_page_mark.rx` 只做位图 set —— page id 由 host 预计算。本核把
// host oracle `Vsm::page_mark`(vsm.rs L357-411)的**决策计算**整段搬上 device:
//   1. 远平面剔除:`d >= 1.0` → 天空/无表面,不标记;
//   2. NDC:`(2*((x+0.5)/w)-1, 1-2*((y+0.5)/h), d, 1)`;
//   3. `w4 = inv_view_proj * ndc`(行主序 `m[r][k]`,与 `Mat4::transform_vec4` 同序);
//      `|w4.w| < 1e-8` → 跳过(host 同判据);
//   4. `world = w4.xyz / w4.w`;`dc = |world - cam|`;`lp = basis.to_light(world)`;
//   5. `select_level(dc)` = `0 (dc <= R0) | clamp(ceil(log2(dc/R0)), 0, levels-1)`;
//   6. 自 sel 起**逐级向粗级回退**,首个「wp ∈ [wmin, wmin+128)」的级即命中,
//      slot = `wp.rem_euclid(128)`,置该级位图 bit 后 break(host 的 `break`)。
//
// host 的 `mark_stamp`/帧龄刷新是 CPU 侧页缓存账本(设计 §2.1 裁决:决策留 host),
// 本核只产**本帧被标记页位图**;host 消费位图做 hit/miss 分类与 alloc/evict。
//
// **形态纪律**(vsm_sample.rx 同源,实测编码器边界非风格偏好):`while` 体内不放
// intrinsic 调用,`if` 体内只留单链嵌套。故回退环只算出 `(word, bit)` 与 `done`
// 标志,唯一的 `fetch_or` 提到环**外**单 if 内执行 —— 与 host 逐像素首命中级
// 语义逐字等价(host 也只标一级后 break)。
//
// 输入 buffer:`depth` = w*h f32(单通道,主相机深度);
//   `inv_vp` = 16 f32(行主序 `m[0][0..4], m[1][0..4], ...`);
//   `lparams` = 5 f32/级(page_world, window_min.x, window_min.y, zmin, zmax);
//   `page_bits` = levels * 512 u32 原子位图(bit 序 = `l*16384 + y*128 + x`)。
kernel fn vsm_page_mark_project(
    t: ThreadCtx<1>,
    depth: View<global, f32>,
    inv_vp: View<global, f32>,
    lparams: View<global, f32>,
    page_bits: AtomicView<global, u32, (4096,)>,
    pixel_count: usize,
    width: usize,
    levels: usize,
    cam_x: f32,
    cam_y: f32,
    cam_z: f32,
    right_x: f32,
    right_y: f32,
    right_z: f32,
    up_x: f32,
    up_y: f32,
    up_z: f32,
    fwd_x: f32,
    fwd_y: f32,
    fwd_z: f32,
    base_radius: f32,
) {
    let i = t.global_id();
    if i < pixel_count {
        let px = i % width;
        let py = i / width;
        let height = pixel_count / width;
        let d = depth[i];
        // NDC(host 同式;y 轴翻转)
        let ndc_x = 2.0 * ((px as f32 + 0.5) / width as f32) - 1.0;
        let ndc_y = 1.0 - 2.0 * ((py as f32 + 0.5) / height as f32);
        let ndc_z = d;
        // w4 = M * ndc(行主序四行点积)
        let w4_x = inv_vp[0] * ndc_x + inv_vp[1] * ndc_y + inv_vp[2] * ndc_z + inv_vp[3];
        let w4_y = inv_vp[4] * ndc_x + inv_vp[5] * ndc_y + inv_vp[6] * ndc_z + inv_vp[7];
        let w4_z = inv_vp[8] * ndc_x + inv_vp[9] * ndc_y + inv_vp[10] * ndc_z + inv_vp[11];
        let w4_w = inv_vp[12] * ndc_x + inv_vp[13] * ndc_y + inv_vp[14] * ndc_z + inv_vp[15];
        // 除零守卫:host `w4[3].abs() < 1e-8` → skip;此处以 safe_w 参与运算,
        // 实际消费由 `alive` 门控(形态纪律:分支不进循环体)。
        let mut safe_w = w4_w;
        if safe_w.abs() < 1e-8 {
            safe_w = 1.0;
        }
        let wx = w4_x / safe_w;
        let wy = w4_y / safe_w;
        let wz = w4_z / safe_w;
        let ddx = wx - cam_x;
        let ddy = wy - cam_y;
        let ddz = wz - cam_z;
        let dc = (ddx * ddx + ddy * ddy + ddz * ddz).sqrt();
        let lx = right_x * wx + right_y * wy + right_z * wz;
        let ly = up_x * wx + up_y * wy + up_z * wz;
        let last = levels as i32 - 1i32;
        let mut sel = 0i32;
        if dc > base_radius {
            sel = (dc / base_radius).log2().ceil() as i32;
            if sel < 0i32 {
                sel = 0i32;
            }
            if sel > last {
                sel = last;
            }
        }
        // 回退环:首个在窗内的级命中(host `break`);环内无 intrinsic 调用。
        let mut done = 0u32;
        let mut word = 0usize;
        let mut bit = 0u32;
        let mut l = sel;
        while l <= last {
            let lb = (l as usize) * 5;
            let pw = lparams[lb];
            let wmin_x = lparams[lb + 1] as i32;
            let wmin_y = lparams[lb + 2] as i32;
            let wp_x = (lx / pw).floor() as i32;
            let wp_y = (ly / pw).floor() as i32;
            let sx = ((wp_x % 128i32) + 128i32) % 128i32;
            let sy = ((wp_y % 128i32) + 128i32) % 128i32;
            let idx = (l as usize) * 16384 + (sy as usize) * 128 + sx as usize;
            if done == 0u32 {
                if wp_x >= wmin_x {
                    if wp_x < wmin_x + 128i32 {
                        if wp_y >= wmin_y {
                            if wp_y < wmin_y + 128i32 {
                                word = idx / 32;
                                bit = 1u32 << ((idx % 32) as u32);
                                done = 1u32;
                            }
                        }
                    }
                }
            }
            l = l + 1i32;
        }
        // 远平面/退化 w 剔除与命中门合流:唯一 intrinsic 调用,单 if 体内。
        let mut alive = 0u32;
        if d < 1.0 {
            if w4_w.abs() >= 1e-8 {
                alive = done;
            }
        }
        if alive == 1u32 {
            let _old = page_bits.fetch_or(word, bit, Scope::Gpu);
        }
    }
}

fn main() {}
