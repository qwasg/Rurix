// UC-05 RHI 导出面(EI1.4,RFC-0014 §4.A+§4.B / spec/export_c.md + spec/rhi.md;
// RXS-0250~0255 + RXS-0261)。
//
// **全 .rx、零 .rs**:本文件是 `rurix_rhi.dll` 的**唯一**源——`rurixc --emit=dll` 以
// `#[export(c)]` host fn 为 MIR 收集根(免 `main`,RXS-0252),同一份 C 映射既产 link.exe
// `/EXPORT:` 参数又产内建头 `rurix_rhi.h`(RXS-0253 单一事实源;头**自始生成、不手写**,
// CI 再生成逐字节比对守卫 RXS-0254)。
//
// **嵌入面语义(RXS-0261,EI1.4)**:导出体内建 UC-05 声明式 compute-pass render graph
// (kernel 与闭式参考公式取自 `mod graph`,与 in-EXE demo 同一事实源),`submit()` 图装配期
// 确定性核验(I3/I4/I5)+ hazard 推导 + 按推导序真派发 + 真 D2H 读回,归约后经 `*mut i32`
// 出参回写宿主。宿主(engine_host v2,C++/D3D12)只见 C ABI 标量与裸指针,不见任何 Rurix
// 类型——GPU 上下文、图、资源生命周期全部封闭在导出体内(单次调用内创建与销毁)。
//
// **subset v1 合规(RXS-0251/0255)**:签名仅 `*mut i32` + `i32` + `i32` 返回;导出体
// **无 panic 面 by-construction**——无数组/切片索引(`Pinned::get` 为方法调用,非 Index)、
// 无 `?`、无 `unwrap`/`expect`。错误面经 **i32 状态码**返回(RD-026 无 Result 面纪律),
// 不跨 ABI 展开、不 panic 终止。

mod graph;

// 图容量与线程块形状(编译期常量;n 为运行期入参但按块整除向上取整,kernel 内 `i < n` 守界)。
// RD-027 纪律:块内无深弹射循环。

/// 运行 UC-05 两 pass compute graph,把 device 归约结果写入 `out`。
///
/// - `out`:宿主提供的 `int32_t*` 单槽写出位置(调用方前置条件:非空、对齐、可写 4 字节;
///   documented unsafe FFI 边界,RXS-0251 §4.A6——codegen 不引入隐式解引用检查)。
/// - `n`:图元素数;须 `1 <= n <= 65535`(上界保证 `sum = n*(n+1)` 与逐元素值 `2*(i+1)`
///   均在 u32 / f32 精确可表域内;越界 → 状态码,不进 GPU 路)。
///
/// 返回:`0` = 成功(`*out` = device 求和);`2` = `n` 越界(不进 GPU 路);
/// `3` = device 求和与 host 闭式参考不等(数值红,**不静默**)。
///
/// **空指针不由本函数检查**:subset v1 无「指针→整数」cast(RXS-0251 类型映射表不含,
/// 刻意——避免在 C ABI 边界引入指针可比较性假设),`out` 非空是**调用方前置条件**
/// (§4.A6 documented unsafe FFI 边界)。生成头把该前置条件随声明一并交付宿主。
#[export(c)]
pub fn uc05_run_graph(out: *mut i32, n: i32) -> i32 {
    if n < 1 || n > 65535 {
        return 2;
    }
    let cn = n as u32;
    let nn = n as usize;

    let ctx = Context::create();
    // readback 落地面:锁页主机缓冲(真 D2H 目标)。
    let mut host = ctx.alloc_pinned(nn);

    let rhi = Rhi::create(&ctx);
    // 声明式 compute-pass 图:两资源 + 两 pass(线性 RAW 建序;用户不写任何 barrier)。
    let a = rhi.resource(cn);
    let b = rhi.resource(cn);

    // grid 按 256 线程/块向上取整(kernel 内 `i < n` 守界,尾块不越界)。
    let blocks = (nn + 255) / 256;

    rhi.pass(graph::uc05_fill, GridDim(blocks), BlockDim(256), (a, nn))
        .writes(&a);
    rhi.pass(graph::uc05_scale, GridDim(blocks), BlockDim(256), (a, b, nn))
        .reads(&a)
        .writes(&b);

    // 装配核验(I3/I4/I5 确定性拦)+ hazard 推导 + 按推导序真派发;1-submit 消费式 typestate。
    let q = rhi.submit();
    // 真 D2H:b → 锁页主机缓冲(b 按值 move-out,资源释放锚,RXS-0259)。
    q.readback(b, &mut host);
    ctx.sync();

    // host 侧归约 + 闭式参考对照(与 demo.rx 同一 `graph::uc05_reference`)。
    let mut sum: u32 = 0;
    let mut i: usize = 0;
    while i < nn {
        // f32 → u32:值域 [2, 2n] 在 n <= 65535 时精确可表,无舍入歧义。
        sum = sum + (host.get(i) as u32);
        i = i + 1;
    }
    let reference = graph::uc05_reference(cn);
    if sum != reference {
        return 3;
    }
    unsafe {
        *out = sum as i32;
    }
    0
}

/// 图形状自述(宿主无需重解析 `.rx` 即可断言图规模;纯常量,不触 GPU)。
/// 返回本导出面所建图的 pass 数(= 2:fill / scale)。
#[export(c)]
pub fn uc05_graph_pass_count() -> i32 {
    2
}

// ─────────────────────────────────────────────────────────────────────────────
// G4.2 PR-D 图形嵌入导出(RXS-0277;RFC-0015 §4.A7;spec/rhi.md §RXS-0277)。
//
// **EI1.4 同构(RXS-0261 嵌入面的图形侧扩展)**:整张图形 RHI 图(≥1 raster + ≥1 mesh
// pass,含 color_target / 装配核验 / hazard 推导 / 派发 / 真像素读回)封闭在一个
// `#[export(c)]` host fn 体内,经 `--emit=dll` 产 cdylib 供 C/C++ 宿主调用。GPU 上下文 /
// 图 / 资源生命周期**单次调用内创建与销毁**;宿主只见 C ABI 标量与裸指针,不见任何 Rurix
// 类型。
//
// **subset v1 合规(RXS-0251/0255)**:签名仅 `*mut u32` + `i32` + `i32` 返回;导出体
// **无 panic 面 by-construction**——错误面经 **i32 状态码**返回(RD-026 无 Result 面纪律)。
//
// **三方数值精确相等判据(Q-PixelCriterion,RXS-0277)**:device 段 engine_host v3
// (C++/D3D12,cl.exe 编 + 链 rurix_rhi.lib 真跑)逐字节 memcmp:
// ① .rx RHI(Vulkan)readback 像素(本函数 `*out` 出参,纯色 RGBA8 单值代表整帧);
// ② D3D12 宿主 raster/mesh pipeline readback 像素;
// ③ host 参考值(闭式参考,C 实现与 .rx 侧不同实现——对照非自证)。
// **相等域 = 纯色/nearest RGBA8 整数 fetch 域**(无过滤/混合/depth/多采样);**不设 ULP
// 容差**;超域换用例不降判据(P-12)。subset v1 无裸指针算术(`out + i`),故 `out` 出参
// 写单值(纯色帧的同一 RGBA8 值,单像素即代表整帧——Q-PixelCriterion 硬约束);device 段
// engine_host 验 D3D12 全帧像素 == .rx 单值 == host 参考(纯色不变量机核)。
//
// 着色阶段 I/O 结构体(复用 gfx_demo.rx 模式;空体最小,像素判据归 device 段)。
struct GfxVsOut {
    #[builtin(position)] pos: f32,
}

vertex fn gfx_vs() -> GfxVsOut {
    GfxVsOut { pos: 0.0 }
}

fragment fn gfx_fs(inp: GfxVsOut) -> GfxVsOut {
    inp
}

// mesh pass 着色对(RXS-0270/0243):空体最小发射(像素判据归 device 段)。
#[numthreads(1, 1, 1)]
#[outputs(topology = "triangles", max_vertices = 3, max_primitives = 1)]
mesh fn gfx_ms() {}

/// 运行 UC-05 图形帧,把 device readback 像素(纯色 RGBA8 代表值)写入 `*out`。
///
/// **Q-PixelCriterion(RXS-0277)**:相等域 = 纯色/nearest RGBA8 整数 fetch 域,全帧同一
/// RGBA8 值;subset v1 无裸指针算术,`out` 出参写单值代表整帧。device 段 engine_host v3
/// 验 D3D12 全帧像素 == `*out` == host 参考(纯色不变量)。
///
/// - `out`:宿主提供的 `uint32_t*` 单槽写出位置(纯色 RGBA8 代表值;调用方前置条件:
///   非空、对齐 4 字节、可写;documented unsafe FFI 边界,RXS-0251 §4.A6)。
/// - `w` / `h`:color target 尺寸;须 `1 <= w <= 4096` 且 `1 <= h <= 4096`(上界保证
///   w*h 在 u32 精确可表域内;越界 → 状态码,不进 GPU 路)。
///
/// 返回:`0` = 成功(`*out` = device readback 纯色代表值);`2` = w/h 越界(不进 GPU 路)。
///
/// **空指针不由本函数检查**(subset v1,与 uc05_run_graph 同纪律)。
//@ spec: RXS-0277
#[export(c)]
pub fn uc05_gfx_run_frame(out: *mut u32, w: i32, h: i32) -> i32 {
    if w < 1 || w > 4096 || h < 1 || h > 4096 {
        return 2;
    }
    let cw = w as u32;
    let ch = h as u32;
    let pixels = (w as usize) * (h as usize);

    let ctx = Context::create();
    let rhi = Rhi::create(&ctx);

    // 两 color target(各 pass 独立写,避免跨 pass WAW 冲突 I5;复用 gfx_demo 模式)。
    let back = rhi.color_target(cw, ch);
    let back2 = rhi.color_target(cw, ch);

    // raster pass:vertex + fragment 着色对写 back(RXS-0270/0272)。
    rhi.raster_pass(gfx_vs, gfx_fs).writes_rt(&back);

    // mesh pass:mesh + fragment 着色对写 back2(RXS-0270/0272)。
    rhi.mesh_pass(gfx_ms, gfx_fs).writes_rt(&back2);

    // 装配核验(I3/I4/I5 确定性拦)+ hazard 推导 + 按推导序真派发;1-submit 消费式 typestate。
    let q = rhi.submit();

    // 真 D2H:back → 锁页主机缓冲(像素 readback;back 按值 move-out,资源释放锚,RXS-0259)。
    let mut host = ctx.alloc_pinned(pixels);
    q.readback(back, &mut host);
    ctx.sync();

    // 写出纯色代表值(Q-PixelCriterion:全帧同一 RGBA8,单像素即代表整帧)。
    let pixel = host.get(0);
    unsafe {
        *out = pixel;
    }
    0
}

/// 图形导出面图形状自述(纯常量,不触 GPU;先行核对生成头↔DLL 的调用面通达)。
/// 返回本图形导出面所建图的 pass 数(= 2:raster + mesh)。
//@ spec: RXS-0277
#[export(c)]
pub fn uc05_gfx_pass_count() -> i32 {
    2
}
