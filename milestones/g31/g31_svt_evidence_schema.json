        "mapping_law": {
          "type": "string",
          "description": "逐材质三角数降序 top-12（并列时 material_index 升序；其余走既有常量面 0-byte）"
        },
        "mapped_materials": {
          "type": "integer",
          "const": 12
        },
        "tex_tris": {
