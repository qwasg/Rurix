    "textures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "census",
        "mapping_law",
        "mapped_materials",
        "tex_tris",
        "material_slots",
        "atlas",
        "linlut_digest",
        "g11_3_manifest",
        "probe",
        "spv_texture",
        "spv_texture_probe",
        "gaps"
      ],
      "properties": {
        "census": {
          "type": "object",
