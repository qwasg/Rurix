{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G31+ 波 C Task C13 SVT 稀疏虚拟纹理接线 harness evidence（--textures on --svt on 派生臂面）",
  "description": "evidence/g31_svt.json（或 --evidence 指定路径）。G31+ 波 C Task C13 SVT 四行（RD-041 分项，TODO #33-#36，milestones/g22/g22_svt_gap.json SVT 立项窗兑现）门 g31.waveC.svt：harness = src/rurix-render/src/bin/g31_window_present.rs --auto-move <orbit|dolly> --textures on --svt on [--svt-pool-tiles N]（B4 纹理面在案消费 0-byte；生产场景 kernel = kernels/g31_svt_gi.rx——g31_texture_gi.rx 逐字 fork + 虚拟纹理页表间接采样/miss 记录/fallback；--svt off 面 = B4 锚 0-byte）。SVT-1 页表 = 128K² 虚拟地址空间（131072²）1024×1024 u32 页表（0=未驻留,驻留=物理槽号+1）→ bistro 图集活动区 3072 页 → 物理瓦片池（确定性 LRU,容量预算 --svt-pool-tiles,0 = 全驻留锚臂）；SVT-2 反馈 = 生产 kernel 采样 miss → out_req 请求缓冲（1 f32/px,0=无 miss,页表网格序页号+1）→ host streaming/svt.rs SvtStreaming::consume（读瓦片 → 次帧 FrameUpdate.buffer_uploads 页表/池上传）请求-驻留闭环逐帧真跑；SVT-3 = 物理瓦片 130² 带 1 texel border（页所属槽 REPEAT wrap 律,双线性 2×2 footprint 单瓦片自足）——探针全驻留 SVT vs 整图直采位级硬门（边界聚焦 96 探针误差=0）；fallback = 槽均值低 mip 等效（×mod 同值）,hit 门融合 1·x+0·y IEEE 精确 ⇒ 全驻留臂与 B4 textures on 位级一致（锚）。SVT-4 按 M116 锚核验需求不成立维持 defer（terrain.rs 零 SVT 断言 0-byte,不冒充接线）。textures 块全字段与 rurix.g31.texture_sampling_evidence.v1 同形同律。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate",
    "scene",
    "tier",
    "backend",
    "trajectory",
    "frames",
    "warmup",
    "frames_completed",
    "exit_reason",
    "resize_eras",
    "resolution",
    "internal_resolution",
    "real_render_frame_ms",
    "present_frame_ms",
    "present_overhead_ms",
    "encode_frame_ms",
    "digest_frame_ms",
    "render_digest",
    "digest",
    "digest_seq",
    "ev100_seq",
    "camera_poses",
    "ev100_ramp",
    "headless",
    "window",
    "contracts",
    "render_includes_forced_readback",
    "spv",
    "textures",
    "stats",
    "notes",
    "svt"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "rurix.g31.svt_evidence.v1"
    },
    "gate": {
      "type": "string",
      "const": "g31.waveC.svt"
    },
    "scene": {
      "type": "string",
      "const": "bistro-interior"
    },
    "tier": {
      "type": "integer",
      "enum": [
        50,
        67,
        100
      ]
    },
    "backend": {
      "type": "string",
      "const": "tsr_device"
    },
    "trajectory": {
      "type": "string",
      "enum": [
        "orbit",
        "dolly"
      ]
    },
    "frames": {
      "type": "integer",
      "minimum": 1
    },
    "warmup": {
      "type": "integer",
      "minimum": 0
    },
    "frames_completed": {
      "type": "integer",
      "minimum": 0,
      "description": "实际渲染帧数（== frames+warmup 全量完成；ESC 提前退出时 < 之且 exit_reason=user_close）"
    },
    "exit_reason": {
      "type": "string",
      "enum": [
        "frames_done",
        "user_close"
      ]
    },
    "resize_eras": {
      "type": "integer",
      "minimum": 0,
      "description": "WM_SIZE 触发的 extent 重建 era 计数（resize → swapchain 重建 + 渲染 extent 联动 + TSR 历史 reset）"
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "const": 1920
        },
        "h": {
          "type": "integer",
          "const": 1080
        }
      }
    },
    "internal_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "real_render_frame_ms": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "生产管线五 pass 渲染墙钟（post-warmup 均值；不含 present；含 BGRA8 8.3MB 强制回读段——render_includes_forced_readback=true 登记；纹理装配/探针一次性税不入本口径，见 textures.probe.eval_ms）"
    },
    "present_frame_ms": {
      "type": [
        "number",
        "null"
      ],
      "description": "纯 present 腿（acquire→copy→present→idle）post-warmup 均值；headless=true 时 null"
    },
    "present_overhead_ms": {
      "type": [
        "number",
        "null"
      ],
      "description": "present 相对生产的额外开销 = encode（host=0，device 编码）+ present 腿；headless=true 时 null"
    },
    "encode_frame_ms": {
      "type": "number",
      "minimum": 0,
      "description": "host 编码墙钟（device 编码落地后恒 0；device 编码 GPU 耗时分列 stats.encode_gpu_ms）"
    },
    "digest_frame_ms": {
      "type": "number",
      "minimum": 0,
      "description": "auto-move 逐帧 BGRA8 sha256 税（post-warmup 均值；单列不混渲染/present 口径）"
    },
    "render_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "末帧 TSR 输出 digest（G10EXRD-1 口径，末帧一次性 f32 回读，与 g14_3 bench 末帧 digest 同算法）"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "末帧 device BGRA8 打包帧 digest（G31BGRA-1 口径；== digest_seq 末项）"
    },
    "digest_seq": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "description": "逐帧 BGRA8 打包帧 digest 序列（每渲染帧一项，含 warmup；长度 == frames_completed）：确定性双跑位级一致门 + textures on≠off 接线真实生效门的判定对象"
    },
    "ev100_seq": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      },
      "description": "逐帧 ev100（--ev100-ramp 坡或契约值；经 128B TSR 参数逐帧 uniform 上传，长度 == frames_completed）"
    },
    "camera_poses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "number"
        }
      },
      "description": "逐帧相机位姿 [x,y,z,yaw,pitch]（轨迹审计面，长度 == frames_completed）"
    },
    "ev100_ramp": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "a",
        "b"
      ],
      "properties": {
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number"
        }
      },
      "description": "--ev100-ramp a b 确定性曝光坡（未给 = null）"
    },
    "headless": {
      "type": "boolean"
    },
    "window": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "visible",
        "channel_order",
        "extent",
        "frames_presented",
        "swapchain_rebuilds"
      ],
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "channel_order": {
          "type": "string",
          "enum": [
            "bgra8_unorm",
            "rgba8_unorm"
          ]
        },
        "extent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "w",
            "h"
          ],
          "properties": {
            "w": {
              "type": "integer",
              "minimum": 1
            },
            "h": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "frames_presented": {
          "type": "integer",
          "minimum": 1
        },
        "swapchain_rebuilds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production",
        "g10_contract",
        "g10_camera",
        "g10_lighting",
        "consistency",
        "delta_note",
        "encode_spv"
      ],
      "properties": {
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string"
