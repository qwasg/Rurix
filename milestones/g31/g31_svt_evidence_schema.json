              "type": "integer",
              "const": 2062
            },
            "primitives_with_texcoord0": {
              "type": "integer",
              "const": 2062
            },
            "primitives_with_tangent": {
              "type": "integer",
              "const": 0,
              "description": "TANGENT 属性 0/2062——切线空间缺失，法线贴图着色面登记后续"
            }
          }
