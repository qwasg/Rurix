              "manifest_digest_match",
              "origin_x",
              "origin_y",
              "mod_r",
              "mod_g",
              "mod_b"
            ],
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "material_index": {
                "type": "integer",
                "minimum": 0
              },
              "material_name": {
                "type": "string"
              },
              "tris": {
                "type": "integer",
                "minimum": 1
              },
              "texture_uri": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "dds_format": {
                "type": "string",
