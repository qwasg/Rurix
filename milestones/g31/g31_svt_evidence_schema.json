                },
                "device_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "host_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "sampler_leg": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_lsb_diff",
                "bound_lsb",
