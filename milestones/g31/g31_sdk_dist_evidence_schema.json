    "sbom_spdx_covers",
    "sbom_cdx_covers",
    "vendor_runtime"
   ],
   "properties": {
    "signed_dlls": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "uniqueItems": true,
     "items": {
      "enum": [
       "rurix_renderer.dll",
       "rurix_renderer_sdk.dll"
      ]
     }
    },
    "sbom_spdx_covers": {
     "const": true
    },
    "sbom_cdx_covers": {
     "const": true
    },
    "vendor_runtime": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "type": "object",
      "required": [
       "name",
       "license",
       "linkage",
       "ref"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "license": {
        "type": "string"
       },
       "linkage": {
        "enum": [
         "dynamic-load-not-bundled",
         "static-in-dll"
        ]
       },
       "ref": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "install": {
   "type": "object",
   "required": [
    "from_dir",
    "switch",
    "idempotent",
    "network"
   ],
   "properties": {
    "from_dir": {
     "type": "object",
     "required": [
      "exit_code",
      "components",
      "digest_levels_verified",
