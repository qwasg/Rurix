    "scene": {
     "const": "bistro-interior"
    },
    "tier": {
     "const": 100
    },
    "frames": {
     "const": 160
    },
    "warmup": {
     "const": 10
    },
    "frame_ms_mean": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "frame_ms_p50": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "last_frame_digest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest_matches_stage_a_anchor": {
     "const": true
    }
   }
  },
  "red_arms": {
   "type": "object",
   "required": [
    "signature",
    "hash",
    "truncation",
    "manifest_tamper",
    "unreachable",
    "restore_green"
