       "const": "network"
      },
      "zero_residue": {
       "const": true
      }
     }
    },
    "manifest_tamper": {
     "type": "object",
     "required": [
      "kind"
     ],
     "properties": {
      "kind": {
       "const": "integrity"
      }
     }
    },
    "unreachable": {
     "type": "object",
     "required": [
      "kind"
     ],
     "properties": {
      "kind": {
       "const": "network"
      }
     }
    },
    "restore_green": {
     "const": true
    }
   }
