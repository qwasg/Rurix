     "detail"
    ],
    "properties": {
     "id": {
      "enum": [
       "bundle_assembly_ok",
       "signing_sbom_extended",
       "from_dir_install_ok",
       "switch_and_idempotent_ok",
       "network_install_ok",
       "offline_build_ok",
       "offline_run_digest_ok",
       "red_arms_closed",
       "ea1_regression_green"
      ]
     },
     "status": {
      "enum": [
       "PASS",
       "FAIL"
      ]
     },
     "detail": {
      "type": "string"
     }
    }
   }
  },
  "environment": {
   "type": "object"
  },
  "timestamp": {
   "type": "string"
  },
  "notes": {
   "type": "string",
   "minLength": 30
  }
 }
}
