     "properties": {
      "registered": {
       "const": 1
      },
      "registry_bytes_equal": {
       "const": true
      },
      "atomic_write_clean": {
       "const": true
      }
     }
    },
    "network": {
     "type": "object",
     "required": [
      "exit_code",
      "loopback_only",
      "byte_equal_source"
     ],
     "properties": {
      "exit_code": {
       "const": 0
      },
      "loopback_only": {
       "const": true
      },
      "byte_equal_source": {
       "const": true
      }
     }
    }
   }
  },
  "offline_build": {
   "type": "object",
   "required": [
    "example",
    "cl_exit",
    "build_seconds",
    "network_isolation",
    "run_exit",
    "run_seconds",
    "scene",
    "tier",
    "frames",
    "warmup",
    "frame_ms_mean",
    "frame_ms_p50",
    "last_frame_digest",
    "digest_matches_stage_a_anchor"
   ],
   "properties": {
    "example": {
     "const": "renderer_sdk_host.cpp"
    },
    "cl_exit": {
     "const": 0
    },
    "build_seconds": {
     "type": "number",
