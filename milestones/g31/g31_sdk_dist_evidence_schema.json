    },
    "channel": {
     "const": "stable"
    },
    "component_count": {
     "const": 16
    },
    "components": {
     "type": "array",
     "minItems": 16,
     "maxItems": 16,
     "uniqueItems": true,
     "items": {
      "enum": [
       "API_VERSIONING.md",
       "compatibility_matrix.md",
       "feature_matrix.md",
       "g13_ue_upscale_parity_contract.json",
       "g14_3_direct_gi.spv",
       "g14_8_tsr_resample.spv",
       "g14_8_tsr_resolve.spv",
       "g14_mv.spv",
       "integration_guide.md",
       "performance_tuning.md",
       "renderer_sdk_host.cpp",
       "rurix_renderer.dll",
       "rurix_renderer.h",
       "rurix_renderer.lib",
       "rurix_renderer_sdk.dll",
       "rurix_renderer_sdk.lib"
      ]
     }
    },
    "deterministic_bytes_equal": {
     "const": true
    },
    "digest_closure": {
     "const": true
    }
   }
  },
  "signing_sbom": {
   "type": "object",
   "required": [
