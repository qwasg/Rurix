{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "rurix://schemas/g31/sdk_dist_evidence/v1",
 "title": "G31+ 波 C Task C5 渲染器 SDK 分发打包门证据（ci/g31_sdk_dist_smoke.py --gate g31.waveC.dist 产）",
 "type": "object",
 "required": [
  "schema",
  "subject",
  "symbolic_gate_key",
  "wave",
  "bundle",
  "signing_sbom",
  "install",
  "offline_build",
  "red_arms",
  "regression",
  "facts",
  "environment",
  "timestamp",
  "notes"
