{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G31+ 波 A Task A1 window_present harness evidence",
  "description": "evidence/g31_window_present.json（或 --evidence 指定路径）。G31+ 波 A Task A1 生产管线 swapchain 真窗口呈现接线门 g31.waveA.present（G31_PLUS_COMMERCIAL_RENDERER_TODO §1.1 #1 行：bistro 1080p 真窗口逐帧 present，present 口径帧率独立登记禁混入真实渲染帧率口径）。harness = src/rurix-render/src/bin/g31_window_present.rs（g14_3_lane_body 逐字共享统一四 pass TSR 车道；bistro-interior 契约 + milestones/g10/corpus 三件套转引一致性核验；DisplayPipeline SDR+aces13 编码；vk::ExternalImagePresent 真窗口 present）。三口径：real_render_frame_ms（生产管线渲染耗时，不含 present；含 present 强制 TSR 回读段，render_includes_forced_readback=true 如实登记）/ present_frame_ms（纯 present 腿）/ present_overhead_ms（encode+present 腿）。--headless-smoke 无窗口退化仅供自检逻辑用不计真门（headless=true 时 window/present 口径 null）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate",
    "scene",
    "tier",
    "backend",
    "frames",
    "warmup",
    "resolution",
    "internal_resolution",
    "real_render_frame_ms",
    "present_frame_ms",
    "present_overhead_ms",
    "encode_frame_ms",
    "render_digest",
    "digest",
    "headless",
    "window",
    "contracts",
    "render_includes_forced_readback",
    "spv",
    "stats",
    "notes"
  ],
  "properties": {
    "schema": { "type": "string", "const": "rurix.g31.window_present_evidence.v1" },
    "gate": { "type": "string", "const": "g31.waveA.present" },
    "scene": { "type": "string", "const": "bistro-interior" },
    "tier": { "type": "integer", "enum": [50, 67, 100] },
    "backend": { "type": "string", "const": "tsr_device" },
    "frames": { "type": "integer", "minimum": 1 },
    "warmup": { "type": "integer", "minimum": 0 },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "const": 1920 },
        "h": { "type": "integer", "const": 1080 }
      }
    },
    "internal_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "real_render_frame_ms": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "生产管线四 pass 渲染耗时（post-warmup 均值；不含 present；含 present 强制 TSR 回读段——render_includes_forced_readback=true 登记）"
    },
    "present_frame_ms": {
      "type": ["number", "null"],
      "description": "纯 present 腿（acquire→copy→present→idle）post-warmup 均值；headless=true 时 null"
    },
    "present_overhead_ms": {
      "type": ["number", "null"],
      "description": "present 相对生产的额外开销 = encode + present 腿；headless=true 时 null"
    },
    "encode_frame_ms": {
      "type": "number",
      "minimum": 0,
      "description": "host 显示编码墙钟（A3 device 侧显示编码落地后恒 0：ACES1.3 RRT+ODT f32 移植 + BT.1886 于第五 pass g31_display_encode 链内完成，GPU 耗时分列 stats.encode_gpu_ms）"
    },
    "render_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "末帧 TSR 输出 digest（G10EXRD-1 口径，末帧一次性 f32 回读，与 g14_3 bench 末帧 digest 同算法）"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "末帧 device BGRA8 打包帧 digest（G31BGRA-1 口径；A3 起由 device 编码域接替，与 A1 host f64 编码域 rgb_set_digest 不冒充同值）"
    },
    "headless": { "type": "boolean" },
    "window": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["visible", "channel_order", "extent", "frames_presented", "swapchain_rebuilds"],
      "properties": {
        "visible": { "type": "boolean" },
        "channel_order": { "type": "string", "enum": ["bgra8_unorm", "rgba8_unorm"] },
        "extent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["w", "h"],
          "properties": {
            "w": { "type": "integer", "minimum": 1 },
            "h": { "type": "integer", "minimum": 1 }
          }
        },
        "frames_presented": { "type": "integer", "minimum": 1 },
        "swapchain_rebuilds": { "type": "integer", "minimum": 0 }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "g10_contract", "g10_camera", "g10_lighting", "consistency", "delta_note", "encode_spv"],
      "properties": {
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest"],
          "properties": {
            "path": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "g10_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "g10_camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "g10_lighting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "consistency": { "type": "string", "const": "pass" },
        "delta_note": { "type": "string" },
        "encode_spv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "render_includes_forced_readback": { "type": "boolean", "const": true },
    "spv": {
      "type": "object",
      "description": "统一四 pass 车道 provenance（g14_3 unified_provenance_json 同型：四 kernel SPV 路径 + sha256 全登记）",
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["render_cv", "render_min_ms", "render_max_ms", "encode_gpu_ms", "present_cv", "present_min_ms", "present_max_ms"],
      "properties": {
        "render_cv": { "type": "number" },
        "render_min_ms": { "type": "number" },
        "render_max_ms": { "type": "number" },
        "encode_gpu_ms": {
          "type": "number",
          "minimum": 0,
          "description": "A3 device 显示编码 pass GPU 耗时（telemetry g31_display_encode；post-warmup 均值）"
        },
        "present_cv": { "type": ["number", "null"] },
        "present_min_ms": { "type": ["number", "null"] },
        "present_max_ms": { "type": ["number", "null"] }
      }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "headless": { "const": false } }, "required": ["headless"] },
      "then": {
        "properties": {
          "window": { "type": "object" },
          "present_frame_ms": { "type": "number", "exclusiveMinimum": 0 },
          "present_overhead_ms": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    {
      "if": { "properties": { "headless": { "const": true } }, "required": ["headless"] },
      "then": {
        "properties": {
          "window": { "type": "null" },
          "present_frame_ms": { "type": "null" },
          "present_overhead_ms": { "type": "null" }
        }
      }
    }
  ]
}
