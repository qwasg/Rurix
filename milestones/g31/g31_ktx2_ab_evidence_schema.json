          "ktx2_uastc_l0_bytes": { "type": "integer", "minimum": 1 },
          "ktx2_uastc_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "uastc_encode_ms": { "type": "number", "minimum": 0 },
          "uastc_transcode_full_ms": { "type": "number", "minimum": 0 },
          "uastc_transcode_l0_ms": { "type": "number", "minimum": 0 },
          "uastc_rgb_max_masked": { "type": "integer", "minimum": 0, "maximum": 255 },
          "uastc_rgb_mean_masked": { "type": "number", "minimum": 0 },
