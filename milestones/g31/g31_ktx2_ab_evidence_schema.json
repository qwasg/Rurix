          "ktx2_uastc_full_bytes", "ktx2_uastc_l0_bytes", "ktx2_uastc_digest",
          "uastc_encode_ms", "uastc_transcode_full_ms", "uastc_transcode_l0_ms",
          "uastc_rgb_max_masked", "uastc_rgb_mean_masked", "uastc_alpha_max",
