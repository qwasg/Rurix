        "uastc_rgb_max_masked", "uastc_alpha_max",
        "etc1s_present", "etc1s_full_bytes", "etc1s_l0_bytes",
        "etc1s_encode_ms", "etc1s_transcode_full_ms", "etc1s_transcode_l0_ms",
        "etc1s_rgb_max_masked", "etc1s_alpha_max"
      ],
      "properties": {
        "dds_file_bytes": { "type": "integer", "minimum": 1 },
        "dds_l0_bytes": { "type": "integer", "minimum": 1 },
        "ktx2_uastc_full_bytes": { "type": "integer", "minimum": 1 },
