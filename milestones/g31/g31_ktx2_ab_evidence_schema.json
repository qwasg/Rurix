          "etc1s_full_bytes": { "type": "integer", "minimum": 0 },
          "etc1s_l0_bytes": { "type": "integer", "minimum": 0 },
          "etc1s_encode_ms": { "type": "number", "minimum": 0 },
          "etc1s_transcode_full_ms": { "type": "number", "minimum": 0 },
          "etc1s_transcode_l0_ms": { "type": "number", "minimum": 0 },
          "etc1s_rgb_max_masked": { "type": "integer", "minimum": 0, "maximum": 255 },
          "etc1s_rgb_mean_masked": { "type": "number", "minimum": 0 },
          "etc1s_alpha_max": { "type": "integer", "minimum": 0, "maximum": 255 },
          "etc1s_bc7_max_delta_ch": {
