{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G14.1 acceptance map check evidence",
  "description": "evidence/g14_acceptance_map_check_<UTC>.json。G14.1 治理门 g14.wave.1.acceptance_map（ci/g14_acceptance_map_check.py 写；普通检查门非聚合门，required_gates 空）：核验 milestones/g14/G14_ACCEPTANCE_MAP.md v1.0——§1 五行 P0 闭集全等（{M-a M-c/M-d 门登记表 UE 方差带结构化对账修订 / M-b UE benchmark 臂正式帧率测量 / M-c Rurix 生产管线性能面 / M-d 双端帧率正式对标+画质零降级守护 / M-e 回归门+漂移监控}）+ §2 零 go P1 空集 + key/脚本/schema 单一命名空间同 slug（g14.p0.m_<a~e>.<slug> + ci/g14_<slug>_smoke.py + g14_m_<a~e>_<slug>_evidence_schema.json）+ numeric_step 全列 post-interlock actual-next-free allocation 字面零预占 + 零空行/占位 + MAP §1 ↔ G14_CONTRACT §4.2 双向逐字一致（G14 治理三件套无独立 CI_GATES，沿 G13 体例精简为双向）。只读文档，不代绿实现门；本门 PASS 只表示映射完整，不表示任何 P0 能力已实现。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g14_acceptance_map_check" },
    "symbolic_gate_key": { "type": "string", "const": "g14.wave.1.acceptance_map" },
    "matrix_row": { "type": "string", "const": "G14.1" },
    "wave": { "type": "string", "const": "G14.1" },
    "numeric_step": { "type": "integer", "description": "post-materialize actual-next-free 回填" },
    "source_ref": {
      "type": "string",
      "const": "G14_CONTRACT G-G14-1/§4.2;G14_ACCEPTANCE_MAP.md §1/§2/§4/§5;2026-08-19 G14 立项前调研（UE benchmark 臂测量口径 + UE 渲染确定性控制面两份调研报告）P0 清单 M-a~M-e"
    },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": {
      "type": "string",
      "enum": ["not_applicable"]
    },
    "required_gates": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "extra_facts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string" }
        }
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_gates_pass",
        "all_extra_facts_pass",
        "all_subjects_pass",
        "aggregate_read_only"
      ],
      "properties": {
        "all_required_gates_pass": { "type": "boolean" },
        "all_extra_facts_pass": { "type": "boolean" },
        "all_subjects_pass": { "type": "boolean" },
        "aggregate_read_only": { "type": "boolean", "const": true }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
