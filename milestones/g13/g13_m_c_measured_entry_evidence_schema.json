{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G13.4 M-c(M169) UE 超分对拍 measured entry evidence",
  "description": "evidence/g13_m_c_calibration_<slug>_<UTC>.json。G13.4 M-c 标定腿逐条目 measured 面(标定程序 ci/g13_ue_upscale_parity_smoke.py 标定腿产,双 seed 方差底 p100,threshold = measured × 2.0 冻结 k 方向 max,禁手写 P-09;results.dual_seed_p100 供 budget_eval 通用路判读)。端内参照口径(RXS-0403 L4 同族)——跨端曝光/灯面口径差尺度消去不消费;标定帧面位级确定性由门内双跑判据承载。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entry_id",
    "results",
    "protocol",
    "sample_manifest",
    "provenance",
    "timestamp"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "rurix.g13ueupscale.measured_entry.v1"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^g13\\.ue_upscale\\."
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dual_seed_p100"],
      "properties": {
        "dual_seed_p100": {
          "type": "number"
        }
      }
    },
    "protocol": {
      "type": "string"
    },
    "sample_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "digest"],
      "properties": {
        "count": { "type": "integer" },
        "digest": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu", "backend", "base_commit"],
      "properties": {
        "gpu": { "type": "string" },
        "backend": { "type": "string" },
        "base_commit": { "type": "string" }
      }
    },
    "timestamp": {
      "type": "string"
    }
  }
}
