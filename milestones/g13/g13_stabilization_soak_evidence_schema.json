{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G13.5a stabilization soak aggregate evidence",
  "description": "evidence/g13_stabilization_soak_<UTC>.json。四腿 + G5~G12 既有判据 0-byte fact：①全量回归（G13 5 P0 = M-a~M-e 逐门真跑 --gate 后机器核验最新 evidence 顶层 status==pass 字面——缺字段即红；wave2/3/4 exit + wave5 decisions 四聚合/决策门真跑核验；5 门 evidence base_commit 同值=HEAD 且 9 门 stamp 新鲜度机核=同一候选 close-out 基线，沿 G12.7a/G11.7a/G10.8a MAP §7 口径）+ ②超分链路（三后端出图/差距登记表装配复核）连续复跑 soak（≥1800s 沿 G12.7a/G11.7a/G10.8a/G9.8a 继承，迭代计数与各环节计数非空、零失败）+ ③budget_eval --strict 非空零 estimated/skip + ④纪律日期锚 + G5~G12 既有判据 0-byte（M-e 门同闭集字面：已提交 diff ⊆ {ci/g10_gap_registry_lib.py 加性演进位 v1.138 登记}，工作树 porcelain ⊆ {g12_pt_sampler_selection.json 异己登记面}）。诚实语义沿 G12.7a/G11.7a/G10.8a/G9.8a 口径：soak 墙钟=真实超分链路复跑实测（sleep_seconds 恒 0，active_chain_seconds 逐迭代计时求和，gate 外测墙钟交叉核验）；upscale-chain-soak 无 validation/device_lost 字面量 0 硬门（device 面归回归腿 5 门本体）；G13 无 legacy 兼容——首份 evidence 即 honesty 格式，soak 块 honesty 字段全必填。schema 为形态面（字段闭集 + honesty 常量：soak_subject/sleep_seconds 恒 0 + min_iterations/min_seconds const 登记）；双阈值与计数非空的 PASS 语义由门逻辑 checks.soak_dual_threshold 与 --verify-latest 的 judge_chain_soak 机器复核承载——FAIL 留档件同形态落盘不删，evidence/ 只增不删不改纪律与 check_schemas 共存（G12.5 M165 偏差 FAIL 件/G12.7a 首跑 FAIL 件同模）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "base_commit",
    "utc_date",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "soak",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g13_stabilization_soak" },
    "symbolic_gate_key": { "type": "string", "const": "g13.wave.5a.soak" },
    "matrix_row": { "type": "string", "const": "G13.5a" },
    "wave": { "type": "string", "const": "G13.5a" },
    "numeric_step": { "type": "integer", "const": 245 },
    "source_ref": { "type": "string" },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": { "type": "string", "enum": ["not_applicable"] },
    "base_commit": { "type": "string", "minLength": 7 },
    "utc_date": { "type": "string", "pattern": "^[0-9]{8}$" },
    "required_gates": { "type": "array", "minItems": 9, "maxItems": 9 },
    "extra_facts": { "type": "array", "minItems": 6, "maxItems": 6 },
    "subjects": { "type": "array" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regression_all_pass",
        "base_commit_uniform",
        "soak_dual_threshold",
        "soak_no_sleep_padding",
        "budget_strict_pass",
        "legacy_criteria_0byte",
        "date_anchor_recorded"
      ],
      "properties": {
        "regression_all_pass": { "type": "boolean" },
        "base_commit_uniform": { "type": "boolean" },
        "soak_dual_threshold": { "type": "boolean" },
        "soak_no_sleep_padding": { "type": "boolean" },
        "budget_strict_pass": { "type": "boolean" },
        "legacy_criteria_0byte": { "type": "boolean" },
        "date_anchor_recorded": { "type": "boolean" }
      }
    },
    "soak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterations",
        "seconds",
        "min_iterations",
        "min_seconds",
        "soak_subject",
        "active_chain_seconds",
        "sleep_seconds",
        "outer_wall_seconds",
        "failures",
        "upscale_frames_rendered",
        "registry_assemblies",
        "backend_digest_anchors"
      ],
      "properties": {
        "iterations": { "type": "integer", "minimum": 0 },
        "seconds": { "type": "number", "minimum": 0 },
        "min_iterations": { "type": "integer", "const": 3 },
        "min_seconds": { "type": "integer", "const": 1800 },
        "soak_subject": { "type": "string", "const": "upscale-chain-soak" },
        "active_chain_seconds": { "type": "number", "minimum": 0 },
        "sleep_seconds": { "type": "number", "const": 0 },
        "outer_wall_seconds": { "type": "number", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "upscale_frames_rendered": { "type": "integer", "minimum": 0 },
        "registry_assemblies": { "type": "integer", "minimum": 0 },
        "backend_digest_anchors": { "type": "object" }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
