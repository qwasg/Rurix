    "subject": { "type": "string", "const": "renderer_visbuffer_smoke" },
    "milestone": { "type": "string" },
    "step": { "type": "integer", "const": 84 },
    "host_section_pass": { "type": "boolean" },
    "device_section_rc": { "type": "integer" },
    "device_blocked": { "type": ["string", "null"] },
    "device_probe_note": { "type": ["string", "null"] },
    "device_wave_w1_pass": { "type": ["boolean", "null"] },
    "device_wave_w2_pass": { "type": ["boolean", "null"] },
    "device_wave_tests": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geom_build_pass": { "type": ["boolean", "string"] },
        "geom_build_count": { "type": ["integer", "boolean", "string"] },
        "geometry_pass": { "type": ["boolean", "string"] },
        "geometry_count": { "type": ["integer", "boolean", "string"] }
