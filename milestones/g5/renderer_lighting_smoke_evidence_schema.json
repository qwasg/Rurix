  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "renderer_lighting_smoke" },
    "milestone": { "type": "string" },
    "step": { "type": "integer", "const": 85 },
    "host_section_pass": { "type": "boolean" },
    "device_section_rc": { "type": "integer" },
    "device_blocked": { "type": ["string", "null"] },
    "device_probe_note": { "type": ["string", "null"] },
    "device_wave_w1_pass": { "type": ["boolean", "null"] },
    "device_wave_w2_pass": { "type": ["boolean", "null"] },
    "device_wave_tests": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "device_blocked_w3": { "type": ["string", "null"] },
    "blocked_reason": { "type": ["string", "null"] },
    "missing_toolchain_caps": {
