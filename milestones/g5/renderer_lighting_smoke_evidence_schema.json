    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shadow_pass": { "type": ["boolean", "string"] },
        "shadow_count": { "type": ["integer", "boolean", "string"] },
        "gi_pass": { "type": ["boolean", "string"] },
        "gi_count": { "type": ["integer", "boolean", "string"] },
        "rt_pass": { "type": ["boolean", "string"] },
        "rt_count": { "type": ["integer", "boolean", "string"] }
