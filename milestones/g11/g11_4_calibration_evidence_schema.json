{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G11.4 标定 budget evidence（M153/M154 三条标定条目共享）",
  "description": "evidence/g11_m153|m154_calibration_*_<UTC>.json。G11.4 波两门产出的 budget 标定证据：results.trimmed_mean = 标定 p100/measured（budget_eval 通用 measured entry 判读面，零新 evaluator 分支）+ provenance（估计器语义 p100×k / min×k / k 理由 / 样本集 digest / measured 登记）+ 环境画像。供 g11_budget.json 三条 g11.fix.r3|r4 标定条目 evidence_file 引用（P-09 禁手写阈值；r4_farfield_energy_min 为 direction=min 面，k=0.5 安全边）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "milestone",
    "wave",
    "numeric_step",
    "results",
    "provenance",
    "environment",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "subject": {
      "type": "string",
      "enum": [
        "g11_m153_calibration_r3_luminance_shrink",
        "g11_m154_calibration_r4_p90_shrink",
        "g11_m154_calibration_r4_farfield_energy_min"
      ]
    },
    "symbolic_gate_key": {
      "type": "string",
      "enum": [
        "g11.p0.m153.fix_r3_light_subset",
        "g11.p0.m154.fix_r4_gi_multibounce_world_cache"
      ]
    },
    "milestone": {
      "type": "string"
    },
    "wave": {
      "type": "string",
      "const": "G11.4"
    },
    "numeric_step": {
      "type": "integer",
      "enum": [
        208,
        209
      ]
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trimmed_mean",
        "estimator",
        "sample_pair_count",
        "safety_factor_k",
        "threshold"
      ],
      "properties": {
        "trimmed_mean": {
          "type": "number"
        },
        "estimator": {
          "type": "string"
        },
        "sample_pair_count": {
          "type": "integer",
          "minimum": 1
        },
        "safety_factor_k": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3.0
        },
        "threshold": {
          "type": "number"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "estimator_semantics",
        "k_rationale",
        "sample_set_digest",
        "measured"
      ],
      "properties": {
        "estimator_semantics": {
          "type": "string"
        },
        "k_rationale": {
          "type": "string"
        },
        "sample_set_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "measured": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "python_version",
        "cargo_version",
        "rustc_version"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "cargo_version": {
          "type": "string"
        },
        "rustc_version": {
          "type": "string"
        }
      }
    },
    "timestamp": {
      "type": "string"
    }
  }
}
