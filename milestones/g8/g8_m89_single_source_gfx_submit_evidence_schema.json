        "artifacts_v2_real_consumption": { "type": "boolean" },
        "vb_ib_binding_via_cabi": { "type": "boolean" },
        "assembly_reject_legs_red": { "type": "boolean" },
        "seal_reflection_bidirectional_verify": { "type": "boolean" },
        "compile_only_not_pass": { "type": "boolean" },
        "validation_zero_errors": { "type": "boolean" },
        "accept_corpus_green": { "type": "boolean" }
      }
