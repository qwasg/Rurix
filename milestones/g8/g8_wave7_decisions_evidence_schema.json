{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G8.7 P2 decisions aggregate evidence",
  "description": "evidence/g8_wave7_decisions_<UTC>.json。G8.7 P2 穷举决策门 g8.wave.7.decisions。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g8_wave7_decisions" },
    "symbolic_gate_key": { "type": "string", "const": "g8.wave.7.decisions" },
    "matrix_row": { "type": "string", "const": "G8.7" },
    "wave": { "type": "string", "const": "G8.7" },
    "numeric_step": { "type": "integer" },
    "source_ref": { "type": "string" },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": { "type": "string", "enum": ["not_applicable"] },
    "required_gates": { "type": "array", "maxItems": 0 },
    "extra_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": true
      }
    },
    "subjects": { "type": "array" },
    "checks": {
      "type": "object",
      "required": [
        "all_required_gates_pass",
        "all_extra_facts_pass",
        "all_subjects_pass",
        "aggregate_read_only"
      ],
      "additionalProperties": false,
      "properties": {
        "all_required_gates_pass": { "type": "boolean" },
        "all_extra_facts_pass": { "type": "boolean" },
        "all_subjects_pass": { "type": "boolean" },
        "aggregate_read_only": { "type": "boolean", "const": true }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
