{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G8.5a M19 vsm_page_cache evidence",
  "description": "evidence/g8_m19_vsm_page_cache_<UTC>.json。G8.5a P0 硬门 g8.p0.m19.vsm_page_cache:VSM 跨帧页缓存/失效分类/clipmap scroll/local light/non-virtual caster/multi-view batch device 对拍。device 必需;RURIX_REQUIRE_REAL=1。CI 步骤 115。RD-038 raster/VSM 接入空集(closed 指针)。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "rd038_raster_vsm_ingress",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g8_m19_vsm_page_cache" },
    "symbolic_gate_key": { "type": "string", "const": "g8.p0.m19.vsm_page_cache" },
    "matrix_row": { "type": "string", "const": "M19" },
    "wave": { "type": "string", "const": "G8.5a" },
    "numeric_step": { "type": "integer", "const": 115 },
    "source_ref": { "type": "string", "minLength": 1 },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": {
      "type": "string",
      "enum": [
        "executed",
        "skipped_dev_env",
        "pass",
        "fail",
        "not_applicable",
        "dev_env_degrade"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_oracle_regression",
        "event_sequence_matches_golden",
        "cross_frame_cache_hit",
        "invalidation_reasons_exhaustive",
        "clipmap_scroll_hit",
        "local_light_page_hit",
        "non_virtual_caster_hit",
        "multi_view_batch",
        "page_table_digest_match",
        "depth_readback_digest_match",
        "sample_digest_match",
        "red_stale_page",
        "red_wrong_eviction",
        "red_missing_local_page",
        "validation_zero",
        "not_satisfiable_by_g7"
      ],
      "properties": {
        "host_oracle_regression": { "type": "boolean" },
        "event_sequence_matches_golden": { "type": "boolean" },
        "cross_frame_cache_hit": { "type": "boolean" },
        "invalidation_reasons_exhaustive": { "type": "boolean" },
        "clipmap_scroll_hit": { "type": "boolean" },
        "local_light_page_hit": { "type": "boolean" },
        "non_virtual_caster_hit": { "type": "boolean" },
        "multi_view_batch": { "type": "boolean" },
        "page_table_digest_match": { "type": "boolean" },
        "depth_readback_digest_match": { "type": "boolean" },
        "sample_digest_match": { "type": "boolean" },
        "device_page_mark_project": { "type": "boolean" },
        "red_fake_page_mark": { "type": "boolean" },
        "red_stale_page": { "type": "boolean" },
        "red_wrong_eviction": { "type": "boolean" },
        "red_missing_local_page": { "type": "boolean" },
        "validation_zero": { "type": "boolean" },
        "not_satisfiable_by_g7": { "type": "boolean" }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "rd038_raster_vsm_ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "closed_evidence_pointers"],
      "properties": {
        "status": { "type": "string", "const": "empty_set" },
        "reason": { "type": "string", "minLength": 1 },
        "closed_evidence_pointers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "device_digest_section": {
      "description": "A2:三条 digest 判据的 provenance 记账。digest 原像取自 device readback(kernel 真消费该帧页表/物理池),与 golden 逐帧比对;此前为 host fixture digest 直填 + smoke truthiness 判定(假绿),已清零。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "golden_ref",
        "frames_checked",
        "frames_with_local",
        "page_table_frames_matched",
        "depth_pool_frames_matched",
        "sample_frames_matched",
        "sample_value_mismatches",
        "device_dispatches",
        "measured_depth_max_abs",
        "tol_depth"
      ],
      "properties": {
        "provenance": { "type": "string", "const": "device_readback" },
        "golden_ref": { "type": "string", "minLength": 1 },
        "frames_checked": { "type": "integer" },
        "frames_with_local": { "type": "integer" },
        "page_table_frames_matched": { "type": "integer" },
        "depth_pool_frames_matched": { "type": "integer" },
        "sample_frames_matched": { "type": "integer" },
        "sample_value_mismatches": { "type": "integer" },
        "device_dispatches": { "type": "integer" },
        "measured_depth_max_abs": { "type": "number" },
        "tol_depth": { "type": "number" }
      }
    },
    "device_mark_section": {
      "description": "A2.1:mark 段(设计 §2.1 帧循环第一行 / §2.3 第一核)的 provenance 记账。device 逐帧 dispatch `vsm_page_mark_project`(主相机深度 → 反投影 → 选级 → 出窗回退 → 原子位图),readback 位图与 host 镜像 `Vsm::page_mark_bits` 逐位 + 逐槽对拍;此前该核编进 SPV 但零消费,fixture 用 host 预知 page id 的 `mark_slot` 直接标页(已清零)。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel",
        "provenance",
        "host_mirror",
        "dispatches",
        "frames_matched",
        "bits_set_total",
        "word_mismatches",
        "slot_mismatches",
        "tail_dirty_words",
        "distinct_bitmaps",
        "pixels_per_frame",
        "depth_is_causal"
      ],
      "properties": {
        "kernel": { "type": "string", "const": "vsm_page_mark_project" },
        "provenance": { "type": "string", "const": "device_readback" },
        "host_mirror": { "type": "string", "minLength": 1 },
        "dispatches": { "type": "integer" },
        "frames_matched": { "type": "integer" },
        "bits_set_total": { "type": "integer" },
        "word_mismatches": { "type": "integer" },
        "slot_mismatches": { "type": "integer" },
        "tail_dirty_words": { "type": "integer" },
        "distinct_bitmaps": { "type": "integer" },
        "pixels_per_frame": { "type": "integer" },
        "depth_is_causal": { "type": "boolean" },
        "depth_is_causal_basis": { "type": "string", "minLength": 1 },
        "local_spot_mark_scope": { "type": "string", "minLength": 1 }
      }
    },
    "validation_section": {
      "description": "A2.1:`validation_errors` 的来源记账。此前 device 侧是写死的 `0u32` 字面量;现取 `rurix_rt::render_exec` messenger 的进程实数,并附 messenger 是否真装上(未装上时 0 不可信)。",
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "messenger_installed", "source"],
      "properties": {
        "errors": { "type": "integer" },
        "messenger_installed": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "red_axes": {
      "description": "RED 轴的可观测量(恒真臂已删)。",
      "type": "object",
      "additionalProperties": false,
      "required": ["stale_page", "missing_local_page", "wrong_eviction"],
      "properties": {
        "stale_page": { "type": "string", "minLength": 1 },
        "missing_local_page": { "type": "string", "minLength": 1 },
        "wrong_eviction": { "type": "string", "minLength": 1 },
        "fake_page_mark": { "type": "string", "minLength": 1 }
      }
    },
    "notes": { "type": "string" }
  }
}
