{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G8.8a wave8a.soak aggregate evidence",
  "description": "evidence/g8_wave8a_soak_<UTC>.json。四腿:回归+soak+budget strict+日期锚。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "base_commit",
    "utc_date",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "soak",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g8_wave8a_soak" },
    "symbolic_gate_key": { "type": "string", "const": "g8.wave.8a.soak" },
    "matrix_row": { "type": "string", "const": "G8.8a" },
    "wave": { "type": "string", "const": "G8.8a" },
    "numeric_step": { "type": "integer", "minimum": 0 },
    "source_ref": { "type": "string" },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": { "type": "string", "enum": ["not_applicable"] },
    "base_commit": { "type": "string", "minLength": 7 },
    "utc_date": { "type": "string", "pattern": "^[0-9]{8}$" },
    "required_gates": { "type": "array" },
    "extra_facts": { "type": "array", "minItems": 1 },
    "subjects": { "type": "array" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regression_all_pass",
        "soak_dual_threshold",
        "budget_strict_pass",
        "date_anchor_recorded"
      ],
      "properties": {
        "regression_all_pass": { "type": "boolean" },
        "soak_dual_threshold": { "type": "boolean" },
        "budget_strict_pass": { "type": "boolean" },
        "date_anchor_recorded": { "type": "boolean" }
      }
    },
    "soak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frames",
        "seconds",
        "min_frames",
        "min_seconds",
        "validation_messages",
        "device_lost_count"
      ],
      "properties": {
        "frames": { "type": "integer", "minimum": 0 },
        "seconds": { "type": "number", "minimum": 0 },
        "min_frames": { "type": "integer", "const": 10000 },
        "min_seconds": { "type": "integer", "const": 1800 },
        "validation_messages": { "type": "integer", "minimum": 0 },
        "device_lost_count": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
