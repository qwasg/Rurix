{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G8.6c wave6c.exit aggregate evidence",
  "description": "evidence/g8_wave6c_exit_<UTC>.json。G8.6c 波次聚合门草稿:只读汇总 M66 + M73 诚实 A/B;NUMERIC_STEP 由 Gov 回填。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g8_wave6c_exit" },
    "symbolic_gate_key": { "type": "string", "const": "g8.wave.6c.exit" },
    "matrix_row": { "type": "string", "const": "G8.6c" },
    "wave": { "type": "string", "const": "G8.6c" },
    "numeric_step": { "type": "integer", "minimum": 0 },
    "source_ref": { "type": "string" },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": {
      "type": "string",
      "enum": ["not_applicable"]
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["symbolic_gate_key", "status"],
        "properties": {
          "symbolic_gate_key": { "type": "string" },
          "subject_prefix": { "type": "string" },
          "evidence_path": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
          "detail": { "type": "string" }
        }
      }
    },
    "extra_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string" }
        }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
          "detail": { "type": "string" },
          "evidence_path": { "type": ["string", "null"] }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_gates_pass",
        "all_extra_facts_pass",
        "all_subjects_pass",
        "aggregate_read_only"
      ],
      "properties": {
        "all_required_gates_pass": { "type": "boolean" },
        "all_extra_facts_pass": { "type": "boolean" },
        "all_subjects_pass": { "type": "boolean" },
        "aggregate_read_only": { "type": "boolean", "const": true }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
