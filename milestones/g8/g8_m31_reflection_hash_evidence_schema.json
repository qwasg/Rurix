{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G8.2 M31 reflection_hash evidence",
  "description": "evidence/g8_m31_reflection_hash_<UTC>.json。G8.2 P0 硬门 g8.p0.m31.reflection_hash:host/compile 纯 host 门,canonical reflection v1 序列化与 interface hash 稳定性(RXS-0304~0307;RFC-0019 §4.4)。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g8_m31_reflection_hash" },
    "symbolic_gate_key": { "type": "string", "const": "g8.p0.m31.reflection_hash" },
    "matrix_row": { "type": "string", "const": "M31" },
    "wave": { "type": "string", "const": "G8.2" },
    "numeric_step": { "type": "integer", "const": 97 },
    "source_ref": { "type": "string", "const": "RFC-0019 §4.4;spec/rendering_platform.md RXS-0304~0307" },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": {
      "type": "string",
      "enum": ["not_applicable"]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "double_reflection_byte_identical",
        "declaration_order_invariant",
        "body_only_change_keeps_interface_hash",
        "abi_binding_change_flips_hash",
        "abi_resource_kind_change_flips_hash",
        "abi_stage_visibility_change_flips_hash",
        "abi_value_type_change_flips_hash",
        "empty_encodings_stable",
        "duplicate_entry_fails_closed",
        "unbounded_sampler_unmappable",
        "compute_struct_param_unsupported",
        "json_artifact_deterministic",
        "json_artifact_path_free",
        "assembly_verify_pair_fail_closed",
        "accept_corpus_green",
        "reject_corpus_red_with_codes"
      ],
      "properties": {
        "double_reflection_byte_identical": { "type": "boolean" },
        "declaration_order_invariant": { "type": "boolean" },
        "body_only_change_keeps_interface_hash": { "type": "boolean" },
        "abi_binding_change_flips_hash": { "type": "boolean" },
        "abi_resource_kind_change_flips_hash": { "type": "boolean" },
        "abi_stage_visibility_change_flips_hash": { "type": "boolean" },
        "abi_value_type_change_flips_hash": { "type": "boolean" },
        "empty_encodings_stable": { "type": "boolean" },
        "duplicate_entry_fails_closed": { "type": "boolean" },
        "unbounded_sampler_unmappable": { "type": "boolean" },
        "compute_struct_param_unsupported": { "type": "boolean" },
        "json_artifact_deterministic": { "type": "boolean" },
        "json_artifact_path_free": { "type": "boolean" },
        "assembly_verify_pair_fail_closed": { "type": "boolean" },
        "accept_corpus_green": { "type": "boolean" },
        "reject_corpus_red_with_codes": { "type": "boolean" }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
