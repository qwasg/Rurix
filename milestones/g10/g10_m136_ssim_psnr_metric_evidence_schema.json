    "subject": { "type": "string", "const": "g10_m136_ssim_psnr_metric" },
    "symbolic_gate_key": { "type": "string", "const": "g10.p0.m136.ssim_psnr_metric" },
    "matrix_row": { "type": "string", "const": "M136" },
