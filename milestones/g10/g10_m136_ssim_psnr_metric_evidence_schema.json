        "skimage_reference_pinned": { "type": "boolean" },
        "corpus_lower_bound": { "type": "boolean" },
        "identity_ssim_one_psnr_inf": { "type": "boolean" },
        "pairwise_comparison_within_tolerance": { "type": "boolean" },
        "tolerance_calibration_provenance": { "type": "boolean" },
