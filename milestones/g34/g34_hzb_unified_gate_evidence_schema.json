      "properties": {
        "primary_spv": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
        "shade_spv": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
        "pack_spv": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
        "reduce_spv": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
        "test_spv": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
        "spirv_val_all": { "type": "boolean", "const": true, "description": "五 SPV rurixc 现编 + spirv-val 全绿才许 true（PASS-only 面）" },
        "mother_tracked_0byte": { "type": "boolean", "const": true, "description": "冻结 tracked 双 kernel（g27_hzb_reduce/g27_hzb_test）vs HEAD 提交面 + 工作树 0-byte 才许 true；g31_hzb_pack.rx 为 G31 期 untracked 冻结源（diff-vs-HEAD 不适用）→ frozen_snapshot 快照面承载" },
        "frozen_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src/rurix-render/kernels/g34_unified_gi.rx",
            "src/rurix-render/kernels/g34_unified_shade.rx",
            "src/rurix-render/kernels/g34_unified_primary.rx",
            "src/rurix-render/kernels/g31_hzb_pack.rx",
            "src/rurix-render/src/bin/g34_full_lane/g34_2_hzb.rs",
            "src/rurix-render/src/bin/g34_full_lane.rs",
            "src/rurix-render/src/bin/g31_window_present.rs"
          ],
          "properties": {
            "src/rurix-render/kernels/g34_unified_gi.rx": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "src/rurix-render/kernels/g34_unified_shade.rx": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "src/rurix-render/kernels/g34_unified_primary.rx": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "src/rurix-render/kernels/g31_hzb_pack.rx": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "src/rurix-render/src/bin/g34_full_lane/g34_2_hzb.rs": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "src/rurix-render/src/bin/g34_full_lane.rs": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "src/rurix-render/src/bin/g31_window_present.rs": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "description": "G31/G34 期 untracked 冻结面（工作树 untracked，diff-vs-HEAD 不适用）——G34-2 sha256 快照 = 后续波漂移守护基线（含 g31_hzb_pack.rx untracked 冻结源；g31_window_present.rs 0-byte 承诺面——其门为回归锚）"
        }
      }
    },
    "culling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neutrality", "occlusion"],
      "properties": {
        "neutrality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trajectory", "frames", "warmup", "seq_len", "hzb_vs_allvis_seq_bitexact", "mismatch_count"],
          "properties": {
            "trajectory": { "type": "string", "const": "orbit" },
            "frames": { "type": "integer", "minimum": 1 },
            "warmup": { "type": "integer", "minimum": 0 },
            "seq_len": { "type": "integer", "minimum": 1 },
            "hzb_vs_allvis_seq_bitexact": { "type": "boolean", "const": true, "description": "--hzb on 腿 vs RURIX_HZB_ALL_VISIBLE=1 全集渲染实验臂 digest_seq 逐帧位级一致才许 true（剔除不改变可见像素 = 两阶段闭环正确性结构判据）" },
            "mismatch_count": { "type": "integer", "const": 0 }
          }
        },
        "occlusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instances", "mips", "tested", "occluded_p1", "flipped_p2", "closure_extra_submits", "closure_full_fallback_frames", "all_visible_arm"],
          "properties": {
            "instances": { "type": "integer", "minimum": 1, "description": "剔除对象粒度 = TLAS 实例（bistro 逐 mesh 节点 BLAS 分解 + 动态实例尾槽恒可见不参剔）" },
            "mips": { "type": "integer", "minimum": 1 },
            "tested": { "type": "integer", "minimum": 1 },
            "occluded_p1": { "type": "integer", "minimum": 1, "description": "p1 被剔合计 ≥1 才许（零剔除即空接线冒充判红；PASS-only 面）" },
            "flipped_p2": { "type": "integer", "minimum": 0, "description": "p2 上帧被剔集本帧金字塔重测翻回计数（两阶段闭环第二段）" },
            "closure_extra_submits": { "type": "integer", "minimum": 0 },
            "closure_full_fallback_frames": { "type": "integer", "minimum": 0, "description": "闭环 ≤4 迭代未收敛全掩码兜底帧计数（= 零剔除精确收敛；如实登记）" },
            "all_visible_arm": { "type": "boolean", "const": false, "description": "本块数字来自 hzb_a 生产腿（非 ALL_VISIBLE 实验臂）机核" }
          }
        }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mips", "n_rects", "mips_bitexact", "verdict_equal", "false_positives", "occluded", "pyramid_digest", "host_pyramid_digest", "verdict_digest", "host_verdict_digest"],
      "properties": {
        "mips": { "type": "integer", "minimum": 1 },
        "n_rects": { "type": "integer", "minimum": 1 },
