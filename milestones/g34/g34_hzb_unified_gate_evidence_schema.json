        "verdict_equal": { "type": "boolean", "const": true, "description": "p1 判定序列 vs host test_rect 逐 rect 逐字节全等才许 true" },
        "false_positives": { "type": "integer", "const": 0, "description": "device 判 Occluded ⇒ exact_rect_occluded 独立复核必同判（零假阳性硬不变量）" },
        "occluded": { "type": "integer", "minimum": 0 },
        "pyramid_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "host_pyramid_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "verdict_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "host_verdict_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
