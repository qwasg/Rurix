            "min": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "host_parity": { "type": "null", "description": "蒙皮腿 = null 诚实登记（对拍面 = ① 逐顶点臂承载;G34-1 冻结容差标定面 = 非蒙皮腿在案,不混口径）" },
    "stats": { "type": "object" },
    "notes": { "type": "string" }
  }
}
