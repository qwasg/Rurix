        "verify_count": { "type": "integer", "minimum": 1 },
        "all_pass": { "type": "boolean", "const": true },
        "motion_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_motion_max_px", "threshold_px"],
          "properties": {
            "host_motion_max_px": { "type": "number", "minimum": 1.0, "description": "窗级聚合真动门：核验窗内 max host_motion ≥ 1.0px 才许通过" },
            "threshold_px": { "type": "number", "const": 1.0 }
          }
        },
        "mv_gap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class1_camera", "class2_rigid", "class3_skinned", "class1_delta_max_px", "class2_delta_max_px", "class3_delta_max_px", "rigid_active_frames", "note"],
          "properties": {
            "class1_camera": { "type": "string" },
            "class2_rigid": { "type": "string" },
            "class3_skinned": { "type": "string" },
            "class1_delta_max_px": { "type": "number", "maximum": 2.0 },
            "class2_delta_max_px": { "type": "number", "maximum": 2.0, "description": "类 2 刚性 MV 核验激活帧逐分量中位差窗级最大（A4 缺口接通面 measured）" },
            "class3_delta_max_px": { "type": "number", "maximum": 2.0 },
            "rigid_active_frames": { "type": "integer", "minimum": 1 },
            "note": { "type": "string" }
          }
        },
        "skin_gpu_ms": {
          "type": "object",
