{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G9.1 RTX 4070 Ti VRAM/AS measured baseline evidence",
  "description": "evidence/g9_vram_as_baseline_<UTC>.json。G9.1 governance-only baseline：ctypes 直连 vulkan-1.dll（ci/g9_vram_as_baseline_probe.py，零新 Rust/C++）实测 device-local VRAM heap 容量、130k 三角固定网格 BLAS 构建耗时/存储/scratch，并登记 G9 D3 阻塞性前置扩展在位性；只证明测量已建立，不证明任何 G9 实现达标。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "evidence_level", "milestone", "base_commit", "timestamp", "environment", "commands", "sampling", "results", "capability_snapshot", "notes"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g9_vram_as_baseline" },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "milestone": { "type": "string" },
    "base_commit": { "type": "string", "minLength": 7 },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "gpu_name", "gpu_driver_decoded", "gpu_driver_raw", "python_version", "probe", "nvidia_smi_mirror", "clock_lock_applicability"],
      "properties": {
        "os": { "type": "string" },
        "gpu_name": { "type": "string" },
        "gpu_driver_decoded": { "type": "string" },
        "gpu_driver_raw": { "type": "integer" },
        "python_version": { "type": "string" },
        "probe": { "type": "string" },
        "nvidia_smi_mirror": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw"],
          "properties": {
            "raw": { "type": "string" }
          }
        },
        "clock_lock_applicability": { "type": "string" }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "command", "exit_code", "note"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "note": { "type": "string" }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trials", "warmup", "timer", "method"],
      "properties": {
        "trials": { "type": "integer", "minimum": 3 },
        "warmup": { "type": "integer", "minimum": 0 },
        "timer": { "type": "string" },
        "method": { "type": "string" }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "unit", "trial_values_ms", "mesh", "as_limits", "memory_heaps"],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vram_device_local_heap_bytes", "blas_build_ms_130ktris", "blas_storage_bytes_130ktris", "blas_scratch_bytes_130ktris"],
          "properties": {
            "vram_device_local_heap_bytes": { "type": "integer", "minimum": 1 },
            "blas_build_ms_130ktris": { "type": "number", "exclusiveMinimum": 0 },
            "blas_storage_bytes_130ktris": { "type": "integer", "minimum": 1 },
            "blas_scratch_bytes_130ktris": { "type": "integer", "minimum": 1 }
          }
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vram_device_local_heap_bytes", "blas_build_ms_130ktris", "blas_storage_bytes_130ktris", "blas_scratch_bytes_130ktris"],
          "properties": {
            "vram_device_local_heap_bytes": { "type": "string", "const": "bytes" },
            "blas_build_ms_130ktris": { "type": "string", "const": "ms" },
            "blas_storage_bytes_130ktris": { "type": "string", "const": "bytes" },
            "blas_scratch_bytes_130ktris": { "type": "string", "const": "bytes" }
          }
        },
        "trial_values_ms": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grid_n", "vertices", "triangles", "build_flags"],
          "properties": {
            "grid_n": { "type": "integer", "minimum": 1 },
            "vertices": { "type": "integer", "minimum": 3 },
            "triangles": { "type": "integer", "minimum": 1 },
            "build_flags": { "type": "string" }
          }
        },
        "as_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxGeometryCount", "maxInstanceCount", "maxPrimitiveCount", "minAccelerationStructureScratchOffsetAlignment"],
          "properties": {
            "maxGeometryCount": { "type": "integer", "minimum": 1 },
            "maxInstanceCount": { "type": "integer", "minimum": 1 },
            "maxPrimitiveCount": { "type": "integer", "minimum": 1 },
            "minAccelerationStructureScratchOffsetAlignment": { "type": "integer", "minimum": 1 }
          }
        },
        "memory_heaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["size", "flags"],
            "properties": {
              "size": { "type": "integer", "minimum": 1 },
              "flags": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "capability_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions", "note"],
      "properties": {
        "extensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["VK_KHR_acceleration_structure", "VK_KHR_ray_query", "VK_EXT_mesh_shader", "VK_EXT_device_generated_commands", "VK_EXT_descriptor_buffer", "VK_NV_cluster_acceleration_structure", "VK_EXT_ray_tracing_invocation_reorder", "VK_NV_displacement_micromap", "VK_EXT_opacity_micromap"],
          "properties": {
            "VK_KHR_acceleration_structure": { "type": "boolean" },
            "VK_KHR_ray_query": { "type": "boolean" },
            "VK_EXT_mesh_shader": { "type": "boolean" },
            "VK_EXT_device_generated_commands": { "type": "boolean" },
            "VK_EXT_descriptor_buffer": { "type": "boolean" },
            "VK_NV_cluster_acceleration_structure": { "type": "boolean" },
            "VK_EXT_ray_tracing_invocation_reorder": { "type": "boolean" },
            "VK_NV_displacement_micromap": { "type": "boolean" },
            "VK_EXT_opacity_micromap": { "type": "boolean" }
          }
        },
        "note": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
