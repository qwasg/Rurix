        "spec_anchor": { "type": "string", "const": "RXS-0357" },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "boolean" },
          "required": [
            "double_run_bitexact",
            "sample_count_export",
            "golden_digest_match",
            "pbrt_band_within",
            "red_seed",
