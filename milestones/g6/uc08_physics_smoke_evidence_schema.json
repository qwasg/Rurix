{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UC-08 物理合流 demo 冒烟证据 schema(G6.3,步骤 91;G-G6-7;RFC-0017 §4.B)",
  "description": "ci/uc08_physics_smoke.py 写 evidence/uc08_physics_smoke_<ts>.json。host 段恒跑(无 GPU):cargo test -p uc08-physics exit 0(11 项)+ cargo run -p uc08-physics -- --frames 96 --size 128x72 --json exit 0,单行 JSON subject==uc08_physics 且 16 断言字段全部在位且全 true(physics_step_measured/transform_landed/mv_dynamic_present_early/mv_zero_after_sleep/streaming_insert_seen/streaming_remove_receipt_seen/release_after_receipt_only/tlas_rebuilds_ge1/blas_static_zero_refit/final_image_nontrivial/shading_has_contrast/temporal_converges/sleep_reached_when_long_run/pso_zero_warnings/graph_fences_nonempty/graph_alias_saves,缺位/非 true 即红,反 YAML-only)+ physics.total_step_ms 为正值 measured 数字且 stages 含 physics 阶段正耗时(物理步耗时 measured;P-09:数字入 checks 留证,不做阈值断言、不进硬门)+ streaming/mv/transform 数据字段存在性核验(streaming.insert_frame/remove_frame/receipt_bodies/releases、mv.early_max/post_sleep_max、physics.transform_landed_max_err)。device 段 gate real(device_section_rc 非 null):uc08-physics --features vulkan --device 真跑,device_pixels_nontrivial==true 且 device_motion_pixels_changed==true(物理驱动变换 → readback 像素/运动非平凡;对拍类非 true 永远硬红),缺 Vulkan SKIP=dev-env-degrade 退 0 不充绿,RURIX_REQUIRE_REAL=1 翻硬红。镜像步骤 88/89 体例。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "milestone",
    "step",
    "host_section_pass",
    "device_section_rc",
    "checks",
    "uc08_physics_smoke_ok",
    "run_url",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "uc08_physics_smoke" },
    "milestone": { "type": "string" },
    "step": { "type": "integer", "const": 91 },
    "host_section_pass": { "type": "boolean" },
    "device_section_rc": { "type": "integer" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uc08_tests_pass": { "type": ["boolean", "string"] },
        "uc08_test_count": { "type": ["integer", "boolean", "string"] },
        "host_run_exit_ok": { "type": ["boolean", "string"] },
        "host_json_exit_ok": { "type": ["boolean", "string"] },
        "asserts_all_true": { "type": ["boolean", "string"] },
        "physics_step_measured": { "type": ["boolean", "string"] },
        "transform_landed": { "type": ["boolean", "string"] },
        "mv_dynamic_present_early": { "type": ["boolean", "string"] },
        "mv_zero_after_sleep": { "type": ["boolean", "string"] },
        "streaming_insert_seen": { "type": ["boolean", "string"] },
        "streaming_remove_receipt_seen": { "type": ["boolean", "string"] },
        "release_after_receipt_only": { "type": ["boolean", "string"] },
        "tlas_rebuilds_ge1": { "type": ["boolean", "string"] },
        "blas_static_zero_refit": { "type": ["boolean", "string"] },
        "final_image_nontrivial": { "type": ["boolean", "string"] },
        "shading_has_contrast": { "type": ["boolean", "string"] },
        "temporal_converges": { "type": ["boolean", "string"] },
        "sleep_reached_when_long_run": { "type": ["boolean", "string"] },
        "pso_zero_warnings": { "type": ["boolean", "string"] },
        "graph_fences_nonempty": { "type": ["boolean", "string"] },
        "graph_alias_saves": { "type": ["boolean", "string"] },
        "physics_step_ms": { "type": ["number", "boolean", "string"] },
        "physics_stage_present": { "type": ["boolean", "string"] },
        "fields_streaming_present": { "type": ["boolean", "string"] },
        "fields_mv_present": { "type": ["boolean", "string"] },
        "fields_transform_present": { "type": ["boolean", "string"] },
        "device_run_pass": { "type": ["boolean", "string"] },
        "device_name": { "type": ["string", "boolean"] },
        "device_pixels_a": { "type": ["integer", "boolean", "string"] },
        "device_pixels_b": { "type": ["integer", "boolean", "string"] },
        "device_changed_pixels": { "type": ["integer", "boolean", "string"] },
        "device_pixels_nontrivial": { "type": ["boolean", "string"] },
        "device_motion_pixels_changed": { "type": ["boolean", "string"] }
      }
    },
    "uc08_physics_smoke_ok": { "type": ["boolean", "string"] },
    "toolchain_skip": { "type": ["string", "null"] },
    "dev_env_degrade": { "type": "boolean" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" }
  }
}
