      "items": {
        "type": "string"
      }
    },
    "w1w2_observed": {
      "type": "object",
      "description": "W1/W2 五 kernel 的实测 SPIR-V 版本 / sha256 / capability 集合(与 golden manifest 逐项比对后的观测值留痕)。",
      "additionalProperties": {
        "type": "object",
