                      "non_white": { "type": "boolean" },
                      "std_non_degenerate": { "type": "boolean" },
                      "histogram_occupied_ge_8": { "type": "boolean" },
                      "histogram_max_share_lt_0p98": { "type": "boolean" },
                      "flat_block_fraction_lt_0p95": { "type": "boolean" }
