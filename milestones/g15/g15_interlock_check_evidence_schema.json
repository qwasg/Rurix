{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G15.1 implementation interlock check evidence",
  "description": "evidence/g15_interlock_check_<UTC>.json。G15.1 治理门 g15.gov.implementation_interlock（ci/g15_interlock_check.py 写；普通检查门非聚合门，required_gates 空）：G15.2 实现互锁 validator 诚实报告面——事实门①G14 closed + §8.13 在位 + G15.0 不可变 ref f061487e 登记②候选决策表 35 行零空行 + deferred history 只追加（vs G15.0 base 四字段 0-byte）+ 验收映射 §1 五行 P0 + §2 零 go P1 无缺行③用户 G15.2 开工指令留痕（「一次性完成G15里程碑」字面）+ workflow 实测末号 == ledger CI_step on_tree_max 且 next_free == +1 且治理三门步骤 266~268 workflow/ledger 接线面在树（G15.1 期主会话提交批统一接线，接线前 = RED 诚实 BLOCKED）④G15.1 治理两门（acceptance_map + candidate_decisions）独立 PASS（MAP §6 条件 3 字面；G15 无许可前置门，事实门四项非五项）；一致性门 C1 双状态诚实 / C2 §8 记录一致 / C3 数字步骤零预占（治理三门 266~268 白名单豁免）/ C4 src-spec-conformance 0-byte（两态口径沿 G10.4b/G11/G12/G13/G14 先例）；VERDICT 字面入档（G15.1 期 = BLOCKED——正确结论不充绿，不以叙述替代机器事实）；--require-ready 供未来 G15.2 实现 PR 前置 required check。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g15_interlock_check" },
    "symbolic_gate_key": { "type": "string", "const": "g15.gov.implementation_interlock" },
    "matrix_row": { "type": "string", "const": "G15.1" },
    "wave": { "type": "string", "const": "G15.1" },
    "numeric_step": { "type": "integer", "description": "post-materialize actual-next-free 回填" },
    "source_ref": {
      "type": "string",
      "const": "G15_CONTRACT G-G15-2/§6/§7;G15_ACCEPTANCE_MAP §5/§6;registry/number_ledger.json;registry/deferred.json"
    },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": {
      "type": "string",
      "enum": ["not_applicable"]
    },
    "required_gates": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "extra_facts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string" }
        }
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_gates_pass",
        "all_extra_facts_pass",
        "all_subjects_pass",
        "aggregate_read_only"
      ],
      "properties": {
        "all_required_gates_pass": { "type": "boolean" },
        "all_extra_facts_pass": { "type": "boolean" },
        "all_subjects_pass": { "type": "boolean" },
        "aggregate_read_only": { "type": "boolean", "const": true }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
