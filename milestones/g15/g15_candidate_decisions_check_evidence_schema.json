{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G15.1 candidate decisions check evidence",
  "description": "evidence/g15_candidate_decisions_check_<UTC>.json。G15.1 治理门 g15.wave.1.candidate_decisions（ci/g15_candidate_decisions_check.py 写；普通检查门非聚合门，required_gates 空）：核验 milestones/g15/G15_CANDIDATE_DECISIONS.md v1.0——35 行冻结候选闭集全等（§1 G14 defer-to-G15+ 29 行承接〔G14_P2_DECISIONS §5 承接锚法定输入逐行转引处置〕+ §3 G15 新增候选 6 行 G15-N1~N6）、裁决枚举合法（go/no-go/defer-to-G16+/strategic_override——G15 即本期，defer-to-G15+ 不再合法）、零空行（全列非空）、承接锚纪律（§1 行 G14 P2 表承接锚字面 0-byte 转引含「→」分节与 G15+ 承接源字面；§3 行含「重判条件 = …；兜底 = …」字面）、defer 行必含 G16+ 重评窗、go 行验收映射锚义务（登记留痕位置含 G15_ACCEPTANCE_MAP）、no-go 行 RD/契约锚义务、§2 RD 八行集闭集 + 条目级 status==open；横向机核①与 G15_ACCEPTANCE_MAP 5 key（M-a~M-e）互斥（候选行 ID 不得命中已 go 门裸 token）②registry/deferred.json 对账（RD-034/039/040/041/042/043/044/045 条目级 status 全 open，零新 RD max=RD-045）。§2 RD 映射 8 行维持 open 不重复计入 35 行候选闭集三值枚举。只读文档与 registry，不代绿实现门；no-go/defer 如实保持 open 不写进全绿叙述。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g15_candidate_decisions_check" },
    "symbolic_gate_key": { "type": "string", "const": "g15.wave.1.candidate_decisions" },
    "matrix_row": { "type": "string", "const": "G15.1" },
    "wave": { "type": "string", "const": "G15.1" },
    "numeric_step": { "type": "integer", "description": "post-materialize actual-next-free 回填" },
    "source_ref": {
      "type": "string",
      "const": "G15_CONTRACT G-G15-1/§6/§7;G15_CANDIDATE_DECISIONS.md v1.0;G15_ACCEPTANCE_MAP §1/§2;G14_P2_DECISIONS.md v1.0 §5（29 行承接锚法定输入）;registry/deferred.json（RD 八条目级 status open 机核）"
    },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": {
      "type": "string",
      "enum": ["not_applicable"]
    },
    "required_gates": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "extra_facts": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string" }
        }
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_gates_pass",
        "all_extra_facts_pass",
        "all_subjects_pass",
        "aggregate_read_only"
      ],
      "properties": {
        "all_required_gates_pass": { "type": "boolean" },
        "all_extra_facts_pass": { "type": "boolean" },
        "all_subjects_pass": { "type": "boolean" },
        "aggregate_read_only": { "type": "boolean", "const": true }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
