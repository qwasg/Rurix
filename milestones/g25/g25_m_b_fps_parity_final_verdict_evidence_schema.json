{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "g25_m_b_fps_parity_final_verdict evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "subject": {
      "type": "string",
      "const": "g25_m_b_fps_parity_final_verdict"
    },
    "symbolic_gate_key": {
      "type": "string",
      "const": "g25.p0.m_b.fps_parity_final_verdict"
    },
    "matrix_row": {
      "type": "string",
      "const": "G25.2"
    },
    "wave": {
      "type": "string",
      "const": "G25.2"
    },
    "numeric_step": {
      "type": "integer"
    },
    "source_ref": {
      "type": "string"
    },
    "host_section_pass": {
      "type": "boolean"
    },
    "device_section_state": {
      "type": "string",
      "enum": [
        "not_applicable"
      ]
    },
    "required_gates": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object"
      }
    },
    "extra_facts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object"
      }
    },
    "checks": {
      "type": "object"
    },
    "evidence_level": {
      "type": "string",
      "const": "measured_local"
    },
    "run_url": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  }
}
