{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blackhole 实时冒烟证据 schema(G4.6 PR-H,步骤 81;G-G4-7;RFC-0015 §1 carve-out;RXS-0197/0198)",
  "description": "ci/blackhole_realtime_smoke.py 写 evidence/blackhole_realtime_smoke_<ts>.json。本步骤为 RFC-0015 §1 carve-out(running on physical hardware carve-out),真实 device 黑洞路径未激活动作(host_section_pass=false + device_section_rc=1 + blackhole_realtime_ok=false 为诚实失败而非降级);当 carve-out 解除后,本 schema 描述真实 blackhole 路径冒烟(host_checks + device_run + blackhole_realtime_ok)。镜像 uc05_graphics_rhi_smoke_evidence_schema 体例。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "milestone",
    "step",
    "host_section_pass",
    "device_section_rc",
    "checks",
    "blackhole_realtime_ok",
    "run_url",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "blackhole_realtime_smoke" },
    "milestone": { "type": "string" },
    "step": { "type": "integer", "const": 81 },
    "host_section_pass": { "type": "boolean" },
    "device_section_rc": { "type": "integer" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_checks": { "type": ["boolean", "string"] },
        "device_run": { "type": ["boolean", "string"] },
        "realtime_ok": { "type": ["boolean", "string"] },
        "fps_measured": { "type": ["boolean", "string"] },
        "fps_value": { "type": ["number", "string"] },
        "frames_n": { "type": ["integer", "string"] },
        "elapsed_s": { "type": ["number", "string"] },
        "frame_compare": { "type": ["boolean", "string"] }
      }
    },
    "blackhole_realtime_ok": { "type": ["boolean", "string"] },
    "toolchain_skip": { "type": ["string", "null"] },
    "dev_env_degrade": { "type": "boolean" },
    "env_profile": {
      "type": ["object", "string"],
      "description": "环境画像(驱动/GPU;carve-out 期可空)"
    },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" }
  }
}
