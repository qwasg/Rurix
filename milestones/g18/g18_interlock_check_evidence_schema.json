{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "g18.1 implementation interlock check evidence",
  "description": "evidence/g18_interlock_check_<UTC>.json。g18.1 治理门 g18.gov.implementation_interlock（ci/g18_interlock_check.py 写；普通检查门非聚合门，required_gates 空）：g18.2 实现互锁 validator 诚实报告面——事实门①G16 closed + §8.4 在位 + g18.0 不可变 ref 8fc1fdaa 登记②候选决策表 19 行零空行 + deferred history 只追加（vs g18.0 base 四字段 0-byte）+ 验收映射 §1 五行 P0 + §2 零 go P1 无缺行③用户 g18.2 开工指令留痕（「帮我一次性完成g18」字面）+ workflow 实测末号 == ledger CI_step on_tree_max 且 next_free == +1 且治理三门步骤 293~311 workflow/ledger 接线面在树（g18.1 期主会话提交批统一接线，接线前 = RED 诚实 BLOCKED）④g18.1 治理两门（acceptance_map + candidate_decisions）独立 PASS；一致性门 C1 双状态诚实 / C2 §8 记录一致 / C3 数字步骤零预占（治理三门 293~311 白名单豁免）/ C4 src-spec-conformance 0-byte（两态口径沿 G10.4b~G16 先例）；VERDICT 字面入档（BLOCKED/READY 均为正确结论不充绿，不以叙述替代机器事实）；--require-ready 供 g18.2 实现 PR 前置 required check。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g18_interlock_check" },
    "symbolic_gate_key": { "type": "string", "const": "g18.gov.implementation_interlock" },
    "matrix_row": { "type": "string", "const": "G18.1" },
    "wave": { "type": "string", "const": "G18.1" },
    "numeric_step": { "type": "integer", "description": "落盘前实测 CI_step.next_free=293 顺位领取（本门 311）" },
    "source_ref": {
      "type": "string",
      "const": "G18_CONTRACT G-G18-2/§6/§7;G18_ACCEPTANCE_MAP §5/§6;registry/number_ledger.json;registry/deferred.json"
    },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": {
      "type": "string",
      "enum": ["not_applicable"]
    },
    "required_gates": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "extra_facts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string" }
        }
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_gates_pass",
        "all_extra_facts_pass",
        "all_subjects_pass",
        "aggregate_read_only"
      ],
      "properties": {
        "all_required_gates_pass": { "type": "boolean" },
        "all_extra_facts_pass": { "type": "boolean" },
        "all_subjects_pass": { "type": "boolean" },
        "aggregate_read_only": { "type": "boolean", "const": true }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}

