{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G18 P2 decisions check evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "subject", "symbolic_gate_key", "matrix_row", "wave",
    "numeric_step", "source_ref", "host_section_pass", "device_section_state",
    "required_gates", "extra_facts", "subjects", "checks",
    "evidence_level", "run_url", "timestamp", "environment", "notes"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "subject": {"type": "string", "const": "g18_p2_decisions_check"},
    "symbolic_gate_key": {"type": "string", "const": "g18.wave.8a.decisions"},
    "matrix_row": {"type": "string", "const": "G18.8"},
    "wave": {"type": "string", "const": "G18.8"},
    "numeric_step": {"type": "integer"},
    "source_ref": {"type": "string"},
    "host_section_pass": {"type": "boolean"},
    "device_section_state": {"type": "string"},
    "required_gates": {"type": "array", "maxItems": 0},
    "extra_facts": {"type": "array", "minItems": 6},
    "subjects": {"type": "array", "maxItems": 0},
    "checks": {"type": "object"},
    "evidence_level": {"type": "string", "const": "measured_local"},
    "run_url": {"type": "string"},
    "timestamp": {"type": "string"},
    "environment": {"type": "object"},
    "notes": {"type": "string"}
  }
}
