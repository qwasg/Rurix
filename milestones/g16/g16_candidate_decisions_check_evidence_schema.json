{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G16.1 candidate decisions check evidence",
  "description": "evidence/g16_candidate_decisions_check_<UTC>.json。G16.1 治理门 g16.wave.1.candidate_decisions（ci/g16_candidate_decisions_check.py 写；普通检查门非聚合门，required_gates 空）：核验 milestones/g16/G16_CANDIDATE_DECISIONS.md——20 行冻结候选闭集全等（§1 G15 defer-to-G16+ 14 行 + G15-MC-F1/G15-MD-F1 承接 + §3 G16 新增候选 4 行 G16-N1~N4）、裁决枚举合法（go/closed-go/no-go/defer-to-G17+/strategic_override——G16 即本期，defer-to-G16+ 不再合法）、零空行（全列非空）、承接锚纪律（§1 行转引含「→」分节；§3 行含「重判条件 = …；兜底 = …」字面）、defer 行必含 G17+ 重评窗、go 行验收映射锚义务（登记留痕位置含 G16_ACCEPTANCE_MAP，或依据面含 G16_CONTRACT.md §4.2 M-）、no-go 行 RD/契约锚义务、§2 RD 八行集闭集 + 条目级 status==open；横向机核①与 G16_ACCEPTANCE_MAP 4 key（M-a~M-d）互斥（候选行 ID 不得命中已 go 门裸 token）②registry/deferred.json 对账（RD-034/039/040/041/042/043/044/045 条目级 status 全 open，零新 RD max=RD-045）。§2 RD 映射 8 行维持 open 不重复计入 20 行候选闭集三值枚举。只读文档与 registry，不代绿实现门；no-go/defer 如实保持 open 不写进全绿叙述。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "symbolic_gate_key",
    "matrix_row",
    "wave",
    "numeric_step",
    "source_ref",
    "host_section_pass",
    "device_section_state",
    "required_gates",
    "extra_facts",
    "subjects",
    "checks",
    "evidence_level",
    "run_url",
    "timestamp",
    "environment",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subject": { "type": "string", "const": "g16_candidate_decisions_check" },
    "symbolic_gate_key": { "type": "string", "const": "g16.wave.1.candidate_decisions" },
    "matrix_row": { "type": "string", "const": "G16.1" },
    "wave": { "type": "string", "const": "G16.1" },
    "numeric_step": { "type": "integer", "description": "post-materialize actual-next-free 回填" },
    "source_ref": {
      "type": "string",
      "const": "G16_CONTRACT G-G16-1/§6/§7;G16_CANDIDATE_DECISIONS.md v1.0;G16_ACCEPTANCE_MAP §1/§2;G15_CANDIDATE_DECISIONS.md v1.0（16 行承接锚法定输入）;registry/deferred.json（RD 八条目级 status open 机核）"
    },
    "host_section_pass": { "type": "boolean" },
    "device_section_state": {
      "type": "string",
      "enum": ["not_applicable"]
    },
    "required_gates": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "extra_facts": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string" }
        }
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "object" }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_gates_pass",
        "all_extra_facts_pass",
        "all_subjects_pass",
        "aggregate_read_only"
      ],
      "properties": {
        "all_required_gates_pass": { "type": "boolean" },
        "all_extra_facts_pass": { "type": "boolean" },
        "all_subjects_pass": { "type": "boolean" },
        "aggregate_read_only": { "type": "boolean", "const": true }
      }
    },
    "evidence_level": { "type": "string", "const": "measured_local" },
    "run_url": { "type": "string" },
    "timestamp": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version", "cargo_version", "rustc_version"],
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "cargo_version": { "type": "string" },
        "rustc_version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
