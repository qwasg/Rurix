{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G16.4 M-c 绝对通过线标定 measured entry evidence",
  "description": "evidence/g16_m_c_calibration_<metric>_<scene>_<UTC>.json。G16.4 M-c 标定腿逐条目 measured 件（双 seed 方差底场景内 p100，threshold = p100 × 2.0，禁手写 P-09；不改 g15_budget）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entry_id",
    "results",
    "protocol",
    "sample_manifest",
    "provenance",
    "timestamp"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "rurix.g16mcar.measured_entry.v1"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^g16\\.m_c\\.absolute_pass_line_"
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dual_seed_p100"],
      "properties": {
        "dual_seed_p100": { "type": "number" }
      }
    },
    "protocol": { "type": "string" },
    "sample_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "digest"],
      "properties": {
        "count": { "type": "integer" },
        "digest": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu", "backend", "base_commit"],
      "properties": {
        "gpu": { "type": "string" },
        "backend": { "type": "string" },
        "base_commit": { "type": "string" }
      }
    },
    "timestamp": { "type": "string" }
  }
}
