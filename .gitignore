# Rust
target/
# 蜂群隔离构建目录(G9.3 起 agent CARGO_TARGET_DIR=target-* 惯例)
target-*/

# rurixc 本地编译产物(M2.3 闭环输出)
build/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# 本地临时
*.tmp
*.log
~$*

# device codegen IR→PTX 中间产物(toolchain::ir_to_ptx 旁路 .dev.ll;M4.4)
*.dev.ll

# 自托管 runner(若误放仓库内)
actions-runner/

# 外部工程本地 checkout(工具件不入库;如 external/godot-master ≈2.1GB)
external/

# 实验/私人/工作记忆目录不入库（2026-07-28 cleanup_worktree spec）
# genesis/ = 独立 AI 游戏引擎子项目（MEMORY.md 明确"与 rurix 语言无关，勿混淆"）
# showcase/ = 实验目录
# .workbuddy/ = 工作记忆目录
# .writing/ = 写作目录
genesis/
showcase/
.workbuddy/
.writing/

# 宣传片与第三方工具工作目录不入库（2026-08-04 G7.7 前置清场）
# promo/ = 宣传片制作工作目录（媒体件与产物）
# apps/ruridrop/src/promo.rx = promo/tools/gen_promo_rx.py 机械生成的取帧入口（可再生，非 CI 面）
# .qoder/ / .better-harness/ = 第三方 IDE/harness 工具目录
# .tmp/ = 本地临时工作目录（含 agent 设计案落盘）
promo/
apps/ruridrop/src/promo.rx
.qoder/
.better-harness/
.tmp/

# JoltC ABI 布局复测探针的本地编译产物(2026-08-08 G8 收尾清理)
# src/rurix-physics-sys/tools/*.cpp 由 cl.exe 手动编译:源入库、二进制不入库
src/rurix-physics-sys/**/*.exe
src/rurix-physics-sys/**/*.obj
# G9.6 M125:5.6 评估臂布局探针同体例(tools/layout_dump56.cpp 源入库、二进制不入库)
src/rurix-physics-sys56/**/*.exe
src/rurix-physics-sys56/**/*.obj
.hilo/
