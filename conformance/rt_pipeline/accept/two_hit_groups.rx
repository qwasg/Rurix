//@ spec: RXS-0322, RXS-0323, RXS-0325, RXS-0326, RXS-0327
// G8.2 M50 accept:双 triangles hit group + 不同 #[shader_record] material id。
struct RayPayload {
    hit_id: u32,
    r: f32,
    g: f32,
    b: f32,
}

struct MatRec {
    material_id: u32,
    r: f32,
    g: f32,
    b: f32,
}

raygen fn rg(tlas: AccelStruct, #[payload] p: &mut RayPayload) {
    // SBT 寻址装配期静态;调用点固定五参签名(RXS-0245 修订行)。
    let _ = tlas;
    let _ = p;
}

miss fn ms(#[payload] p: &mut RayPayload) {
    let _ = p;
}

#[hit_group(mat_a)]
closesthit fn ch_a(#[payload] p: &mut RayPayload, #[shader_record] rec: &MatRec) {
    let _ = p;
    let _ = rec;
}

#[hit_group(mat_b)]
closesthit fn ch_b(#[payload] p: &mut RayPayload, #[shader_record] rec: &MatRec) {
    let _ = p;
    let _ = rec;
}

fn main() {}
