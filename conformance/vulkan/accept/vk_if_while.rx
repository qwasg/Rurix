//@ spec: RXS-0203
// G37 W1 回归语料(day_0828 A1「if 包 while」codegen 缺陷面):if 块内包含 while
// 循环。structured_merge 须给 if 选真 join(而非臂内块);经 spirv-val 严格校验接受。
kernel fn if_while(out: ViewMut<global, f32>, n: usize, t: ThreadCtx<1>) {
    let i = t.global_id();
    if i < n {
        let mut acc = 0.0;
        let mut j = 0usize;
        while j < n {
            acc = acc + 1.0;
            j = j + 1;
        }
        out[i] = acc;
    }
}
