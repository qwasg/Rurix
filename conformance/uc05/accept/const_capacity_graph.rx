//@ spec: RXS-0283
// G4.3 PR-E const 容量接线正例(RXS-0283,RFC-0015 §4.A;spec/rhi.md 章 A)。
//
// `rhi.graph::<CAP>()` turbofish const 实参字面量即时求值 → i64 容量,编译期前向扫描
// resource() 调用计数 vs CAP(越界 → RX2010,零新码)。本正例 CAP=8,声明 3 resource(≤ CAP)
// + 三 compute pass RAW 建序 + submit → **编译期 0 诊断**(合法用例锚定)。
//
// graph 句柄 `Graph<C>` affine,brand `C` 与 `Rhi` 同源;resource 仍在 `Rhi` 上调用
// (graph 调用为容量声明面,resource 创建走 rhi 单源)。声明序 = 提交序,用户不写 barrier。
// non-static construction strict 不触发(graph 在 main 顶层构造,非循环/条件上下文)。
//
// **编译期 0 诊断**:CAP=8 ≥ resource 计数 3。device 真跑归 ci/uc05_graphics_rhi_smoke.py
// 步骤 76;本文件为 .rx RHI 库面声明 + 装配核验通过的可编译本体。

kernel fn uc05_fill(t: ThreadCtx<1>, out: ViewMut<global, f32>, n: usize) {
    let i = t.global_id();
    if i < n {
        out[i] = ((i as u32) + 1u32) as f32;
    }
}

kernel fn uc05_scale(t: ThreadCtx<1>, src: View<global, f32>, dst: ViewMut<global, f32>, n: usize) {
    let i = t.global_id();
    if i < n {
        dst[i] = src[i] * 2.0;
    }
}

fn main() -> i32 {
    let ctx = Context::create();
    let n: u32 = 256;
    let nn: usize = 256;

    let rhi = Rhi::create(&ctx);
    // G4.3 PR-E(RXS-0283):const 容量声明 CAP=8,turbofish 字面量即时求值 → i64。
    let _g = rhi.graph::<8>();

    let a = rhi.resource(n);
    let b = rhi.resource(n);
    let c = rhi.resource(n);

    // produce a → transform 读 a 写 b → consume 读 b 写 c(RAW 建序,声明序 = 提交序)。
    rhi.pass(uc05_fill, GridDim(1), BlockDim(256), (a, nn)).writes(&a);
    rhi.pass(uc05_scale, GridDim(1), BlockDim(256), (a, b, nn))
        .reads(&a)
        .writes(&b);
    rhi.pass(uc05_scale, GridDim(1), BlockDim(256), (b, c, nn))
        .reads(&b)
        .writes(&c);

    // 装配核验 + hazard 推导 + 按推导序派发(RXS-0261)。
    rhi.submit();
    ctx.sync();
    0
}
