//@ spec: RXS-0270
//@ spec: RXS-0272
// G4.2 PR-B 图形 pass 声明正例(RXS-0270/0272,RFC-0015 §4.A;spec/rhi.md 章 A)。
//
// 声明式图形 render graph:raster pass = vertex + fragment 着色对(RXS-0270),经
// `rhi.raster_pass(vs, fs)` → `GfxPass<C>` 句柄;`writes_rt(&back)` 声明 color attachment
// 写(RXS-0272)。声明序 = 提交序;用户不写 barrier——装配期自动 hazard 推导(rhi.rs 桥接
// graph.rs derive_barriers,RXS-0272)。color_target = RGBA8 transient image(RXS-0271)。
//
// **编译期 0 诊断**:pass 声明面合法(brand 一致 / 阶段函数引用正确 / 访问声明形态合法)。
// 装配核验通过(单 pass 单写,无 I3/I5)。device 真跑像素判据归 ci/uc05_graphics_rhi_smoke.py
// 步骤 76(RURIX_REQUIRE_REAL=1);本文件为 .rx RHI 库面声明 + 装配核验通过的可编译本体。

struct VsOut {
    #[builtin(position)] pos: f32,
}

vertex fn vs() -> VsOut {
    VsOut { pos: 0.0 }
}

fragment fn fs(inp: VsOut) -> VsOut {
    inp
}

fn main() -> i32 {
    let ctx = Context::create();
    let rhi = Rhi::create(&ctx);

    let back = rhi.color_target(640, 480);

    // raster pass:vertex + fragment 着色对写 back(RXS-0270/0272)。
    rhi.raster_pass(vs, fs).writes_rt(&back);

    // 装配核验 + hazard 推导 + 按推导序派发(1-submit 消费式 typestate → Queue)。
    rhi.submit();
    ctx.sync();
    0
}
