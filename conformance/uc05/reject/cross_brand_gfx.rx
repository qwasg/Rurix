//@ spec: RXS-0270
//@ spec: RXS-0271
//@ expect-error: RX3006
// 跨 `Rhi` 实例图形资源误用(I7,RFC-0015 §4.A1/A2):`Rhi::create` 每调用点合成 per-instance
// 新鲜 opaque brand 类型;brand B 的图形资源(color_target)入 brand A 的 `GfxPass`
// (`reads` 声明实参)→ 编译期 context-brand 不匹配 **RX3006**(复用 launch brand
// 裁决 RXS-0074/0189,非 RX2001)。与 compute 面 reject/rhi_cross_brand.rx 同码同口径,零新码。
//
// (EI1.4:`rhi.raster_pass` 的资源实参走同一 brand 裁决体〔launch_check〕,故跨 `Rhi` 误用
// 在**声明面与 kernel 绑定面同码同口径** RX3006,零新码。区别于 G3.5 `Graph` 单 brand +
// 运行期 ctx-id 校验路——UC-05 取 per-instance 新鲜 brand 保 I7 ∈ 编译期集。)
struct VsOut {
    #[builtin(position)] pos: f32,
}

vertex fn vs() -> VsOut {
    VsOut { pos: 0.0 }
}

fragment fn fs(inp: VsOut) -> VsOut {
    inp
}

fn main() -> i32 {
    let ctx = Context::create();

    let rhi_a = Rhi::create(&ctx);
    let rhi_b = Rhi::create(&ctx);

    let back_a = rhi_a.color_target(640, 480); // brand A
    let back_b = rhi_b.color_target(640, 480); // brand B

    // brand B 的 pass 写 brand B 的资源(合法)。
    rhi_b.raster_pass(vs, fs).writes_rt(&back_b);

    // brand A 的 pass 写 brand A 资源,但读 brand B 的资源 → RX3006。
    rhi_a.raster_pass(vs, fs).writes_rt(&back_a).reads(&back_b);

    rhi_a.submit();
    rhi_b.submit();
    ctx.sync();
    0
}
