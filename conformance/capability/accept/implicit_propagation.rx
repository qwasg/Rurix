//@ capability: accept
//@ spec: RXS-0311, RXS-0312
//@ profile: profiles/high.json
// callee 隐式 requirement 上浮 entry(RXS-0311 调用图并集律):device fn
// `record_weight` 的 `#[shader_record]` 形参按隐式推导映射表(M50 行)产
// rt.sbt_user_data,经 DefId 级直调可达边并入 `kmain` 有效 requirement 集
// (kmain 自身零声明零隐式)。本头 `//@ profile:` 仅声明 GREEN 配套(accept
// 批跑矩阵);RED 对照由 smoke reject 腿以 profiles/low.json 硬编码驱动
// (缺 rt.sbt_user_data → RX3020,消息携带缺失 ID + 首个引入 callee =
// `record_weight`,非 entry 自身)。
struct Rec {
    weight: f32,
    tag: u32,
}

device fn record_weight(#[shader_record] rec: &Rec) -> f32 {
    rec.weight * 2.0
}

kernel fn kmain(t: ThreadCtx<1>, out: ViewMut<global, f32>) {
    let i = t.global_id();
    let r = Rec { weight: 1.5, tag: 7 };
    out[i] = record_weight(&r);
}

fn main() {}
